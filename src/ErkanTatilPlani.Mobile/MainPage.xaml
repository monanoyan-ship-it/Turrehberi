<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ErkanTatilPlani.Mobile.MainPage"
             Title="Ana Sayfa">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Hero Banner -->
            <Frame BackgroundColor="#1976D2" Padding="25" CornerRadius="15">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Erkan Tatil Plani"
                           FontSize="26" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center" />
                    <Label Text="Hayalinizdeki Turu Kesfet"
                           FontSize="15" TextColor="White" HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Quick Actions Grid -->
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <Frame Grid.Row="0" Grid.Column="0" Padding="15" CornerRadius="12" HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🌍" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="Turlar" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnToursClicked" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="0" Grid.Column="1" Padding="15" CornerRadius="12" HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🏢" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="Firmalar" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnCompaniesClicked" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="0" Padding="15" CornerRadius="12" HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🔥" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="Firsatlar" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnDealsClicked" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="1" Grid.Column="1" Padding="15" CornerRadius="12" HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="📰" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="Blog" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnBlogClicked" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="2" Grid.Column="0" Padding="15" CornerRadius="12" HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="❤️" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="Favorilerim" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFavoritesClicked" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="2" Grid.Column="1" Padding="15" CornerRadius="12" HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="💬" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="Mesajlar" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnMessagesClicked" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="3" Grid.Column="0" Padding="15" CornerRadius="12" HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="❓" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="SSS" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnFaqClicked" />
                    </Frame.GestureRecognizers>
                </Frame>

                <Frame Grid.Row="3" Grid.Column="1" Padding="15" CornerRadius="12" HasShadow="True">
                    <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                        <Label Text="🎧" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="Destek" FontAttributes="Bold" HorizontalOptions="Center" FontSize="14" />
                    </VerticalStackLayout>
                    <Frame.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnSupportClicked" />
                    </Frame.GestureRecognizers>
                </Frame>

            </Grid>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
