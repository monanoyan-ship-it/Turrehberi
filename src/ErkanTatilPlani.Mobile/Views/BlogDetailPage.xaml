<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ErkanTatilPlani.Mobile.ViewModels"
             x:Class="ErkanTatilPlani.Mobile.Views.BlogDetailPage"
             Title="{Binding Title}">

    <ContentPage.BindingContext>
        <viewmodels:BlogDetailViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="#1976D2" />

            <!-- Header -->
            <Frame BackgroundColor="#1976D2" Padding="20" CornerRadius="15"
                   IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="{Binding BlogTitle}" FontSize="22" FontAttributes="Bold" TextColor="White" />
                    <HorizontalStackLayout Spacing="10">
                        <Label Text="{Binding AuthorName}" TextColor="White" FontAttributes="Bold" />
                        <Label Text="|" TextColor="White" />
                        <Label Text="{Binding CreatedDate}" TextColor="White" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Frame>

            <!-- Content -->
            <Frame Padding="15" CornerRadius="10" HasShadow="True"
                   IsVisible="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}">
                <Label Text="{Binding Content}" />
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
