<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ErkanTatilPlani.Mobile.ViewModels"
             x:Class="ErkanTatilPlani.Mobile.Views.LoginPage"
             Title="Giris Yap"
             Shell.NavBarIsVisible="False">

    <ContentPage.BindingContext>
        <viewmodels:LoginViewModel />
    </ContentPage.BindingContext>

    <ScrollView>
        <VerticalStackLayout Padding="30" Spacing="20" VerticalOptions="Center">

            <!-- Logo -->
            <Frame BackgroundColor="#1976D2" Padding="25" CornerRadius="15" HorizontalOptions="Center">
                <VerticalStackLayout Spacing="5">
                    <Label Text="Erkan Tatil Plani"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="White"
                           HorizontalOptions="Center" />
                    <Label Text="Tur Kiralama Sistemi"
                           FontSize="14"
                           TextColor="White"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Frame>

            <!-- Error -->
            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringToBoolConverter}}"
                   HorizontalTextAlignment="Center" />

            <!-- Email -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Email" FontAttributes="Bold" />
                <Entry Text="{Binding Email}"
                       Placeholder="ornek@email.com"
                       Keyboard="Email" />
            </VerticalStackLayout>

            <!-- Password -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Sifre" FontAttributes="Bold" />
                <Entry Text="{Binding Password}"
                       Placeholder="Sifrenizi girin"
                       IsPassword="True" />
            </VerticalStackLayout>

            <!-- Login Button -->
            <Button Text="Giris Yap"
                    Command="{Binding LoginCommand}"
                    BackgroundColor="#1976D2"
                    TextColor="White"
                    FontAttributes="Bold"
                    CornerRadius="10"
                    HeightRequest="50"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InvertedBoolConverter}}" />

            <!-- Loading -->
            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="#1976D2" />

            <!-- Register Link -->
            <HorizontalStackLayout Spacing="5" HorizontalOptions="Center">
                <Label Text="Hesabiniz yok mu?" VerticalOptions="Center" />
                <Label Text="Kayit Ol"
                       TextColor="#1976D2"
                       FontAttributes="Bold"
                       VerticalOptions="Center">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding GoToRegisterCommand}" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
