<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ErkanTatilPlani.Mobile.ViewModels"
             x:Class="ErkanTatilPlani.Mobile.Views.ReservationsPage"
             Title="Rezervasyonlar">

    <ContentPage.BindingContext>
        <viewmodels:ReservationsViewModel />
    </ContentPage.BindingContext>

    <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
        <CollectionView ItemsSource="{Binding Reservations}" EmptyView="Henuz rezervasyonunuz yok">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:ReservationListItem">
                    <Frame Margin="10,5" Padding="15" CornerRadius="10" HasShadow="True">
                        <VerticalStackLayout Spacing="5">
                            <Label Text="{Binding TourName}" FontSize="18" FontAttributes="Bold" />
                            <HorizontalStackLayout Spacing="10">
                                <Label Text="{Binding Date}" />
                                <Label Text="|" TextColor="Gray" />
                                <Label Text="{Binding PeopleDisplay}" />
                            </HorizontalStackLayout>
                            <HorizontalStackLayout Spacing="15">
                                <Label Text="{Binding PriceDisplay}" TextColor="#388E3C" FontAttributes="Bold" />
                                <Label Text="{Binding Status}" TextColor="#1976D2" FontAttributes="Bold" />
                            </HorizontalStackLayout>
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </RefreshView>

</ContentPage>
