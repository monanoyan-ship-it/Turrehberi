<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:ErkanTatilPlani.Mobile.ViewModels"
             x:Class="ErkanTatilPlani.Mobile.Views.ToursPage"
             Title="Turlar">

    <ContentPage.BindingContext>
        <viewmodels:ToursViewModel />
    </ContentPage.BindingContext>

    <VerticalStackLayout>
        <!-- Search Bar -->
        <SearchBar Placeholder="Tur ara..."
                   Text="{Binding SearchText}"
                   SearchCommand="{Binding SearchCommand}"
                   Margin="10,10,10,0" />

        <RefreshView IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
            <CollectionView ItemsSource="{Binding Tours}" EmptyView="Tur bulunamadi">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:TourListItem">
                        <Frame Margin="10,5" Padding="15" CornerRadius="10" HasShadow="True">
                            <Frame.GestureRecognizers>
                                <TapGestureRecognizer
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ToursViewModel}}, Path=TourTappedCommand}"
                                    CommandParameter="{Binding .}" />
                            </Frame.GestureRecognizers>
                            <VerticalStackLayout Spacing="5">
                                <Label Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                                <HorizontalStackLayout Spacing="8">
                                    <Label Text="{Binding Destination}" TextColor="Gray" />
                                    <Label Text="|" TextColor="Gray" />
                                    <Label Text="{Binding CompanyName}" TextColor="Gray" />
                                </HorizontalStackLayout>
                                <HorizontalStackLayout Spacing="15">
                                    <Label Text="{Binding DurationDisplay}" />
                                    <Label Text="{Binding PriceDisplay}" TextColor="#388E3C" FontAttributes="Bold" />
                                    <Label Text="{Binding RatingDisplay}" TextColor="#FF8F00" />
                                </HorizontalStackLayout>
                                <Label Text="{Binding Description}" MaxLines="2" TextColor="Gray" FontSize="13" />
                            </VerticalStackLayout>
                        </Frame>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </VerticalStackLayout>

</ContentPage>
