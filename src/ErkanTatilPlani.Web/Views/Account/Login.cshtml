@{
    ViewData["Title"] = "Giris Yap";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-person-circle text-primary" style="font-size: 4rem;"></i>
                    <h3 class="mt-3" data-t="Login.Title">Giris Yap</h3>
                    <p class="text-muted" data-t="Login.Subtitle">Hesabiniza giris yapin</p>
                </div>

                <div id="loginApp">
                    <div class="mb-3">
                        <label class="form-label" data-t="Login.Email">E-posta</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input type="email" class="form-control" data-field="email" data-t-placeholder="Placeholder.Email" placeholder="ornek@email.com" data-bind="value: email, valueUpdate: 'input'" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label" data-t="Login.Password">Sifre</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-lock"></i></span>
                            <input type="password" class="form-control" data-field="password" placeholder="******" data-bind="value: password, valueUpdate: 'input'" />
                        </div>
                    </div>

                    <button class="btn btn-primary w-100 py-2 mb-3" data-bind="click: login, disable: isLoading">
                        <span data-bind="visible: isLoading" class="spinner-border spinner-border-sm me-2"></span>
                        <i class="bi bi-box-arrow-in-right me-1" data-bind="visible: !isLoading()"></i>
                        <span data-t="Login.Submit">Giris Yap</span>
                    </button>

                    <div class="text-center">
                        <p class="mb-2"><a href="/Account/ForgotPassword" class="text-decoration-none text-muted" data-t="Login.ForgotPassword">Sifremi Unuttum</a></p>
                        <p class="mb-0"><span data-t="Login.NoAccount">Hesabiniz yok mu?</span> <a href="/Account/Register" class="text-decoration-none" data-t="Menu.Register">Kayit Ol</a></p>
                    </div>
                </div>
            </div>
        </div>

        <div class="card mt-4 border-0 bg-light">
            <div class="card-body">
                <h6 class="text-muted mb-3"><i class="bi bi-info-circle me-1"></i> Test Hesaplari</h6>
                <div class="row small">
                    <div class="col-4">
                        <strong>Admin:</strong><br>
                        admin@erkantatilplani.com<br>
                        <code>123456</code>
                    </div>
                    <div class="col-4">
                        <strong>Firma Sahibi:</strong><br>
                        ahmet@egetur.com<br>
                        <code>123456</code>
                    </div>
                    <div class="col-4">
                        <strong>Kullanici:</strong><br>
                        zeynep@gmail.com<br>
                        <code>123456</code>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Account/Login.js" asp-append-version="true"></script>
}
