@{
    ViewData["Title"] = "Bildirimler";
}

<div id="notificationsApp">

<!-- Hero -->
<div class="bg-primary text-white rounded-3 p-4 mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h3><i class="bi bi-bell"></i> <span data-t="Notification.Title">Bildirimler</span></h3>
        </div>
        <button class="btn btn-outline-light btn-sm" data-bind="click: markAllRead, visible: unreadCount() > 0">
            <i class="bi bi-check-all"></i> <span data-t="Notification.MarkAllRead">Tumunu Okundu Isaretle</span>
        </button>
    </div>
    <div class="mt-2">
        <span class="badge bg-light text-dark" data-bind="visible: unreadCount() > 0">
            <span data-bind="text: unreadCount"></span> <span data-t="Notification.Unread">Okunmamis</span>
        </span>
    </div>
</div>

<!-- Loading -->
<div data-bind="visible: isLoading" class="text-center py-5">
    <div class="spinner-border text-primary"></div>
</div>

<!-- Bildirim Listesi -->
<div data-bind="visible: !isLoading() && notifications().length > 0">
    <div class="list-group" data-bind="foreach: notifications">
        <div class="list-group-item list-group-item-action" data-bind="css: { 'bg-light': !isRead }">
            <div class="d-flex align-items-start">
                <span class="badge me-3 mt-1" data-bind="css: notificationCss">
                    <i class="bi" data-bind="css: notificationIcon"></i>
                </span>
                <div class="flex-grow-1">
                    <div class="d-flex justify-content-between">
                        <h6 class="mb-1" data-bind="text: $parent.getTitle($data)"></h6>
                        <small class="text-muted" data-bind="text: $parent.formatDate(createdAt)"></small>
                    </div>
                    <p class="mb-1 text-muted" data-bind="text: $parent.getMessage($data)"></p>
                    <!-- ko if: relatedEntityType === 'Tour' && relatedEntityId -->
                    <a class="btn btn-outline-primary btn-sm mt-1" data-bind="attr: { href: '/Tours?id=' + relatedEntityId }">
                        <i class="bi bi-geo-alt"></i> Turu Gor
                    </a>
                    <!-- /ko -->
                    <!-- ko if: relatedEntityType === 'Reservation' && relatedEntityId -->
                    <a class="btn btn-outline-primary btn-sm mt-1" data-bind="attr: { href: '/Account/ReservationDetail/' + relatedEntityId }">
                        <i class="bi bi-calendar-check"></i> Rezervasyonu Gor
                    </a>
                    <!-- /ko -->
                </div>
                <!-- ko ifnot: isRead -->
                <button class="btn btn-sm btn-outline-secondary ms-2" data-bind="click: $parent.markRead" data-t-title="Common.Read" title="Okundu">
                    <i class="bi bi-check"></i>
                </button>
                <!-- /ko -->
            </div>
        </div>
    </div>

    <!-- Pagination -->
    <nav class="mt-4" data-bind="visible: totalPages() > 1">
        <ul class="pagination justify-content-center">
            <li class="page-item" data-bind="css: { disabled: page() <= 1 }">
                <a class="page-link" href="#" data-bind="click: function() { changePage(page() - 1) }"><i class="bi bi-chevron-left"></i></a>
            </li>
            <!-- ko foreach: pageNumbers -->
            <li class="page-item" data-bind="css: { active: $data === $parent.page() }">
                <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.changePage($data) }"></a>
            </li>
            <!-- /ko -->
            <li class="page-item" data-bind="css: { disabled: page() >= totalPages() }">
                <a class="page-link" href="#" data-bind="click: function() { changePage(page() + 1) }"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>
</div>

<!-- Bos Durum -->
<div data-bind="visible: !isLoading() && notifications().length === 0" class="text-center py-5">
    <i class="bi bi-bell-slash display-1 text-muted"></i>
    <h5 class="mt-3 text-muted" data-t="Notification.Empty">Bildiriminiz bulunmuyor</h5>
</div>

</div>

@section Scripts {
<script src="~/js/Account/Notifications.js"></script>
}
