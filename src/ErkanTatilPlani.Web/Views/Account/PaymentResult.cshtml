@{
    ViewData["Title"] = "Odeme Sonucu";
    var status = ViewBag.Status as string;
    var reservationId = ViewBag.ReservationId as int?;
    var error = ViewBag.Error as string;
    var isSuccess = status == "success";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            @if (isSuccess)
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <i class="bi bi-check-circle-fill text-success" style="font-size: 5rem;"></i>
                        </div>
                        <h2 class="text-success mb-3" data-t="Payment.Success.Title">Odeme Basarili!</h2>
                        <p class="text-muted mb-4" data-t="Payment.Success.Message">
                            Odemeniz basariyla tamamlandi. Rezervasyonunuz onaylandi.
                        </p>

                        <div class="alert alert-success">
                            <i class="bi bi-info-circle me-2"></i>
                            <span data-t="Payment.Success.EmailSent">Rezervasyon detaylari e-posta adresinize gonderildi.</span>
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            @if (reservationId.HasValue)
                            {
                                <a href="/Account/ReservationDetail/@reservationId" class="btn btn-success btn-lg">
                                    <i class="bi bi-eye me-2"></i>
                                    <span data-t="Payment.ViewReservation">Rezervasyonu Gor</span>
                                </a>
                            }
                            <a href="/Account/Reservations" class="btn btn-outline-primary">
                                <i class="bi bi-list me-2"></i>
                                <span data-t="Menu.MyReservations">Rezervasyonlarim</span>
                            </a>
                            <a href="/Turlar" class="btn btn-outline-secondary">
                                <i class="bi bi-search me-2"></i>
                                <span data-t="Payment.ExploreTours">Diger Turlari Kesfet</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center py-5">
                        <div class="mb-4">
                            <i class="bi bi-x-circle-fill text-danger" style="font-size: 5rem;"></i>
                        </div>
                        <h2 class="text-danger mb-3" data-t="Payment.Failed.Title">Odeme Basarisiz</h2>
                        <p class="text-muted mb-4" data-t="Payment.Failed.Message">
                            Odeme islemi sirasinda bir hata olustu. Lutfen tekrar deneyin.
                        </p>

                        @if (!string.IsNullOrEmpty(error))
                        {
                            <div class="alert alert-danger">
                                <i class="bi bi-exclamation-triangle me-2"></i>
                                @error
                            </div>
                        }

                        <div class="d-grid gap-2 mt-4">
                            @if (reservationId.HasValue)
                            {
                                <a href="/Account/ReservationDetail/@reservationId" class="btn btn-primary btn-lg">
                                    <i class="bi bi-credit-card me-2"></i>
                                    <span data-t="Payment.TryAgain">Tekrar Dene</span>
                                </a>
                            }
                            <a href="/Account/Reservations" class="btn btn-outline-primary">
                                <i class="bi bi-list me-2"></i>
                                <span data-t="Menu.MyReservations">Rezervasyonlarim</span>
                            </a>
                            <a href="/Iletisim" class="btn btn-outline-secondary">
                                <i class="bi bi-headset me-2"></i>
                                <span data-t="Payment.ContactSupport">Destek</span>
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
