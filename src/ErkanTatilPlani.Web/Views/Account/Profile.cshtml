@{
    ViewData["Title"] = "Profil";
}

<div class="container py-4" id="profileApp">
    <!-- Loading State -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
    </div>

    <!-- Not Logged In -->
    <div data-bind="visible: !isLoading() && !isLoggedIn()" class="text-center py-5">
        <i class="bi bi-person-x text-muted" style="font-size: 4rem;"></i>
        <h4 class="mt-3" data-t="Profile.LoginRequired">Giris yapmaniz gerekiyor</h4>
        <a href="/Account/Login" class="btn btn-primary mt-3">
            <i class="bi bi-box-arrow-in-right me-1"></i>
            <span data-t="Menu.Login">Giris Yap</span>
        </a>
    </div>

    <!-- Profile Content -->
    <div data-bind="visible: !isLoading() && isLoggedIn()">
        <div class="row">
            <!-- Left Column - Profile Info -->
            <div class="col-lg-4 mb-4">
                <div class="card shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <div class="position-relative d-inline-block mb-3">
                            <img data-bind="attr: { src: avatarUrl }"
                                 class="rounded-circle border border-3 border-primary"
                                 style="width: 120px; height: 120px; object-fit: cover; cursor: pointer;"
                                 alt="Profil Resmi"
                                 onclick="document.getElementById('avatarInput').click()" />
                            <div class="position-absolute bottom-0 end-0">
                                <button type="button" class="btn btn-primary btn-sm rounded-circle p-1"
                                        style="width: 32px; height: 32px;"
                                        onclick="document.getElementById('avatarInput').click()"
                                        data-bind="disable: isUploadingAvatar">
                                    <i class="bi bi-camera-fill" data-bind="visible: !isUploadingAvatar()"></i>
                                    <span class="spinner-border spinner-border-sm" data-bind="visible: isUploadingAvatar"></span>
                                </button>
                            </div>
                            <input type="file" id="avatarInput" class="d-none" accept="image/*"
                                   data-bind="event: { change: onAvatarSelected }" />
                        </div>
                        <!-- Avatar Actions -->
                        <div class="mb-2" data-bind="visible: hasCustomAvatar">
                            <button type="button" class="btn btn-outline-danger btn-sm"
                                    data-bind="click: deleteAvatar, disable: isDeletingAvatar">
                                <span class="spinner-border spinner-border-sm me-1" data-bind="visible: isDeletingAvatar"></span>
                                <i class="bi bi-trash me-1" data-bind="visible: !isDeletingAvatar()"></i>
                                <span data-t="Avatar.Delete">Resmi Sil</span>
                            </button>
                        </div>
                        <h4 data-bind="text: fullName"></h4>
                        <p class="text-muted mb-1" data-bind="text: email"></p>

                        <!-- Email Verification Status -->
                        <div class="mb-2">
                            <span data-bind="visible: emailVerified" class="badge bg-success">
                                <i class="bi bi-check-circle me-1"></i>
                                <span data-t="VerifyEmail.Verified">Email Dogrulandi</span>
                            </span>
                            <span data-bind="visible: !emailVerified()" class="badge bg-warning text-dark">
                                <i class="bi bi-exclamation-triangle me-1"></i>
                                <span data-t="VerifyEmail.NotVerified">Email Dogrulanmadi</span>
                            </span>
                        </div>

                        <span class="badge bg-primary" data-bind="text: userTypeName"></span>

                        <!-- Loyalty Badge -->
                        <div class="mt-3 pt-3 border-top">
                            <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
                                <i data-bind="attr: { class: 'bi ' + (loyaltyTierIcon() || 'bi-compass') }" style="font-size: 1.5rem;"></i>
                                <span class="badge" data-bind="text: loyaltyTierName(), css: loyaltyTierCss()"></span>
                            </div>
                            <small class="text-muted d-block" data-t="Credit.Balance">Kredi Bakiyesi</small>
                            <span class="fw-semibold text-success" data-bind="text: loyaltyCreditBalance().toFixed(2) + ' ₺'"></span>
                            <div class="mt-2">
                                <a href="/Account/TravelerClub" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-people me-1"></i>
                                    <span data-t="Loyalty.Dashboard">Gezgin Kulubu</span>
                                </a>
                            </div>
                        </div>

                        <!-- Social Stats -->
                        <div class="mt-3 pt-3 border-top">
                            <div class="row text-center">
                                <div class="col-4">
                                    <h6 data-bind="text: followerCount()"></h6>
                                    <small class="text-muted" data-t="TravelerProfile.Followers">Takipci</small>
                                </div>
                                <div class="col-4">
                                    <h6 data-bind="text: followingCount()"></h6>
                                    <small class="text-muted" data-t="TravelerProfile.Following">Takip</small>
                                </div>
                                <div class="col-4">
                                    <h6 data-bind="text: tripStoryCount()"></h6>
                                    <small class="text-muted" data-t="TripStory.Stories">Hikaye</small>
                                </div>
                            </div>
                        </div>

                        <!-- Company Info -->
                        <div data-bind="visible: companyName" class="mt-3 pt-3 border-top">
                            <small class="text-muted d-block" data-t="Tour.Company">Firma</small>
                            <span class="fw-semibold" data-bind="text: companyName"></span>
                        </div>
                    </div>
                </div>

                <!-- Email Verification Card -->
                <div class="card shadow-sm border-0 mt-4" data-bind="visible: !emailVerified()">
                    <div class="card-header bg-white border-0 py-3">
                        <h6 class="mb-0">
                            <i class="bi bi-envelope-check me-2 text-warning"></i>
                            <span data-t="VerifyEmail.Title">Email Dogrulama</span>
                        </h6>
                    </div>
                    <div class="card-body">
                        <p class="text-muted small mb-3" data-t="VerifyEmail.Description">Email adresinizi dogrulayarak hesabinizi guvenli hale getirin.</p>
                        <button class="btn btn-warning btn-sm w-100" data-bind="click: sendVerificationEmail, disable: isSendingVerification">
                            <span data-bind="visible: isSendingVerification" class="spinner-border spinner-border-sm me-2"></span>
                            <i class="bi bi-envelope-arrow-up me-1" data-bind="visible: !isSendingVerification()"></i>
                            <span data-t="VerifyEmail.SendLink">Dogrulama Linki Gonder</span>
                        </button>
                        <div class="alert alert-success mt-2 small" data-bind="visible: verificationSent" data-t="VerifyEmail.LinkSent">Dogrulama linki email adresinize gonderildi.</div>
                    </div>
                </div>

                <!-- Language Preference Card -->
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h6 class="mb-0">
                            <i class="bi bi-globe me-2 text-primary"></i>
                            <span data-t="Language.Select">Dil Tercihi</span>
                        </h6>
                    </div>
                    <div class="card-body">
                        <select class="form-select" data-bind="value: preferredLanguage, event: { change: changeLanguage }">
                            <option value="tr">Turkce</option>
                            <option value="en">English</option>
                            <option value="de">Deutsch</option>
                            <option value="ru">Russkiy</option>
                            <option value="es">Espanol</option>
                            <option value="fr">Francais</option>
                            <option value="ar">Arabiyya</option>
                            <option value="fa">Farsi</option>
                            <option value="pt">Portugues</option>
                        </select>
                    </div>
                </div>
                <!-- Profile Visibility Card -->
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h6 class="mb-0">
                            <i class="bi bi-eye me-2 text-primary"></i>
                            <span data-t="TravelerProfile.ProfileVisibility">Profil Gorunurlugu</span>
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="isProfilePublic" data-bind="checked: isProfilePublic, event: { change: toggleProfileVisibility }" />
                            <label class="form-check-label" for="isProfilePublic">
                                <i class="bi bi-globe me-1"></i>
                                <span data-t="TravelerProfile.PublicProfile">Herkese Acik Profil</span>
                            </label>
                        </div>
                        <small class="text-muted" data-t="TravelerProfile.VisibilityHint">Gizli profiller sadece sizin tarafinizdan gorulebilir</small>
                    </div>
                </div>

                <!-- Notification Preferences Card -->
                <div class="card shadow-sm border-0 mt-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h6 class="mb-0">
                            <i class="bi bi-bell me-2 text-primary"></i>
                            <span data-t="NotificationPref.Title">Bildirim Tercihleri</span>
                        </h6>
                    </div>
                    <div class="card-body">
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="prefEmail" data-bind="checked: prefEmail" />
                            <label class="form-check-label" for="prefEmail">
                                <i class="bi bi-envelope me-1"></i><span data-t="NotificationPref.Email">E-posta Bildirimleri</span>
                            </label>
                        </div>
                        <div class="form-check form-switch mb-2">
                            <input class="form-check-input" type="checkbox" id="prefWhatsapp" data-bind="checked: prefWhatsapp" />
                            <label class="form-check-label" for="prefWhatsapp">
                                <i class="bi bi-whatsapp me-1"></i><span data-t="NotificationPref.WhatsApp">WhatsApp Bildirimleri</span>
                            </label>
                        </div>
                        <div class="form-check form-switch mb-3">
                            <input class="form-check-input" type="checkbox" id="prefSms" data-bind="checked: prefSms" />
                            <label class="form-check-label" for="prefSms">
                                <i class="bi bi-phone me-1"></i><span data-t="NotificationPref.SMS">SMS Bildirimleri</span>
                            </label>
                        </div>
                        <button class="btn btn-primary btn-sm" data-bind="click: saveNotificationPrefs, disable: isSavingPrefs">
                            <span data-bind="visible: isSavingPrefs" class="spinner-border spinner-border-sm me-1"></span>
                            <i class="bi bi-check-lg me-1" data-bind="visible: !isSavingPrefs()"></i>
                            <span data-t="Common.Save">Kaydet</span>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Right Column - Forms -->
            <div class="col-lg-8">
                <!-- Personal Info Form -->
                <div class="card shadow-sm border-0 mb-4">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="bi bi-person me-2 text-primary"></i>
                            <span data-t="Profile.PersonalInfo">Kisisel Bilgiler</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" data-t="Register.FirstName">Ad</label>
                                <input type="text" class="form-control" data-bind="value: firstName" />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" data-t="Register.LastName">Soyad</label>
                                <input type="text" class="form-control" data-bind="value: lastName" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" data-t="Register.Email">E-posta</label>
                            <input type="email" class="form-control bg-light" data-bind="value: email" readonly />
                            <small class="text-muted" data-t="Profile.EmailReadonly">E-posta adresi degistirilemez</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" data-t="Register.Phone">Telefon</label>
                            <input type="tel" class="form-control" data-bind="value: phone" placeholder="05XX XXX XX XX" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" data-t="Profile.Address">Adres</label>
                            <textarea class="form-control" rows="2" data-bind="value: address" data-t-placeholder="Profile.AddressPlaceholder" placeholder="Adresiniz"></textarea>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" data-t="Profile.BirthDate">Dogum Tarihi</label>
                            <input type="date" class="form-control" data-bind="value: birthDateFormatted" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label" data-t="TravelerProfile.Bio">Biyografi</label>
                            <textarea class="form-control" rows="3" data-bind="value: bio" maxlength="500"
                                      data-t-placeholder="TravelerProfile.BioPlaceholder" placeholder="Kendinizi kısaca tanıtın..."></textarea>
                            <small class="text-muted">
                                <span data-bind="text: (bio() || '').length"></span>/500
                            </small>
                        </div>

                        <button class="btn btn-primary" data-bind="click: saveProfile, disable: isSavingProfile">
                            <span data-bind="visible: isSavingProfile" class="spinner-border spinner-border-sm me-2"></span>
                            <i class="bi bi-check-lg me-1" data-bind="visible: !isSavingProfile()"></i>
                            <span data-t="Profile.SaveChanges">Degisiklikleri Kaydet</span>
                        </button>
                    </div>
                </div>

                <!-- Change Password Form -->
                <div class="card shadow-sm border-0">
                    <div class="card-header bg-white border-0 py-3">
                        <h5 class="mb-0">
                            <i class="bi bi-shield-lock me-2 text-primary"></i>
                            <span data-t="Profile.ChangePassword">Sifre Degistir</span>
                        </h5>
                    </div>
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label" data-t="Profile.CurrentPassword">Mevcut Sifre</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control" data-bind="value: currentPassword" />
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label" data-t="Profile.NewPassword">Yeni Sifre</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-key"></i></span>
                                    <input type="password" class="form-control" data-bind="value: newPassword" />
                                </div>
                                <small class="text-muted" data-t="Register.PasswordHint">En az 6 karakter</small>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label" data-t="Profile.ConfirmPassword">Sifre Tekrar</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                    <input type="password" class="form-control" data-bind="value: confirmPassword" />
                                </div>
                            </div>
                        </div>

                        <button class="btn btn-warning" data-bind="click: changePassword, disable: isChangingPassword">
                            <span data-bind="visible: isChangingPassword" class="spinner-border spinner-border-sm me-2"></span>
                            <i class="bi bi-shield-check me-1" data-bind="visible: !isChangingPassword()"></i>
                            <span data-t="Profile.ChangePassword">Sifre Degistir</span>
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Account/Profile.js" asp-append-version="true"></script>
}
