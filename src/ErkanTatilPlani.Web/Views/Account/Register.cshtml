@{
    ViewData["Title"] = "Kayit Ol";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-6">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-person-plus text-primary" style="font-size: 4rem;"></i>
                    <h3 class="mt-3">Kayit Ol</h3>
                    <p class="text-muted">Yeni hesap olusturun</p>
                </div>

                <div id="registerApp">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Adiniz" data-bind="value: firstName" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Soyad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" placeholder="Soyadiniz" data-bind="value: lastName" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">E-posta <span class="text-danger">*</span></label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                            <input type="email" class="form-control" placeholder="ornek@email.com" data-bind="value: email" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Telefon</label>
                        <div class="input-group">
                            <span class="input-group-text"><i class="bi bi-phone"></i></span>
                            <input type="tel" class="form-control" placeholder="05XX XXX XX XX" data-bind="value: phone" />
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Sifre <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock"></i></span>
                                <input type="password" class="form-control" placeholder="En az 6 karakter" data-bind="value: password" />
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Sifre Tekrar <span class="text-danger">*</span></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-lock-fill"></i></span>
                                <input type="password" class="form-control" placeholder="Sifrenizi tekrarlayin" data-bind="value: passwordConfirm" />
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-danger" data-bind="visible: errorMessage, text: errorMessage"></div>

                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="termsCheck" data-bind="checked: acceptTerms">
                        <label class="form-check-label small" for="termsCheck">
                            <a href="#" class="text-decoration-none">Kullanim Kosullarini</a> ve
                            <a href="#" class="text-decoration-none">Gizlilik Politikasini</a> kabul ediyorum.
                        </label>
                    </div>

                    <button class="btn btn-primary w-100 py-2 mb-3" data-bind="click: register, disable: isLoading">
                        <span data-bind="visible: isLoading" class="spinner-border spinner-border-sm me-2"></span>
                        <i class="bi bi-person-plus me-1" data-bind="visible: !isLoading()"></i>
                        Kayit Ol
                    </button>

                    <div class="text-center">
                        <p class="mb-0">Zaten hesabiniz var mi? <a href="/Account/Login" class="text-decoration-none">Giris Yap</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function RegisterViewModel() {
    var self = this;
    self.firstName = ko.observable('');
    self.lastName = ko.observable('');
    self.email = ko.observable('');
    self.phone = ko.observable('');
    self.password = ko.observable('');
    self.passwordConfirm = ko.observable('');
    self.acceptTerms = ko.observable(false);
    self.errorMessage = ko.observable('');
    self.isLoading = ko.observable(false);

    self.register = function() {
        self.errorMessage('');

        // Validation
        if (!self.firstName() || !self.lastName()) {
            self.errorMessage('Ad ve soyad zorunludur');
            return;
        }
        if (!self.email()) {
            self.errorMessage('Email zorunludur');
            return;
        }
        if (!self.password() || self.password().length < 6) {
            self.errorMessage('Sifre en az 6 karakter olmalidir');
            return;
        }
        if (self.password() !== self.passwordConfirm()) {
            self.errorMessage('Sifreler eslesmyor');
            return;
        }
        if (!self.acceptTerms()) {
            self.errorMessage('Kullanim kosullarini kabul etmelisiniz');
            return;
        }

        self.isLoading(true);

        $.ajax({
            url: apiBaseUrl + '/api/auth/register',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({
                firstName: self.firstName(),
                lastName: self.lastName(),
                email: self.email(),
                phone: self.phone(),
                password: self.password()
            }),
            success: function(response) {
                localStorage.setItem('token', response.token);
                localStorage.setItem('user', JSON.stringify(response.user));
                toastr.success('Kayit basarili! Hosgeldiniz ' + response.user.firstName);
                window.location.href = '/';
            },
            error: function(xhr) {
                var msg = xhr.responseJSON?.error || 'Kayit basarisiz';
                self.errorMessage(msg);
                self.isLoading(false);
            }
        });
    };
}

ko.applyBindings(new RegisterViewModel(), document.getElementById('registerApp'));
</script>
}
