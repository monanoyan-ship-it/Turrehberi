@{
    ViewData["Title"] = "Rezervasyonlarim";
}

<div id="reservationsApp">
    <!-- Hero Section -->
    <div class="bg-primary text-white py-4 mb-4 rounded-3">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-6 mb-2">
                        <i class="bi bi-calendar-check me-2"></i>
                        <span data-t="MyReservations.Title">Rezervasyonlarim</span>
                    </h1>
                    <p class="mb-0 opacity-75" data-t="MyReservations.Subtitle">Tum rezervasyonlarinizi buradan takip edebilirsiniz</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="/Tours" class="btn btn-light">
                        <i class="bi bi-plus-circle me-1"></i>
                        <span data-t="MyReservations.NewReservation">Yeni Rezervasyon</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
    </div>

    <!-- Reservation List -->
    <div data-bind="visible: !isLoading()">
        <!-- Stats -->
        <div class="row g-3 mb-4" data-bind="visible: reservations().length > 0">
            <div class="col-6 col-md-3">
                <div class="card bg-light border-0">
                    <div class="card-body text-center py-3">
                        <div class="fs-4 fw-bold text-primary" data-bind="text: reservations().length"></div>
                        <small class="text-muted" data-t="MyReservations.Total">Toplam</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card bg-warning bg-opacity-10 border-0">
                    <div class="card-body text-center py-3">
                        <div class="fs-4 fw-bold text-warning" data-bind="text: reservations().filter(r => r.statusId === 0).length"></div>
                        <small class="text-muted" data-t="Status.Pending">Bekliyor</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card bg-success bg-opacity-10 border-0">
                    <div class="card-body text-center py-3">
                        <div class="fs-4 fw-bold text-success" data-bind="text: reservations().filter(r => r.statusId === 1).length"></div>
                        <small class="text-muted" data-t="Status.Confirmed">Onaylandi</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card bg-info bg-opacity-10 border-0">
                    <div class="card-body text-center py-3">
                        <div class="fs-4 fw-bold text-info" data-bind="text: reservations().filter(r => r.statusId === 3).length"></div>
                        <small class="text-muted" data-t="Status.Completed">Tamamlandi</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Reservation Cards -->
        <div class="row g-4" data-bind="foreach: reservations">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100 shadow-sm border-0">
                    <!-- Tour Image -->
                    <div class="position-relative">
                        <img data-bind="attr: { src: tourImageUrl || 'https://picsum.photos/seed/' + tourId + '/400/200' }"
                             class="card-img-top" style="height: 150px; object-fit: cover;" alt="Tour">
                        <!-- Status Badge -->
                        <span class="position-absolute top-0 end-0 m-2 badge"
                              data-bind="css: {
                                  'bg-warning': statusId === 0,
                                  'bg-success': statusId === 1,
                                  'bg-danger': statusId === 2,
                                  'bg-info': statusId === 3
                              }, text: $parent.getStatusText(status)">
                        </span>
                    </div>

                    <div class="card-body">
                        <h5 class="card-title mb-1" data-bind="text: tourName"></h5>
                        <p class="text-muted small mb-2">
                            <i class="bi bi-geo-alt me-1"></i><span data-bind="text: tourDestination"></span>
                        </p>

                        <div class="d-flex justify-content-between mb-2">
                            <div>
                                <small class="text-muted" data-t="Reservation.StartDate">Baslangic:</small>
                                <div class="fw-semibold" data-bind="text: new Date(startDate).toLocaleDateString('tr-TR')"></div>
                            </div>
                            <div class="text-end">
                                <small class="text-muted" data-t="Reservation.People">Kisi:</small>
                                <div class="fw-semibold" data-bind="text: numberOfPeople"></div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <small class="text-muted" data-t="Reservation.TotalPrice">Toplam:</small>
                                <div class="fs-5 fw-bold text-primary" data-bind="text: totalPrice.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></div>
                            </div>
                            <a class="btn btn-outline-primary btn-sm" data-bind="attr: { href: '/Account/ReservationDetail/' + id }">
                                <i class="bi bi-eye me-1"></i>
                                <span data-t="Common.Details">Detay</span>
                            </a>
                        </div>
                    </div>

                    <div class="card-footer bg-transparent border-0 pt-0">
                        <small class="text-muted">
                            <i class="bi bi-building me-1"></i>
                            <a data-bind="attr: { href: '/' + companySlug }, text: companyName" class="text-decoration-none"></a>
                        </small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Empty State -->
        <div data-bind="visible: reservations().length === 0" class="text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
            <h5 class="mt-3 text-muted" data-t="MyReservations.NoReservations">Henuz rezervasyonunuz yok</h5>
            <p class="text-muted" data-t="MyReservations.ExploreMessage">Hemen bir tur kesfedip rezervasyon yapin!</p>
            <a href="/Tours" class="btn btn-primary">
                <i class="bi bi-search me-1"></i>
                <span data-t="MyReservations.ExploreTours">Turlari Kesfet</span>
            </a>
        </div>
    </div>
</div>

@section Scripts {
<script>
function ReservationsViewModel() {
    var self = this;

    self.reservations = ko.observableArray([]);
    self.isLoading = ko.observable(true);

    self.getStatusText = function(status) {
        var statusMap = {
            'Pending': T('Status.Pending'),
            'Confirmed': T('Status.Confirmed'),
            'Cancelled': T('Status.Cancelled'),
            'Completed': T('Status.Completed')
        };
        return statusMap[status] || status;
    };

    self.loadReservations = function() {
        self.isLoading(true);

        $.ajax({
            url: apiBaseUrl + '/api/reservations/visitor/my',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') },
            success: function(response) {
                self.reservations(response.reservations || []);
                self.isLoading(false);
            },
            error: function(xhr) {
                if (xhr.status === 401) {
                    window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                } else {
                    toastr.error(T('Common.Error'));
                }
                self.isLoading(false);
            }
        });
    };

    // Initialize
    self.loadReservations();
}

ko.applyBindings(new ReservationsViewModel(), document.getElementById('reservationsApp'));
</script>
}
