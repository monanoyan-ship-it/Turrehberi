@{
    ViewData["Title"] = "Rezervasyonlarim";
}

<div id="reservationsApp">
    <!-- Hero Section -->
    <div class="bg-primary text-white py-4 mb-4 rounded-3">
        <div class="container">
            <div class="row align-items-center">
                <div class="col-md-8">
                    <h1 class="display-6 mb-2">
                        <i class="bi bi-calendar-check me-2"></i>
                        <span data-t="MyReservations.Title">Rezervasyonlarim</span>
                    </h1>
                    <p class="mb-0 opacity-75" data-t="MyReservations.Subtitle">Tum rezervasyonlarinizi buradan takip edebilirsiniz</p>
                </div>
                <div class="col-md-4 text-md-end mt-3 mt-md-0">
                    <a href="/Tours" class="btn btn-light">
                        <i class="bi bi-plus-circle me-1"></i>
                        <span data-t="MyReservations.NewReservation">Yeni Rezervasyon</span>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Loading -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
    </div>

    <!-- Reservation List -->
    <div data-bind="visible: !isLoading()">
        <!-- Stats -->
        <div class="row g-3 mb-4" data-bind="visible: reservations().length > 0">
            <div class="col-6 col-md-3">
                <div class="card bg-light border-0">
                    <div class="card-body text-center py-3">
                        <div class="fs-4 fw-bold text-primary" data-bind="text: reservations().length"></div>
                        <small class="text-muted" data-t="MyReservations.Total">Toplam</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card bg-success bg-opacity-10 border-0 cursor-pointer" data-bind="click: function() { activeTab('active') }" style="cursor: pointer;">
                    <div class="card-body text-center py-3">
                        <div class="fs-4 fw-bold text-success" data-bind="text: activeReservations().length"></div>
                        <small class="text-muted" data-t="MyReservations.TabActive">Aktif</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card bg-secondary bg-opacity-10 border-0" data-bind="click: function() { activeTab('browsed') }" style="cursor: pointer;">
                    <div class="card-body text-center py-3">
                        <div class="fs-4 fw-bold text-secondary" data-bind="text: browsedReservations().length"></div>
                        <small class="text-muted" data-t="MyReservations.TabBrowsed">Incelediklerim</small>
                    </div>
                </div>
            </div>
            <div class="col-6 col-md-3">
                <div class="card bg-info bg-opacity-10 border-0" data-bind="click: function() { activeTab('completed') }" style="cursor: pointer;">
                    <div class="card-body text-center py-3">
                        <div class="fs-4 fw-bold text-info" data-bind="text: completedReservations().length"></div>
                        <small class="text-muted" data-t="MyReservations.TabCompleted">Tamamlanan</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabs -->
        <div data-bind="visible: reservations().length > 0">
            <ul class="nav nav-tabs mb-4">
                <li class="nav-item">
                    <a class="nav-link" href="#" data-bind="css: { active: activeTab() === 'active' }, click: function() { activeTab('active') }">
                        <i class="bi bi-check-circle me-1"></i>
                        <span data-t="MyReservations.TabActive">Aktif Rezervasyonlar</span>
                        <span class="badge bg-success ms-1" data-bind="text: activeReservations().length"></span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" data-bind="css: { active: activeTab() === 'browsed' }, click: function() { activeTab('browsed') }">
                        <i class="bi bi-eye me-1"></i>
                        <span data-t="MyReservations.TabBrowsed">Incelediklerim</span>
                        <span class="badge bg-secondary ms-1" data-bind="text: browsedReservations().length"></span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" data-bind="css: { active: activeTab() === 'completed' }, click: function() { activeTab('completed') }">
                        <i class="bi bi-flag me-1"></i>
                        <span data-t="MyReservations.TabCompleted">Tamamlanan</span>
                        <span class="badge bg-info ms-1" data-bind="text: completedReservations().length"></span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#" data-bind="css: { active: activeTab() === 'cancelled' }, click: function() { activeTab('cancelled') }">
                        <i class="bi bi-x-circle me-1"></i>
                        <span data-t="MyReservations.TabCancelled">Iptal Edilen</span>
                        <span class="badge bg-danger ms-1" data-bind="text: cancelledReservations().length"></span>
                    </a>
                </li>
            </ul>

            <!-- Active Tab Content -->
            <div data-bind="visible: activeTab() === 'active'">
                <div class="row g-4" data-bind="foreach: activeReservations">
                    <!-- ko template: { name: 'reservation-card' } --><!-- /ko -->
                </div>
                <div data-bind="visible: activeReservations().length === 0" class="text-center py-5">
                    <i class="bi bi-calendar-check text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted" data-t="MyReservations.NoActiveReservations">Aktif rezervasyonunuz yok</h5>
                </div>
            </div>

            <!-- Browsed Tab Content -->
            <div data-bind="visible: activeTab() === 'browsed'">
                <div class="row g-4" data-bind="foreach: browsedReservations">
                    <!-- ko template: { name: 'reservation-card' } --><!-- /ko -->
                </div>
                <div data-bind="visible: browsedReservations().length === 0" class="text-center py-5">
                    <i class="bi bi-eye-slash text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted" data-t="MyReservations.NoBrowsedReservations">Incelediginiz gecmis rezervasyon yok</h5>
                </div>
            </div>

            <!-- Completed Tab Content -->
            <div data-bind="visible: activeTab() === 'completed'">
                <div class="row g-4" data-bind="foreach: completedReservations">
                    <!-- ko template: { name: 'reservation-card' } --><!-- /ko -->
                </div>
                <div data-bind="visible: completedReservations().length === 0" class="text-center py-5">
                    <i class="bi bi-flag text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted" data-t="MyReservations.NoCompletedReservations">Tamamlanan rezervasyonunuz yok</h5>
                </div>
            </div>

            <!-- Cancelled Tab Content -->
            <div data-bind="visible: activeTab() === 'cancelled'">
                <div class="row g-4" data-bind="foreach: cancelledReservations">
                    <!-- ko template: { name: 'reservation-card' } --><!-- /ko -->
                </div>
                <div data-bind="visible: cancelledReservations().length === 0" class="text-center py-5">
                    <i class="bi bi-x-circle text-muted" style="font-size: 3rem;"></i>
                    <h5 class="mt-3 text-muted" data-t="MyReservations.NoCancelledReservations">Iptal edilen rezervasyonunuz yok</h5>
                </div>
            </div>
        </div>

        <!-- Empty State (no reservations at all) -->
        <div data-bind="visible: reservations().length === 0" class="text-center py-5">
            <i class="bi bi-calendar-x text-muted" style="font-size: 4rem;"></i>
            <h5 class="mt-3 text-muted" data-t="MyReservations.NoReservations">Henuz rezervasyonunuz yok</h5>
            <p class="text-muted" data-t="MyReservations.ExploreMessage">Hemen bir tur kesfedip rezervasyon yapin!</p>
            <a href="/Tours" class="btn btn-primary">
                <i class="bi bi-search me-1"></i>
                <span data-t="MyReservations.ExploreTours">Turlari Kesfet</span>
            </a>
        </div>
    </div>
</div>

<!-- Reservation Card Template -->
<script type="text/html" id="reservation-card">
    <div class="col-md-6 col-lg-4">
        <div class="card h-100 shadow-sm border-0">
            <!-- Tour Image -->
            <div class="position-relative">
                <img data-bind="attr: { src: tourImageUrl || 'https://picsum.photos/seed/' + tourId + '/400/200' }"
                     class="card-img-top" style="height: 150px; object-fit: cover;" alt="Tour">
                <!-- Status Badge -->
                <span class="position-absolute top-0 end-0 m-2 badge"
                      data-bind="css: {
                          'bg-warning': statusId === 0,
                          'bg-success': statusId === 1,
                          'bg-danger': statusId === 2,
                          'bg-info': statusId === 3
                      }, text: $root.getStatusText(status)">
                </span>
            </div>

            <div class="card-body">
                <h5 class="card-title mb-1" data-bind="text: tourName"></h5>
                <p class="text-muted small mb-2">
                    <i class="bi bi-geo-alt me-1"></i><span data-bind="text: tourDestination"></span>
                </p>

                <div class="d-flex justify-content-between mb-2">
                    <div>
                        <small class="text-muted" data-t="Reservation.StartDate">Baslangic:</small>
                        <div class="fw-semibold" data-bind="text: new Date(startDate).toLocaleDateString('tr-TR')"></div>
                    </div>
                    <div class="text-end">
                        <small class="text-muted" data-t="Reservation.People">Kisi:</small>
                        <div class="fw-semibold" data-bind="text: numberOfPeople"></div>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center">
                    <div>
                        <small class="text-muted" data-t="Reservation.TotalPrice">Toplam:</small>
                        <div class="fs-5 fw-bold text-primary" data-bind="text: totalPrice.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></div>
                    </div>
                    <a class="btn btn-outline-primary btn-sm" data-bind="attr: { href: '/Account/ReservationDetail/' + id }">
                        <i class="bi bi-eye me-1"></i>
                        <span data-t="Common.Details">Detay</span>
                    </a>
                </div>
            </div>

            <div class="card-footer bg-transparent border-0 pt-0">
                <small class="text-muted">
                    <i class="bi bi-building me-1"></i>
                    <a data-bind="attr: { href: '/' + companySlug }, text: companyName" class="text-decoration-none"></a>
                </small>
            </div>
        </div>
    </div>
</script>

@section Scripts {
<script>
function ReservationsViewModel() {
    var self = this;

    self.reservations = ko.observableArray([]);
    self.isLoading = ko.observable(true);
    self.activeTab = ko.observable('active');

    // Computed: Aktif rezervasyonlar (Pending/Confirmed AND (gelecek tarih VEYA odemesi var))
    self.activeReservations = ko.computed(function() {
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        return self.reservations().filter(function(r) {
            if (r.statusId !== 0 && r.statusId !== 1) return false;
            var startDate = new Date(r.startDate);
            startDate.setHours(0, 0, 0, 0);
            // Gelecek tarihli veya odemesi yapilmis
            var hasPaid = r.paymentStatusId === 1 || r.paymentStatusId === 2; // DepositPaid or FullyPaid
            return startDate >= today || hasPaid;
        });
    });

    // Computed: Incelenenler (Pending/Confirmed AND gecmis tarih AND odenmemis)
    self.browsedReservations = ko.computed(function() {
        var today = new Date();
        today.setHours(0, 0, 0, 0);
        return self.reservations().filter(function(r) {
            if (r.statusId !== 0 && r.statusId !== 1) return false;
            var startDate = new Date(r.startDate);
            startDate.setHours(0, 0, 0, 0);
            var hasPaid = r.paymentStatusId === 1 || r.paymentStatusId === 2;
            return startDate < today && !hasPaid;
        });
    });

    // Computed: Tamamlanan
    self.completedReservations = ko.computed(function() {
        return self.reservations().filter(function(r) {
            return r.statusId === 3;
        });
    });

    // Computed: Iptal edilen
    self.cancelledReservations = ko.computed(function() {
        return self.reservations().filter(function(r) {
            return r.statusId === 2;
        });
    });

    self.getStatusText = function(status) {
        var statusMap = {
            'Pending': T('Status.Pending'),
            'Confirmed': T('Status.Confirmed'),
            'Cancelled': T('Status.Cancelled'),
            'Completed': T('Status.Completed')
        };
        return statusMap[status] || status;
    };

    self.loadReservations = function() {
        self.isLoading(true);

        $.ajax({
            url: apiBaseUrl + '/api/reservations/visitor/my',
            method: 'GET',
            headers: { 'Authorization': 'Bearer ' + localStorage.getItem('token') },
            success: function(response) {
                self.reservations(response.reservations || []);
                self.isLoading(false);
            },
            error: function(xhr) {
                if (xhr.status === 401) {
                    window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname);
                } else {
                    toastr.error(T('Common.Error'));
                }
                self.isLoading(false);
            }
        });
    };

    // Initialize
    self.loadReservations();
}

ko.applyBindings(new ReservationsViewModel(), document.getElementById('reservationsApp'));
</script>
}
