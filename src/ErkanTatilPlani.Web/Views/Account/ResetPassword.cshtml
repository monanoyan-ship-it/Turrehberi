@{
    ViewData["Title"] = "Sifre Sifirla";
}

<div class="row justify-content-center mt-5">
    <div class="col-md-5">
        <div class="card shadow-lg border-0">
            <div class="card-body p-5">
                <div class="text-center mb-4">
                    <i class="bi bi-shield-lock text-success" style="font-size: 4rem;"></i>
                    <h3 class="mt-3" data-t="ResetPassword.Title">Yeni Sifre Belirle</h3>
                    <p class="text-muted" data-t="ResetPassword.Subtitle">Yeni sifrenizi girin</p>
                </div>

                <div id="resetPasswordApp" data-token="@ViewBag.Token" data-email="@ViewBag.Email">
                    <!-- Token Kontrol -->
                    <div data-bind="visible: isChecking" class="text-center py-4">
                        <div class="spinner-border text-primary"></div>
                        <p class="mt-2 text-muted" data-t="Common.Loading">Kontrol ediliyor...</p>
                    </div>

                    <!-- Gecersiz Token -->
                    <div data-bind="visible: !isChecking() && !isValidToken() && !resetSuccess()" class="text-center">
                        <div class="alert alert-danger">
                            <i class="bi bi-x-circle-fill me-2"></i>
                            <span data-t="ResetPassword.InvalidToken">Gecersiz veya suresi dolmus sifre sifirlama linki</span>
                        </div>
                        <p class="text-muted mb-3" data-t="ResetPassword.RequestNewLink">Lutfen yeni bir sifre sifirlama linki isteyin.</p>
                        <a href="/Account/ForgotPassword" class="btn btn-warning">
                            <i class="bi bi-arrow-repeat me-1"></i>
                            <span data-t="ResetPassword.RequestAgain">Yeni Link Iste</span>
                        </a>
                    </div>

                    <!-- Sifre Formu -->
                    <div data-bind="visible: !isChecking() && isValidToken() && !resetSuccess()">
                        <div class="mb-3">
                            <label class="form-label" data-t="Profile.NewPassword">Yeni Sifre</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key"></i></span>
                                <input type="password" class="form-control" data-bind="value: newPassword" placeholder="******" />
                            </div>
                            <small class="text-muted" data-t="Register.PasswordHint">En az 6 karakter</small>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" data-t="Profile.ConfirmPassword">Sifre Tekrar</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-key-fill"></i></span>
                                <input type="password" class="form-control" data-bind="value: confirmPassword" placeholder="******" />
                            </div>
                        </div>

                        <button class="btn btn-success w-100 py-2 mb-3" data-bind="click: resetPassword, disable: isLoading">
                            <span data-bind="visible: isLoading" class="spinner-border spinner-border-sm me-2"></span>
                            <i class="bi bi-check-lg me-1" data-bind="visible: !isLoading()"></i>
                            <span data-t="ResetPassword.SetPassword">Sifreyi Degistir</span>
                        </button>
                    </div>

                    <!-- Basarili -->
                    <div data-bind="visible: resetSuccess()" class="text-center">
                        <div class="alert alert-success">
                            <i class="bi bi-check-circle-fill me-2"></i>
                            <span data-t="ResetPassword.Success">Sifreniz basariyla degistirildi!</span>
                        </div>
                        <p class="text-muted mb-3" data-t="ResetPassword.CanLogin">Artik yeni sifrenizle giris yapabilirsiniz.</p>
                        <a href="/Account/Login" class="btn btn-primary">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            <span data-t="Menu.Login">Giris Yap</span>
                        </a>
                    </div>

                    <div class="text-center mt-3" data-bind="visible: !resetSuccess()">
                        <a href="/Account/Login" class="text-decoration-none">
                            <i class="bi bi-arrow-left me-1"></i>
                            <span data-t="ForgotPassword.BackToLogin">Giris sayfasina don</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Account/ResetPassword.js" asp-append-version="true"></script>
}
