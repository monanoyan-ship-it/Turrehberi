@{
    ViewData["Title"] = "Gezgin Kulübü";
}

<div class="container py-4" id="travelerClubApp">
    <!-- Loading State -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
    </div>

    <!-- Not Logged In -->
    <div data-bind="visible: !isLoading() && !isLoggedIn()" class="text-center py-5">
        <i class="bi bi-person-x text-muted" style="font-size: 4rem;"></i>
        <h4 class="mt-3" data-t="Profile.LoginRequired">Giris yapmaniz gerekiyor</h4>
        <a href="/Account/Login" class="btn btn-primary mt-3">
            <i class="bi bi-box-arrow-in-right me-1"></i>
            <span data-t="Menu.Login">Giris Yap</span>
        </a>
    </div>

    <!-- Main Content -->
    <div data-bind="visible: !isLoading() && isLoggedIn()">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h3>
                <i class="bi bi-people me-2"></i>
                <span data-t="TravelerClub.Title">Gezgin Kulubu</span>
            </h3>
            <a href="/Account/CreateStory" class="btn btn-primary">
                <i class="bi bi-pencil-square me-1"></i>
                <span data-t="TripStory.Create">Hikaye Paylas</span>
            </a>
        </div>

        <div class="row">
            <!-- Main Feed Area -->
            <div class="col-lg-8">
                <!-- Tabs -->
                <ul class="nav nav-tabs mb-3">
                    <li class="nav-item">
                        <a class="nav-link" data-bind="css: { active: activeTab() === 'feed' }, click: function() { switchTab('feed'); }" href="#">
                            <i class="bi bi-rss me-1"></i>
                            <span data-t="TravelerClub.Feed">Benim Akisim</span>
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" data-bind="css: { active: activeTab() === 'discover' }, click: function() { switchTab('discover'); }" href="#">
                            <i class="bi bi-compass me-1"></i>
                            <span data-t="TravelerClub.Discover">Kesfet</span>
                        </a>
                    </li>
                </ul>

                <!-- Stories Feed -->
                <div data-bind="foreach: stories">
                    <div class="card shadow-sm border-0 mb-3">
                        <div class="card-body">
                            <!-- Author -->
                            <div class="d-flex align-items-center mb-3">
                                <a data-bind="attr: { href: '/Travelers/Profile/' + visitor.id }">
                                    <img data-bind="attr: { src: visitor.avatarUrl || '/images/placeholders/avatar-placeholder.svg' }"
                                         class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;" />
                                </a>
                                <div>
                                    <a data-bind="attr: { href: '/Travelers/Profile/' + visitor.id }, text: visitor.firstName + ' ' + visitor.lastName"
                                       class="fw-semibold text-decoration-none text-dark"></a>
                                    <span class="badge ms-1" data-bind="text: $root.T(visitor.tierNameKey), css: visitor.tierCssClass"></span>
                                    <br />
                                    <small class="text-muted" data-bind="text: new Date(createdAt).toLocaleDateString()"></small>
                                </div>
                            </div>
                            <!-- Content -->
                            <h5>
                                <a data-bind="attr: { href: '/Travelers/Story/' + id }, text: title" class="text-decoration-none text-dark"></a>
                            </h5>
                            <p data-bind="text: contentPreview" class="text-muted"></p>

                            <!-- Photo -->
                            <!-- ko if: photoUrl -->
                            <img data-bind="attr: { src: photoUrl }" class="img-fluid rounded mb-3" style="max-height: 300px; object-fit: cover; width: 100%;" />
                            <!-- /ko -->

                            <!-- Tour & Destination -->
                            <div class="mb-2">
                                <!-- ko if: tourName -->
                                <span class="badge bg-light text-dark border me-1">
                                    <i class="bi bi-geo-alt me-1"></i>
                                    <span data-bind="text: tourName"></span>
                                </span>
                                <!-- /ko -->
                                <!-- ko if: destination -->
                                <span class="badge bg-light text-dark border me-1">
                                    <i class="bi bi-pin-map me-1"></i>
                                    <span data-bind="text: destination"></span>
                                </span>
                                <!-- /ko -->
                                <!-- ko if: rating -->
                                <span class="badge bg-warning text-dark me-1">
                                    <i class="bi bi-star-fill me-1"></i>
                                    <span data-bind="text: rating"></span>/5
                                </span>
                                <!-- /ko -->
                            </div>

                            <!-- Actions -->
                            <div class="d-flex align-items-center gap-3">
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: function() { $root.toggleLike(id); }">
                                    <i class="bi bi-heart me-1"></i>
                                    <span data-bind="text: likeCount"></span>
                                </button>
                                <a data-bind="attr: { href: '/Travelers/Story/' + id }" class="btn btn-sm btn-outline-secondary">
                                    <i class="bi bi-chat me-1"></i>
                                    <span data-bind="text: commentCount"></span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Empty State -->
                <div data-bind="visible: stories().length === 0 && !isLoadingStories()" class="text-center py-5">
                    <i class="bi bi-journal-text text-muted" style="font-size: 3rem;"></i>
                    <p class="text-muted mt-3" data-bind="visible: activeTab() === 'feed'" data-t="TravelerClub.NoFeedStories">Henuz takip ettiginiz kisilerden hikaye yok</p>
                    <p class="text-muted mt-3" data-bind="visible: activeTab() === 'discover'" data-t="TripStory.NoStories">Henuz hikaye paylasılmamis</p>
                </div>

                <!-- Loading More -->
                <div data-bind="visible: isLoadingStories" class="text-center py-3">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                </div>

                <!-- Load More -->
                <div data-bind="visible: hasMore() && !isLoadingStories()" class="text-center mt-3 mb-4">
                    <button class="btn btn-outline-primary" data-bind="click: loadMore">
                        <span data-t="Common.LoadMore">Daha Fazla</span>
                    </button>
                </div>
            </div>

            <!-- Sidebar -->
            <div class="col-lg-4">
                <!-- My Stats -->
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body">
                        <h6 class="mb-3">
                            <i class="bi bi-bar-chart me-1"></i>
                            <span data-t="TravelerProfile.MyStats">Istatistiklerim</span>
                        </h6>
                        <div class="row text-center">
                            <div class="col-4">
                                <h5 data-bind="text: myFollowerCount()"></h5>
                                <small class="text-muted" data-t="TravelerProfile.Followers">Takipci</small>
                            </div>
                            <div class="col-4">
                                <h5 data-bind="text: myFollowingCount()"></h5>
                                <small class="text-muted" data-t="TravelerProfile.Following">Takip</small>
                            </div>
                            <div class="col-4">
                                <h5 data-bind="text: myStoryCount()"></h5>
                                <small class="text-muted" data-t="TripStory.Stories">Hikaye</small>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Top Travelers -->
                <div class="card shadow-sm border-0 mb-3">
                    <div class="card-body">
                        <h6 class="mb-3">
                            <i class="bi bi-trophy me-1"></i>
                            <span data-t="TravelerClub.TopTravelers">En Aktif Gezginler</span>
                        </h6>
                        <div data-bind="foreach: topTravelers">
                            <div class="d-flex align-items-center mb-2">
                                <a data-bind="attr: { href: '/Travelers/Profile/' + id }">
                                    <img data-bind="attr: { src: avatarUrl || '/images/placeholders/avatar-placeholder.svg' }"
                                         class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;" />
                                </a>
                                <div class="flex-grow-1">
                                    <a data-bind="attr: { href: '/Travelers/Profile/' + id }, text: firstName + ' ' + lastName"
                                       class="small fw-semibold text-decoration-none text-dark d-block"></a>
                                    <small class="text-muted">
                                        <span data-bind="text: tripStoryCount"></span> <span data-t="TripStory.Stories">hikaye</span>
                                    </small>
                                </div>
                                <span class="badge" data-bind="css: tierCssClass">
                                    <i data-bind="attr: { class: 'bi ' + tierIcon }"></i>
                                </span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Quick Links -->
                <div class="card shadow-sm border-0">
                    <div class="card-body">
                        <a href="/Account/Loyalty" class="btn btn-outline-primary w-100 mb-2">
                            <i class="bi bi-award me-1"></i>
                            <span data-t="Loyalty.Dashboard">Gezgin Kulubu</span>
                        </a>
                        <a href="/Account/Profile" class="btn btn-outline-secondary w-100">
                            <i class="bi bi-person me-1"></i>
                            <span data-t="Menu.Profile">Profilim</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Account/TravelerClub.js" asp-append-version="true"></script>
}
