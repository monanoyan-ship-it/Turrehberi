@{
    Layout = "_AdminLayout";
}

<div id="adminBlogPostsApp">
    <!-- Filtre Butonlari -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div class="btn-group" role="group">
            <button type="button" class="btn"
                    data-bind="click: function() { filterStatus(null) }, css: filterStatus() === null ? 'btn-primary' : 'btn-outline-primary'">
                Tumu <span class="badge bg-light text-dark ms-1" data-bind="text: totalCount()"></span>
            </button>
            <button type="button" class="btn"
                    data-bind="click: function() { filterStatus(0) }, css: filterStatus() === 0 ? 'btn-secondary' : 'btn-outline-secondary'">
                <i class="bi bi-file-earmark me-1"></i> Taslak
            </button>
            <button type="button" class="btn"
                    data-bind="click: function() { filterStatus(1) }, css: filterStatus() === 1 ? 'btn-success' : 'btn-outline-success'">
                <i class="bi bi-check-circle me-1"></i> Yayinda
            </button>
            <button type="button" class="btn"
                    data-bind="click: function() { filterStatus(2) }, css: filterStatus() === 2 ? 'btn-warning' : 'btn-outline-warning'">
                <i class="bi bi-archive me-1"></i> Arsiv
            </button>
        </div>
        <button class="btn btn-primary" data-bind="click: openCreateModal">
            <i class="bi bi-plus-circle me-1"></i> Yeni Yazi
        </button>
    </div>

    <!-- Arama -->
    <div class="mb-3">
        <div class="input-group">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" class="form-control" placeholder="Yazi ara..." data-bind="value: searchQuery, valueUpdate: 'afterkeydown'" />
        </div>
    </div>

    <!-- Tablo -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Baslik</th>
                            <th>Kategori</th>
                            <th>Yazar</th>
                            <th>Durum</th>
                            <th>Goruntuleme</th>
                            <th>Yorum</th>
                            <th>Tarih</th>
                            <th style="width: 180px;">Islemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: posts">
                        <tr>
                            <td>
                                <div class="fw-semibold" data-bind="text: title"></div>
                                <small class="text-muted" data-bind="text: slug"></small>
                            </td>
                            <td>
                                <span class="badge" data-bind="css: $parent.getCategoryBadgeClass(categoryId), text: $parent.getCategoryName(categoryId)"></span>
                            </td>
                            <td data-bind="text: authorName"></td>
                            <td>
                                <span class="badge" data-bind="css: $parent.getStatusBadgeClass(statusId), text: $parent.getStatusName(statusId)"></span>
                            </td>
                            <td><i class="bi bi-eye me-1"></i><span data-bind="text: viewCount"></span></td>
                            <td><i class="bi bi-chat me-1"></i><span data-bind="text: commentCount"></span></td>
                            <td>
                                <small data-bind="text: $parent.formatDate(publishedAt || createdAt)"></small>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <!-- ko if: statusId === 0 -->
                                    <button class="btn btn-success" data-bind="click: function() { $parent.updateStatus(id, 1); }" data-t-title="Blog.Publish" title="Yayinla">
                                        <i class="bi bi-check-lg"></i>
                                    </button>
                                    <!-- /ko -->
                                    <!-- ko if: statusId === 1 -->
                                    <button class="btn btn-outline-warning" data-bind="click: function() { $parent.updateStatus(id, 2); }" data-t-title="Blog.Archive" title="Arsivle">
                                        <i class="bi bi-archive"></i>
                                    </button>
                                    <!-- /ko -->
                                    <!-- ko if: statusId === 2 -->
                                    <button class="btn btn-outline-success" data-bind="click: function() { $parent.updateStatus(id, 1); }" title="Tekrar Yayinla">
                                        <i class="bi bi-arrow-counterclockwise"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.openEditModal" data-t-title="Common.Edit" title="Duzenle">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" data-bind="click: $parent.openDeleteModal" data-t-title="Common.Delete" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="text-center py-5" data-bind="visible: posts().length === 0">
                <i class="bi bi-journal-x text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2">Blog yazisi bulunamadi</p>
            </div>
        </div>
    </div>

    <!-- Sayfalama -->
    <nav class="mt-3" data-bind="visible: totalPages() > 1">
        <ul class="pagination justify-content-center">
            <li class="page-item" data-bind="css: { disabled: currentPage() <= 1 }">
                <a class="page-link" href="#" data-bind="click: function() { changePage(currentPage() - 1); }"><i class="bi bi-chevron-left"></i></a>
            </li>
            <!-- ko foreach: pageNumbers -->
            <li class="page-item" data-bind="css: { active: $data === $parent.currentPage() }">
                <a class="page-link" href="#" data-bind="text: $data, click: function() { $parent.changePage($data); }"></a>
            </li>
            <!-- /ko -->
            <li class="page-item" data-bind="css: { disabled: currentPage() >= totalPages() }">
                <a class="page-link" href="#" data-bind="click: function() { changePage(currentPage() + 1); }"><i class="bi bi-chevron-right"></i></a>
            </li>
        </ul>
    </nav>

    <!-- Create/Edit Modal -->
    <div class="modal fade" id="formModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: isEditing() ? 'Yazi Duzenle' : 'Yeni Yazi'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="blogForm">
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Baslik *</label>
                                <input type="text" class="form-control" data-bind="value: formData().title" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kategori *</label>
                                <select class="form-select" data-bind="value: formData().categoryId">
                                    <option value="0">Seyahat Ipuclari</option>
                                    <option value="1">Gezi Rehberleri</option>
                                    <option value="2">Haberler</option>
                                    <option value="3">Kultur & Yasam</option>
                                    <option value="4">Yeme & Icme</option>
                                    <option value="5">Macera & Doga</option>
                                </select>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Ozet *</label>
                            <textarea class="form-control" rows="2" data-bind="value: formData().summary" maxlength="500"></textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Icerik *</label>
                            <textarea class="form-control" id="contentEditor" rows="10" data-bind="value: formData().content"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Kapak Gorseli URL</label>
                                <input type="url" class="form-control" data-bind="value: formData().imageUrl" placeholder="https://..." />
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Etiketler</label>
                                <input type="text" class="form-control" data-bind="value: formData().tags" placeholder="etiket1,etiket2,etiket3" />
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Durum</label>
                                <select class="form-select" data-bind="value: formData().statusId">
                                    <option value="0">Taslak</option>
                                    <option value="1">Yayinla</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Meta Baslik</label>
                                <input type="text" class="form-control" data-bind="value: formData().metaTitle" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Meta Aciklama</label>
                                <input type="text" class="form-control" data-bind="value: formData().metaDescription" />
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: savePost, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Yazi Sil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Bu yaziyi silmek istediginizden emin misiniz?</p>
                    <p class="fw-semibold" data-bind="text: selectedPost() ? selectedPost().title : ''"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-danger" data-bind="click: deletePost, disable: isSaving">Evet, Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="~/lib/summernote/summernote-bs5.min.css" />
}

@section Scripts {
<script src="~/lib/summernote/summernote-bs5.min.js"></script>
<script src="~/js/Admin/BlogPosts.js"></script>
}
