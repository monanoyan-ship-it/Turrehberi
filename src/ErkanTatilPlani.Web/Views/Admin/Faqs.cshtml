@{
    Layout = "_AdminLayout";
}

<div id="faqsApp">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <p class="text-muted mb-0">Sikca sorulan sorulari yonetin</p>
        <button class="btn btn-primary" data-bind="click: openAddModal">
            <i class="bi bi-plus-circle me-1"></i> Yeni Soru
        </button>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width:50px">Sira</th>
                            <th>Soru</th>
                            <th>Kategori</th>
                            <th style="width:140px">Islemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: faqs">
                        <tr>
                            <td data-bind="text: displayOrder"></td>
                            <td data-bind="text: question"></td>
                            <td>
                                <span class="badge bg-info" data-bind="text: category || 'Genel'"></span>
                            </td>
                            <td>
                                <button class="btn btn-sm btn-outline-primary me-1" data-bind="click: $parent.openEditModal">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-sm btn-outline-danger" data-bind="click: $parent.deleteFaq">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Modal -->
    <div class="modal fade" id="faqModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: isEditing() ? 'Soru Duzenle' : 'Yeni Soru'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Soru</label>
                        <input type="text" class="form-control" data-bind="value: formData().question">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Cevap</label>
                        <textarea class="form-control" rows="5" data-bind="value: formData().answer"></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Kategori</label>
                            <select class="form-select" data-bind="value: formData().category">
                                <option value="">Genel</option>
                                <option value="Rezervasyon">Rezervasyon</option>
                                <option value="Odeme">Odeme</option>
                                <option value="Iptal">Iptal / Iade</option>
                                <option value="Hesap">Hesap</option>
                                <option value="Tur">Tur Bilgileri</option>
                            </select>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Siralama</label>
                            <input type="number" class="form-control" data-bind="value: formData().displayOrder">
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveFaq">
                        <i class="bi bi-check-lg me-1"></i> Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Admin/Faqs.js" asp-append-version="true"></script>
}
