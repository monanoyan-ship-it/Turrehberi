@{
    Layout = "_AdminLayout";
}

<div id="dashboardApp">
    <!-- Stat Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Toplam Tur</div>
                            <div class="fs-3 fw-bold" data-bind="text: stats().totalTours">-</div>
                        </div>
                        <div class="rounded p-2 bg-primary bg-opacity-10 text-primary">
                            <i class="bi bi-geo-alt fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Toplam Firma</div>
                            <div class="fs-3 fw-bold" data-bind="text: stats().totalCompanies">-</div>
                        </div>
                        <div class="rounded p-2 bg-success bg-opacity-10 text-success">
                            <i class="bi bi-building fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Toplam Kullanici</div>
                            <div class="fs-3 fw-bold" data-bind="text: stats().totalVisitors">-</div>
                        </div>
                        <div class="rounded p-2 bg-info bg-opacity-10 text-info">
                            <i class="bi bi-people fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card h-100">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <div class="text-muted small">Bekleyen Rezervasyon</div>
                            <div class="fs-3 fw-bold text-warning" data-bind="text: stats().pendingReservations">-</div>
                        </div>
                        <div class="rounded p-2 bg-warning bg-opacity-10 text-warning">
                            <i class="bi bi-calendar-check fs-4"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Son Rezervasyonlar -->
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-calendar-check me-2"></i>Son Rezervasyonlar</span>
                    <a href="/Admin/Reservations" class="btn btn-sm btn-outline-primary">Tumunu Gor</a>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Misafir</th>
                                    <th>Tur</th>
                                    <th>Tarih</th>
                                    <th>Kisi</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: recentReservations">
                                <tr>
                                    <td data-bind="text: visitor ? visitor.firstName + ' ' + visitor.lastName : '-'"></td>
                                    <td data-bind="text: tour ? tour.name : '-'"></td>
                                    <td data-bind="text: new Date(startDate).toLocaleDateString('tr-TR')"></td>
                                    <td data-bind="text: numberOfPeople"></td>
                                    <td>
                                        <span class="badge" data-bind="css: getStatusBadge(status), text: getStatusText(status)"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    <div data-bind="visible: recentReservations().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-inbox fs-1"></i>
                        <p class="mt-2">Henuz rezervasyon bulunmuyor</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Populer Turlar -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-star me-2"></i>One Cikan Turlar
                </div>
                <div class="card-body p-0">
                    <div class="list-group list-group-flush" data-bind="foreach: featuredTours">
                        <div class="list-group-item d-flex align-items-center gap-3">
                            <div class="rounded bg-light d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                <!-- ko if: imageUrl -->
                                <img data-bind="attr: { src: imageUrl }" class="rounded" style="width: 50px; height: 50px; object-fit: cover;" />
                                <!-- /ko -->
                                <!-- ko ifnot: imageUrl -->
                                <i class="bi bi-image text-muted"></i>
                                <!-- /ko -->
                            </div>
                            <div class="flex-grow-1">
                                <div class="fw-semibold" data-bind="text: name"></div>
                                <small class="text-muted" data-bind="text: destination"></small>
                            </div>
                            <div class="text-end">
                                <div class="fw-bold text-primary" data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></div>
                            </div>
                        </div>
                    </div>
                    <div data-bind="visible: featuredTours().length === 0" class="text-center text-muted py-4">
                        <i class="bi bi-star fs-1"></i>
                        <p class="mt-2">One cikan tur bulunmuyor</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Cache Yonetimi -->
    <div class="row g-4 mt-2">
        <div class="col-12">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <span><i class="bi bi-database me-2"></i>Cache Yonetimi</span>
                    <span class="badge bg-info">Performans</span>
                </div>
                <div class="card-body">
                    <div class="row g-3">
                        <div class="col-md-4 col-lg-2">
                            <button class="btn btn-outline-danger w-100" data-bind="click: clearAllCache, disable: isCacheClearing">
                                <span data-bind="visible: !isCacheClearing()">
                                    <i class="bi bi-trash3 me-1"></i> Tum Cache
                                </span>
                                <span data-bind="visible: isCacheClearing" class="spinner-border spinner-border-sm"></span>
                            </button>
                        </div>
                        <div class="col-md-4 col-lg-2">
                            <button class="btn btn-outline-primary w-100" data-bind="click: function() { clearCache('tours') }, disable: isCacheClearing">
                                <i class="bi bi-geo-alt me-1"></i> Tur Cache
                            </button>
                        </div>
                        <div class="col-md-4 col-lg-2">
                            <button class="btn btn-outline-success w-100" data-bind="click: function() { clearCache('companies') }, disable: isCacheClearing">
                                <i class="bi bi-building me-1"></i> Firma Cache
                            </button>
                        </div>
                        <div class="col-md-4 col-lg-2">
                            <button class="btn btn-outline-info w-100" data-bind="click: function() { clearCache('localization') }, disable: isCacheClearing">
                                <i class="bi bi-translate me-1"></i> Dil Cache
                            </button>
                        </div>
                        <div class="col-md-4 col-lg-2">
                            <button class="btn btn-outline-warning w-100" data-bind="click: function() { clearCache('stats') }, disable: isCacheClearing">
                                <i class="bi bi-bar-chart me-1"></i> Istatistik Cache
                            </button>
                        </div>
                        <div class="col-md-4 col-lg-2">
                            <button class="btn btn-secondary w-100" data-bind="click: loadData">
                                <i class="bi bi-arrow-clockwise me-1"></i> Yenile
                            </button>
                        </div>
                    </div>
                    <div class="mt-3">
                        <small class="text-muted">
                            <i class="bi bi-info-circle me-1"></i>
                            Cache temizleme, guncel verilerin gosterilmesini saglar. Performans icin gerekmedikce kullanmayin.
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Admin/Index.js"></script>
}
