@{
    Layout = "_AdminLayout";
}

<div id="languagesApp">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <p class="text-muted mb-0">Sistem dillerini ve cevirilerini yonetin</p>
        <div>
            <button class="btn btn-success me-2" data-bind="click: importAll, disable: isImporting">
                <span data-bind="visible: isImporting" class="spinner-border spinner-border-sm me-1"></span>
                <i class="bi bi-cloud-upload me-1" data-bind="visible: !isImporting()"></i> Tum Dilleri Yukle
            </button>
            <button class="btn btn-primary" data-bind="click: openAddModal">
                <i class="bi bi-plus-circle me-1"></i> Yeni Dil
            </button>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Bayrak</th>
                            <th>Dil Adi</th>
                            <th>Kultur Kodu</th>
                            <th>SEO Kodu</th>
                            <th>Ceviri Sayisi</th>
                            <th>Varsayilan</th>
                            <th>Durum</th>
                            <th>Islemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: languages">
                        <tr>
                            <td>
                                <span style="font-size: 1.5rem;" data-bind="attr: { class: flagIcon }"></span>
                            </td>
                            <td class="fw-semibold" data-bind="text: name"></td>
                            <td><code data-bind="text: languageCulture"></code></td>
                            <td><code data-bind="text: uniqueSeoCode"></code></td>
                            <td>
                                <span class="badge bg-light text-dark" data-bind="text: resourceCount || 0"></span>
                            </td>
                            <td>
                                <!-- ko if: isDefault -->
                                <span class="badge bg-primary"><i class="bi bi-check"></i> Varsayilan</span>
                                <!-- /ko -->
                                <!-- ko ifnot: isDefault -->
                                <button class="btn btn-sm btn-outline-secondary" data-bind="click: $parent.setDefault">Varsayilan Yap</button>
                                <!-- /ko -->
                            </td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? 'Aktif' : 'Pasif'"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-success" data-bind="click: $parent.importFromFolder, disable: $parent.isImporting" title="Klasorden Yukle">
                                        <i class="bi bi-folder-symlink"></i>
                                    </button>
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.exportXml" title="XML Indir">
                                        <i class="bi bi-download"></i>
                                    </button>
                                    <button class="btn btn-outline-warning" data-bind="click: $parent.editResources" title="Cevirileri Duzenle">
                                        <i class="bi bi-translate"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>

@section Scripts {
<script src="~/js/Admin/Languages.js"></script>
}
