@{
    Layout = "_AdminLayout";
}

<div class="alert alert-info">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Firma Sahibi Paneli:</strong> Bu sayfada firmaniza ait turlara yapilan rezervasyonlari gorebilirsiniz.
</div>

<div class="admin-card">
    <div class="card-header">
        <i class="bi bi-calendar-check me-2"></i>Rezervasyonlarim
    </div>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-calendar-check fs-1"></i>
        <p class="mt-3">Bu ozellik firma sahibi girisi yapildiginda aktif olacaktir.</p>
        <p><small>Simdilik Admin panelinden rezervasyon yonetimi yapabilirsiniz.</small></p>
    </div>
</div>
