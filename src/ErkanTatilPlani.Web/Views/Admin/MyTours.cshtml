@{
    Layout = "_AdminLayout";
}

<div class="alert alert-info">
    <i class="bi bi-info-circle me-2"></i>
    <strong>Firma Sahibi Paneli:</strong> Bu sayfada sadece kendi firmaniza ait turlari gorebilir ve yonetebilirsiniz.
</div>

<!-- Tur listesi icin Admin/Tours.cshtml'deki ayni yapi kullanilacak -->
<div class="admin-card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <span><i class="bi bi-geo-alt me-2"></i>Turlarim</span>
        <button class="btn btn-sm btn-primary">
            <i class="bi bi-plus me-1"></i>Yeni Tur Ekle
        </button>
    </div>
    <div class="card-body text-center text-muted py-5">
        <i class="bi bi-geo-alt fs-1"></i>
        <p class="mt-3">Bu ozellik firma sahibi girisi yapildiginda aktif olacaktir.</p>
        <p><small>Simdilik Admin panelinden tur yonetimi yapabilirsiniz.</small></p>
    </div>
</div>
