@{
    Layout = "_AdminLayout";
}

<div id="myToursApp">
    <!-- Firma Durumu Uyarisi -->
    <div data-bind="visible: !canManageTours() && !isLoading()" class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong data-t="Error.CompanyNotApproved">Firma onaylanmadan tur islemleri yapamazsiniz.</strong>
        <span data-t="Error.CompanyPending">Basvurunuz inceleniyor.</span>
    </div>

    <!-- Yukleniyor -->
    <div data-bind="visible: isLoading()" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
        <p class="mt-3 text-muted" data-t="Common.Loading">Yukleniyor...</p>
    </div>

    <!-- Ana Icerik -->
    <div data-bind="visible: !isLoading()">
        <!-- Tur Listesi -->
        <div class="admin-card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-geo-alt me-2"></i><span data-t="MyTours.Title">Turlarim</span></span>
                <button class="btn btn-sm btn-primary" data-bind="click: openAddModal, enable: canManageTours()">
                    <i class="bi bi-plus me-1"></i><span data-t="MyTours.AddTour">Yeni Tur Ekle</span>
                </button>
            </div>
            <div class="card-body p-0">
                <!-- Veri yok -->
                <div data-bind="visible: tours().length === 0" class="text-center text-muted py-5">
                    <i class="bi bi-geo-alt fs-1"></i>
                    <p class="mt-3" data-t="MyTours.NoTours">Henuz tur eklenmemis</p>
                    <button class="btn btn-primary" data-bind="click: openAddModal, enable: canManageTours()">
                        <i class="bi bi-plus me-1"></i><span data-t="MyTours.AddFirstTour">Ilk Turunuzu Ekleyin</span>
                    </button>
                </div>

                <!-- Tablo -->
                <div class="table-responsive" data-bind="visible: tours().length > 0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;"></th>
                                <th data-t="Tour.Name">Tur Adi</th>
                                <th data-t="Tour.Destination">Destinasyon</th>
                                <th class="text-end" data-t="Tour.Price">Fiyat</th>
                                <th class="text-center" data-t="Tour.Duration">Sure</th>
                                <th class="text-center" data-t="Tour.Capacity">Kapasite</th>
                                <th class="text-center" data-t="MyTours.Reservations">Rezervasyon</th>
                                <th class="text-center" data-t="Dashboard.Rating">Puan</th>
                                <th class="text-center" data-t="Common.Active">Durum</th>
                                <th class="text-center" data-t="Common.Actions">Islemler</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: tours">
                            <tr data-bind="css: { 'table-secondary': !isActive }">
                                <td>
                                    <img data-bind="attr: { src: imageUrl || 'https://picsum.photos/seed/' + id + '/60/40' }"
                                         class="rounded" style="width: 60px; height: 40px; object-fit: cover;">
                                </td>
                                <td>
                                    <div class="fw-medium" data-bind="text: name"></div>
                                    <small class="text-muted" data-bind="text: description.substring(0, 50) + (description.length > 50 ? '...' : '')"></small>
                                </td>
                                <td data-bind="text: destination"></td>
                                <td class="text-end fw-medium" data-bind="text: $parent.formatCurrency(price)"></td>
                                <td class="text-center">
                                    <span data-bind="text: durationDays"></span> <span data-t="MyTours.Days">gun</span>
                                </td>
                                <td class="text-center" data-bind="text: maxCapacity"></td>
                                <td class="text-center">
                                    <span class="badge bg-primary" data-bind="text: reservationCount"></span>
                                </td>
                                <td class="text-center">
                                    <span data-bind="visible: averageRating > 0">
                                        <span data-bind="text: averageRating.toFixed(1)"></span>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <small class="text-muted">(<span data-bind="text: reviewCount"></span>)</small>
                                    </span>
                                    <span data-bind="visible: !averageRating || averageRating === 0" class="text-muted">-</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? 'Aktif' : 'Pasif'"></span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" data-bind="click: $parent.openEditModal, enable: $parent.canManageTours()" title="Duzenle">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" data-bind="click: $parent.confirmDelete, enable: $parent.canManageTours()" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tur Ekle/Duzenle Modal -->
    <div class="modal fade" id="tourModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-geo-alt me-2"></i>
                        <span data-bind="text: isEditing() ? 'Tur Duzenle' : 'Yeni Tur Ekle'"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="tourForm">
                        <div class="row g-3">
                            <!-- Tur Adi -->
                            <div class="col-md-6">
                                <label class="form-label" data-t="Tour.Name">Tur Adi <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: formData().name" required>
                            </div>

                            <!-- Destinasyon -->
                            <div class="col-md-6">
                                <label class="form-label" data-t="Tour.Destination">Destinasyon <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: formData().destination" required>
                            </div>

                            <!-- Aciklama -->
                            <div class="col-12">
                                <label class="form-label" data-t="Tour.Description">Aciklama</label>
                                <textarea class="form-control" rows="3" data-bind="value: formData().description"></textarea>
                            </div>

                            <!-- Fiyat -->
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.Price">Fiyat (TL) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" data-bind="value: formData().price" min="0" step="0.01" required>
                            </div>

                            <!-- Sure -->
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.Duration">Sure (Gun) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" data-bind="value: formData().durationDays" min="1" required>
                            </div>

                            <!-- Kapasite -->
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.Capacity">Maksimum Kapasite <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" data-bind="value: formData().maxCapacity" min="1" required>
                            </div>

                            <!-- Resim URL -->
                            <div class="col-12">
                                <label class="form-label" data-t="MyTours.ImageUrl">Resim URL</label>
                                <input type="url" class="form-control" data-bind="value: formData().imageUrl" placeholder="https://...">
                                <small class="text-muted" data-t="MyTours.ImageUrlHint">Bos birakirsaniz varsayilan resim kullanilir</small>
                            </div>

                            <!-- One Cikan -->
                            <div class="col-12">
                                <div class="form-check">
                                    <input type="checkbox" class="form-check-input" id="isFeatured" data-bind="checked: formData().isFeatured">
                                    <label class="form-check-label" for="isFeatured" data-t="Tour.Featured">One Cikan Tur</label>
                                </div>
                                <small class="text-muted" data-t="MyTours.FeaturedHint">One cikan turlar ana sayfada gosterilir</small>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Cancel">Iptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveTour, enable: !isSaving()">
                        <span data-bind="visible: isSaving()" class="spinner-border spinner-border-sm me-1"></span>
                        <span data-t="Common.Save">Kaydet</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Onay Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <span data-t="MyTours.DeleteConfirm">Tur Silme</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p data-t="MyTours.DeleteMessage">Bu turu silmek istediginizden emin misiniz?</p>
                    <p class="fw-bold" data-bind="text: deletingTour() ? deletingTour().name : ''"></p>
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle me-2"></i>
                        <span data-t="MyTours.DeleteWarning">Bu islem geri alinamaz. Tura ait rezervasyonlar etkilenmez.</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Cancel">Iptal</button>
                    <button type="button" class="btn btn-danger" data-bind="click: deleteTour, enable: !isDeleting()">
                        <span data-bind="visible: isDeleting()" class="spinner-border spinner-border-sm me-1"></span>
                        <span data-t="Common.Delete">Sil</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Admin/MyTours.js"></script>
}
