@{
    Layout = "_AdminLayout";
}

<div id="adminReservationsApp">
    <div class="mb-4">
        <p class="text-muted mb-0">Rezervasyonlari yonetin ve takip edin</p>
    </div>

    <!-- Filters -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <select class="form-select" data-bind="value: filterStatus">
                        <option value="">Tum Durumlar</option>
                        <option value="0">Beklemede</option>
                        <option value="1">Onaylandi</option>
                        <option value="2">Iptal</option>
                        <option value="3">Tamamlandi</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" data-bind="value: filterPaymentStatus">
                        <option value="">Tum Odemeler</option>
                        <option value="0">Odeme Bekliyor</option>
                        <option value="1">On Odeme Yapildi</option>
                        <option value="2">Tam Odeme Yapildi</option>
                        <option value="3">Basarisiz</option>
                        <option value="4">Iade Edildi</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <select class="form-select" data-bind="options: tours, optionsText: 'name', optionsValue: 'id', value: filterTour, optionsCaption: 'Tum Turlar'"></select>
                </div>
            </div>
        </div>
    </div>

    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>#</th>
                            <th>Misafir</th>
                            <th>Tur</th>
                            <th>Tarih</th>
                            <th>Kisi</th>
                            <th>Toplam</th>
                            <th>Odeme</th>
                            <th>Durum</th>
                            <th>Islemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredReservations">
                        <tr>
                            <td data-bind="text: id"></td>
                            <td>
                                <div class="fw-semibold" data-bind="text: visitor ? visitor.firstName + ' ' + visitor.lastName : '-'"></div>
                                <small class="text-muted" data-bind="text: visitor ? visitor.email : ''"></small>
                            </td>
                            <td data-bind="text: tour ? tour.name : '-'"></td>
                            <td data-bind="text: new Date(startDate).toLocaleDateString('tr-TR')"></td>
                            <td data-bind="text: numberOfPeople"></td>
                            <td data-bind="text: totalPrice.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></td>
                            <td>
                                <span class="badge" data-bind="css: $parent.getPaymentBadge(paymentStatus), text: $parent.getPaymentText(paymentStatus)"></span>
                            </td>
                            <td>
                                <span class="badge" data-bind="css: $parent.getStatusBadge(status), text: $parent.getStatusText(status)"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <!-- ko if: status === 0 -->
                                    <button class="btn btn-success" data-bind="click: function() { $parent.updateStatus($data, 1); }" title="Onayla">
                                        <i class="bi bi-check"></i>
                                    </button>
                                    <button class="btn btn-danger" data-bind="click: function() { $parent.updateStatus($data, 2); }" title="Iptal">
                                        <i class="bi bi-x"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-outline-info" data-bind="click: $parent.showDetails" title="Detay">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Details Modal -->
    <div class="modal fade" id="detailsModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Rezervasyon Detayi</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedReservation">
                    <dl class="row">
                        <dt class="col-sm-4">Rezervasyon No</dt>
                        <dd class="col-sm-8" data-bind="text: '#' + id"></dd>
                        <dt class="col-sm-4">Misafir</dt>
                        <dd class="col-sm-8" data-bind="text: visitor ? visitor.firstName + ' ' + visitor.lastName : '-'"></dd>
                        <dt class="col-sm-4">Tur</dt>
                        <dd class="col-sm-8" data-bind="text: tour ? tour.name : '-'"></dd>
                        <dt class="col-sm-4">Tarih</dt>
                        <dd class="col-sm-8" data-bind="text: new Date(startDate).toLocaleDateString('tr-TR')"></dd>
                        <dt class="col-sm-4">Kisi Sayisi</dt>
                        <dd class="col-sm-8" data-bind="text: numberOfPeople"></dd>
                        <dt class="col-sm-4">Toplam Fiyat</dt>
                        <dd class="col-sm-8" data-bind="text: totalPrice.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></dd>
                        <dt class="col-sm-4">Notlar</dt>
                        <dd class="col-sm-8" data-bind="text: notes || '-'"></dd>
                    </dl>
                    <hr>
                    <h6 class="mb-3"><i class="bi bi-credit-card me-2"></i>Odeme Bilgileri</h6>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">Odeme Durumu</dt>
                        <dd class="col-sm-8">
                            <span class="badge" data-bind="css: $parent.getPaymentBadge(paymentStatus), text: $parent.getPaymentText(paymentStatus)"></span>
                        </dd>
                        <dt class="col-sm-4">On Odeme Tutari</dt>
                        <dd class="col-sm-8" data-bind="text: depositAmount ? depositAmount.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'}) : '-'"></dd>
                        <dt class="col-sm-4">Odenen Tutar</dt>
                        <dd class="col-sm-8">
                            <span class="text-success fw-bold" data-bind="text: paidAmount ? paidAmount.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'}) : '-'"></span>
                        </dd>
                        <dt class="col-sm-4">Kalan Tutar</dt>
                        <dd class="col-sm-8">
                            <span data-bind="css: { 'text-danger fw-bold': (totalPrice - (paidAmount || 0)) > 0 }, text: ((totalPrice - (paidAmount || 0)) > 0) ? (totalPrice - (paidAmount || 0)).toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'}) : 'Tamamlandi'"></span>
                        </dd>
                        <dt class="col-sm-4">Odeme ID</dt>
                        <dd class="col-sm-8" data-bind="text: paymentId || '-'"></dd>
                        <dt class="col-sm-4">Odeme Tarihi</dt>
                        <dd class="col-sm-8" data-bind="text: paidAt ? new Date(paidAt).toLocaleString('tr-TR') : '-'"></dd>
                    </dl>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Admin/Reservations.js"></script>
}
