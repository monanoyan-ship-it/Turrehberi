@{
    Layout = "_AdminLayout";
}

<div id="adminToursApp">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-muted mb-0">Turlari yonetin, duzenleyin ve yeni turlar ekleyin</p>
        </div>
        <button class="btn btn-primary" data-bind="click: openCreateModal">
            <i class="bi bi-plus-circle me-1"></i> Yeni Tur
        </button>
    </div>

    <!-- Filters -->
    <div class="admin-card mb-4">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-4">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Tur ara..." data-bind="value: searchTerm, valueUpdate: 'afterkeydown'" />
                    </div>
                </div>
                <div class="col-md-3">
                    <select class="form-select" data-bind="options: companies, optionsText: 'name', optionsValue: 'id', value: filterCompany, optionsCaption: 'Tum Firmalar'"></select>
                </div>
                <div class="col-md-2">
                    <select class="form-select" data-bind="value: filterFeatured">
                        <option value="">Tumu</option>
                        <option value="true">One Cikan</option>
                        <option value="false">Normal</option>
                    </select>
                </div>
            </div>
        </div>
    </div>

    <!-- Tours Table -->
    <div class="admin-card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Tur Adi</th>
                            <th>Firma</th>
                            <th>Destinasyon</th>
                            <th>Fiyat</th>
                            <th>Sure</th>
                            <th>Durum</th>
                            <th style="width: 150px;">Islemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: filteredTours">
                        <tr>
                            <td>
                                <!-- ko if: imageUrl -->
                                <img data-bind="attr: { src: imageUrl }" class="rounded" style="width: 50px; height: 35px; object-fit: cover;" />
                                <!-- /ko -->
                                <!-- ko ifnot: imageUrl -->
                                <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 35px;">
                                    <i class="bi bi-image text-muted"></i>
                                </div>
                                <!-- /ko -->
                            </td>
                            <td>
                                <div class="fw-semibold" data-bind="text: name"></div>
                                <!-- ko if: isFeatured -->
                                <span class="badge bg-warning text-dark"><i class="bi bi-star-fill"></i> One Cikan</span>
                                <!-- /ko -->
                            </td>
                            <td data-bind="text: company ? company.name : '-'"></td>
                            <td data-bind="text: destination"></td>
                            <td data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></td>
                            <td><span data-bind="text: durationDays"></span> gun</td>
                            <td>
                                <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? 'Aktif' : 'Pasif'"></span>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.openEditModal" title="Duzenle">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <button class="btn btn-outline-danger" data-bind="click: $parent.openDeleteModal" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
            <div data-bind="visible: filteredTours().length === 0" class="text-center text-muted py-5">
                <i class="bi bi-inbox fs-1"></i>
                <p class="mt-2">Tur bulunamadi</p>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" id="formModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: isEditing() ? 'Tur Duzenle' : 'Yeni Tur'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="tourForm">
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Firma *</label>
                                <select class="form-select" data-bind="options: companies, optionsText: 'name', optionsValue: 'id', value: formData().companyId, optionsCaption: '-- Firma Secin --'" required></select>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label class="form-label">Tur Adi *</label>
                                <input type="text" class="form-control" data-bind="value: formData().name" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Destinasyon *</label>
                            <input type="text" class="form-control" data-bind="value: formData().destination" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Aciklama</label>
                            <textarea class="form-control" rows="2" data-bind="value: formData().description"></textarea>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Fiyat (TL) *</label>
                                <input type="number" step="0.01" class="form-control" data-bind="value: formData().price" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Sure (Gun) *</label>
                                <input type="number" class="form-control" data-bind="value: formData().durationDays" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Kapasite</label>
                                <input type="number" class="form-control" data-bind="value: formData().maxCapacity" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Resim URL</label>
                            <input type="url" class="form-control" data-bind="value: formData().imageUrl" placeholder="https://..." />
                        </div>

                        <div class="row">
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="isFeatured" data-bind="checked: formData().isFeatured" />
                                    <label class="form-check-label" for="isFeatured">
                                        <i class="bi bi-star-fill text-warning"></i> One Cikan
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" id="isActive" data-bind="checked: formData().isActive" />
                                    <label class="form-check-label" for="isActive">Aktif</label>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveTour, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <span data-bind="text: isEditing() ? 'Guncelle' : 'Kaydet'"></span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Tur Sil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Bu turu silmek istediginizden emin misiniz?</p>
                    <div class="alert alert-light" data-bind="with: selectedTour">
                        <strong data-bind="text: name"></strong>
                        <br><small class="text-muted" data-bind="text: destination"></small>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-danger" data-bind="click: deleteTour, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Evet, Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Admin/Tours.js"></script>
}
