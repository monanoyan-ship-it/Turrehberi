@{
    ViewData["Title"] = "Blog";
}

<div id="blogDetailApp">
    <!-- Loading -->
    <div class="text-center py-5" data-bind="visible: isLoading">
        <div class="spinner-border text-primary" role="status"></div>
    </div>

    <!-- Not Found -->
    <div class="text-center py-5" data-bind="visible: !isLoading() && !post()">
        <i class="bi bi-journal-x text-muted" style="font-size: 3rem;"></i>
        <p class="text-muted mt-2">Yazi bulunamadi</p>
        <a href="/Blog" class="btn btn-primary">Blog'a Don</a>
    </div>

    <!-- Post Detail -->
    <div data-bind="if: post">
        <div data-bind="with: post">
            <!-- Breadcrumb -->
            <nav aria-label="breadcrumb" class="mb-3">
                <ol class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/" data-t="Menu.Home">Ana Sayfa</a></li>
                    <li class="breadcrumb-item"><a href="/Blog" data-t="Blog.Title">Blog</a></li>
                    <li class="breadcrumb-item active" data-bind="text: title"></li>
                </ol>
            </nav>

            <!-- Kategori & Tarih -->
            <div class="mb-3">
                <span class="badge" data-bind="css: $parent.getCategoryBadgeClass(categoryId), text: $parent.getCategoryName(categoryId)"></span>
                <span class="text-muted ms-2">
                    <i class="bi bi-calendar me-1"></i><span data-bind="text: $parent.formatDate(publishedAt)"></span>
                </span>
                <span class="text-muted ms-2">
                    <i class="bi bi-eye me-1"></i><span data-bind="text: viewCount"></span> goruntulenme
                </span>
            </div>

            <!-- Baslik -->
            <h1 class="mb-3" data-bind="text: title"></h1>

            <!-- Yazar Bilgisi -->
            <div class="d-flex align-items-center mb-4">
                <!-- ko if: authorAvatar -->
                <img class="rounded-circle me-2" style="width: 40px; height: 40px; object-fit: cover;"
                     data-bind="attr: { src: authorAvatar }" />
                <!-- /ko -->
                <!-- ko ifnot: authorAvatar -->
                <div class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center me-2"
                     style="width: 40px; height: 40px;">
                    <i class="bi bi-person"></i>
                </div>
                <!-- /ko -->
                <div>
                    <strong data-bind="text: authorName"></strong>
                    <!-- ko if: companyName -->
                    <br /><small class="text-muted">
                        <i class="bi bi-building me-1"></i>
                        <a data-bind="text: companyName, attr: { href: '/Companies/Details/' + companySlug }" class="text-decoration-none"></a>
                    </small>
                    <!-- /ko -->
                </div>
            </div>

            <!-- Kapak Gorseli -->
            <!-- ko if: imageUrl -->
            <img class="img-fluid rounded mb-4 w-100" style="max-height: 400px; object-fit: cover;"
                 data-bind="attr: { src: imageUrl, alt: title }" />
            <!-- /ko -->

            <!-- Ozet -->
            <p class="lead text-muted mb-4" data-bind="text: summary"></p>

            <!-- Icerik -->
            <div class="blog-content mb-4" data-bind="html: content"></div>

            <!-- Etiketler -->
            <!-- ko if: tags -->
            <div class="mb-4">
                <i class="bi bi-tags me-1"></i>
                <!-- ko foreach: tags.split(',') -->
                <span class="badge bg-light text-dark me-1" data-bind="text: $data.trim()"></span>
                <!-- /ko -->
            </div>
            <!-- /ko -->

            <!-- Paylasim -->
            <div class="border-top border-bottom py-3 mb-4">
                <strong class="me-2" data-t="Share.Title">Paylas:</strong>
                <div class="d-inline" id="shareButtons"></div>
            </div>
        </div>

        <!-- Yorumlar Bolumu -->
        <div class="mt-5">
            <h4>
                <i class="bi bi-chat-dots me-2"></i>
                <span data-t="Blog.Comments">Yorumlar</span>
                <span class="badge bg-secondary ms-1" data-bind="text: comments().length"></span>
            </h4>

            <!-- Yorum Formu -->
            <div class="card mb-4" data-bind="visible: isLoggedIn()">
                <div class="card-body">
                    <textarea class="form-control mb-2" rows="3" data-bind="value: newComment"
                              placeholder="Yorumunuzu yazin..." data-t-placeholder="Blog.AddComment"></textarea>
                    <button class="btn btn-primary btn-sm" data-bind="click: addComment, disable: isSaving() || !newComment()">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        <i class="bi bi-send me-1"></i> <span data-t="Blog.AddComment">Yorum Yap</span>
                    </button>
                </div>
            </div>

            <div class="alert alert-info" data-bind="visible: !isLoggedIn()">
                <i class="bi bi-info-circle me-1"></i>
                Yorum yapabilmek icin <a href="/Account/Login">giris yapin</a>.
            </div>

            <!-- Yorum Listesi -->
            <!-- ko foreach: comments -->
            <div class="card mb-3">
                <div class="card-body">
                    <div class="d-flex justify-content-between">
                        <div class="d-flex align-items-center mb-2">
                            <!-- ko if: visitorAvatar -->
                            <img class="rounded-circle me-2" style="width: 32px; height: 32px; object-fit: cover;"
                                 data-bind="attr: { src: visitorAvatar }" />
                            <!-- /ko -->
                            <!-- ko ifnot: visitorAvatar -->
                            <div class="rounded-circle bg-secondary text-white d-flex align-items-center justify-content-center me-2"
                                 style="width: 32px; height: 32px; font-size: 0.8rem;">
                                <i class="bi bi-person"></i>
                            </div>
                            <!-- /ko -->
                            <div>
                                <strong data-bind="text: visitorName"></strong>
                                <small class="text-muted ms-2" data-bind="text: $parent.formatDate(createdAt)"></small>
                            </div>
                        </div>
                        <div>
                            <!-- ko if: $parent.canDeleteComment(visitorId) -->
                            <button class="btn btn-sm btn-outline-danger" data-bind="click: function() { $parent.deleteComment(id); }">
                                <i class="bi bi-trash"></i>
                            </button>
                            <!-- /ko -->
                        </div>
                    </div>
                    <p class="mb-2" data-bind="text: content"></p>

                    <!-- Yanitlar -->
                    <!-- ko if: replies && replies.length > 0 -->
                    <div class="ms-4 mt-3">
                        <!-- ko foreach: replies -->
                        <div class="border-start ps-3 mb-2">
                            <div class="d-flex align-items-center mb-1">
                                <strong class="me-2" data-bind="text: visitorName"></strong>
                                <small class="text-muted" data-bind="text: $parents[1].formatDate(createdAt)"></small>
                            </div>
                            <p class="mb-0 small" data-bind="text: content"></p>
                        </div>
                        <!-- /ko -->
                    </div>
                    <!-- /ko -->

                    <!-- Yanit Formu -->
                    <div class="mt-2" data-bind="visible: $parent.isLoggedIn()">
                        <a href="#" class="small text-decoration-none" data-bind="click: function() { $parent.toggleReply(id); }">
                            <i class="bi bi-reply me-1"></i><span data-t="Blog.Reply">Yanit Ver</span>
                        </a>
                        <!-- ko if: $parent.replyingTo() === id -->
                        <div class="mt-2">
                            <textarea class="form-control form-control-sm mb-2" rows="2" data-bind="value: $parent.replyContent"
                                      placeholder="Yanitinizi yazin..."></textarea>
                            <button class="btn btn-sm btn-primary" data-bind="click: function() { $parent.addReply(id); }, disable: $parent.isSaving() || !$parent.replyContent()">
                                <span data-t="Blog.Reply">Yanit</span>
                            </button>
                            <button class="btn btn-sm btn-secondary ms-1" data-bind="click: function() { $parent.replyingTo(null); }">
                                <span data-t="Common.Cancel">Iptal</span>
                            </button>
                        </div>
                        <!-- /ko -->
                    </div>
                </div>
            </div>
            <!-- /ko -->

            <div class="text-center py-3" data-bind="visible: comments().length === 0">
                <p class="text-muted">Henuz yorum yapilmamis. Ilk yorumu siz yapin!</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    var blogSlug = '@Html.Raw(ViewBag.Slug)';
</script>
<script src="~/js/Blog/Detail.js"></script>
}
