@{
    ViewData["Title"] = "Firmalar";
}

<div id="companiesApp">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-building"></i> Firmalar</h1>
    <button class="btn btn-primary" data-bind="click: openCreateModal">
        <i class="bi bi-plus-circle"></i> Yeni Firma
    </button>
</div>

<!-- Loading -->
<div data-bind="visible: isLoading" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Yukleniyor...</span>
    </div>
</div>

<!-- Liste -->
<div class="row g-4" data-bind="visible: !isLoading(), foreach: companies">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-body">
                <div class="d-flex align-items-center mb-3">
                    <div class="bg-primary text-white rounded d-flex align-items-center justify-content-center me-3" style="width: 60px; height: 60px;">
                        <i class="bi bi-building" style="font-size: 1.5rem;"></i>
                    </div>
                    <div>
                        <h5 class="card-title mb-0" data-bind="text: name"></h5>
                        <small class="text-muted" data-bind="text: email"></small>
                    </div>
                </div>
                <p class="card-text" data-bind="text: description"></p>
                <div class="mb-2">
                    <i class="bi bi-telephone"></i> <span data-bind="text: phone"></span>
                </div>
                <div class="mb-2" data-bind="visible: website">
                    <i class="bi bi-globe"></i> <span data-bind="text: website"></span>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <div class="btn-group w-100">
                    <button class="btn btn-outline-info" data-bind="click: $parent.showDetails">
                        <i class="bi bi-eye"></i> Detay
                    </button>
                    <button class="btn btn-outline-warning" data-bind="click: $parent.openEditModal">
                        <i class="bi bi-pencil"></i> Duzenle
                    </button>
                    <button class="btn btn-outline-danger" data-bind="click: $parent.openDeleteModal">
                        <i class="bi bi-trash"></i> Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bos Liste -->
<div data-bind="visible: !isLoading() && companies().length === 0" class="alert alert-info text-center">
    <i class="bi bi-info-circle"></i> Henuz firma bulunmamaktadir.
    <a href="#" data-bind="click: openCreateModal" class="alert-link">Ilk firmayi ekleyin</a>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="formModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-bind="text: isEditing() ? 'Firma Duzenle' : 'Yeni Firma'"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="companyForm">
                    <input type="hidden" data-bind="value: formData().id" />

                    <div class="mb-3">
                        <label class="form-label">Firma Adi *</label>
                        <input type="text" class="form-control" data-bind="value: formData().name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Aciklama</label>
                        <textarea class="form-control" rows="2" data-bind="value: formData().description"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">E-posta *</label>
                            <input type="email" class="form-control" data-bind="value: formData().email" required />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Telefon</label>
                            <input type="tel" class="form-control" data-bind="value: formData().phone" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Adres</label>
                        <textarea class="form-control" rows="2" data-bind="value: formData().address"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Website</label>
                            <input type="url" class="form-control" data-bind="value: formData().website" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Vergi No</label>
                            <input type="text" class="form-control" data-bind="value: formData().taxNumber" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Logo URL</label>
                        <input type="url" class="form-control" data-bind="value: formData().logoUrl" />
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-primary" data-bind="click: saveCompany, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    <span data-bind="text: isEditing() ? 'Guncelle' : 'Kaydet'"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Firma Detayi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: selectedCompany">
                <dl class="row">
                    <dt class="col-sm-4">Firma Adi</dt>
                    <dd class="col-sm-8" data-bind="text: name"></dd>

                    <dt class="col-sm-4">Aciklama</dt>
                    <dd class="col-sm-8" data-bind="text: description || '-'"></dd>

                    <dt class="col-sm-4">E-posta</dt>
                    <dd class="col-sm-8" data-bind="text: email"></dd>

                    <dt class="col-sm-4">Telefon</dt>
                    <dd class="col-sm-8" data-bind="text: phone || '-'"></dd>

                    <dt class="col-sm-4">Adres</dt>
                    <dd class="col-sm-8" data-bind="text: address || '-'"></dd>

                    <dt class="col-sm-4">Website</dt>
                    <dd class="col-sm-8" data-bind="text: website || '-'"></dd>

                    <dt class="col-sm-4">Vergi No</dt>
                    <dd class="col-sm-8" data-bind="text: taxNumber || '-'"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger">Firma Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Dikkat!</strong> Bu firmayi silmek istediginizden emin misiniz?
                </div>
                <p data-bind="with: selectedCompany">
                    <strong data-bind="text: name"></strong> firmasini silmek uzeresiniz.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-danger" data-bind="click: deleteCompany, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    Evet, Sil
                </button>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script>
function CompaniesViewModel() {
    var self = this;

    self.companies = ko.observableArray([]);
    self.isLoading = ko.observable(true);
    self.isSaving = ko.observable(false);
    self.isEditing = ko.observable(false);
    self.selectedCompany = ko.observable(null);

    self.formData = ko.observable({
        id: 0,
        name: '',
        description: '',
        email: '',
        phone: '',
        address: '',
        website: '',
        logoUrl: '',
        taxNumber: ''
    });

    // Modal instances
    var formModal, detailsModal, deleteModal;

    // Load companies
    self.loadCompanies = function() {
        self.isLoading(true);
        $.ajax({
            url: apiBaseUrl + '/api/companies',
            method: 'GET',
            success: function(data) {
                self.companies(data);
                self.isLoading(false);
            },
            error: function() {
                toastr.error('Firmalar yuklenirken hata olustu');
                self.isLoading(false);
            }
        });
    };

    // Open create modal
    self.openCreateModal = function() {
        self.isEditing(false);
        self.formData({
            id: 0,
            name: '',
            description: '',
            email: '',
            phone: '',
            address: '',
            website: '',
            logoUrl: '',
            taxNumber: ''
        });
        formModal.show();
    };

    // Open edit modal
    self.openEditModal = function(company) {
        self.isEditing(true);
        self.formData({
            id: company.id,
            name: company.name,
            description: company.description,
            email: company.email,
            phone: company.phone,
            address: company.address,
            website: company.website,
            logoUrl: company.logoUrl,
            taxNumber: company.taxNumber,
            createdAt: company.createdAt,
            isActive: company.isActive
        });
        formModal.show();
    };

    // Show details
    self.showDetails = function(company) {
        self.selectedCompany(company);
        detailsModal.show();
    };

    // Open delete modal
    self.openDeleteModal = function(company) {
        self.selectedCompany(company);
        deleteModal.show();
    };

    // Save company
    self.saveCompany = function() {
        var form = document.getElementById('companyForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        self.isSaving(true);
        var data = self.formData();
        var isEdit = self.isEditing();

        $.ajax({
            url: apiBaseUrl + '/api/companies' + (isEdit ? '/' + data.id : ''),
            method: isEdit ? 'PUT' : 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function() {
                formModal.hide();
                self.loadCompanies();
                toastr.success(isEdit ? 'Firma guncellendi' : 'Firma eklendi');
                self.isSaving(false);
            },
            error: function() {
                toastr.error('Islem sirasinda hata olustu');
                self.isSaving(false);
            }
        });
    };

    // Delete company
    self.deleteCompany = function() {
        self.isSaving(true);
        var company = self.selectedCompany();

        $.ajax({
            url: apiBaseUrl + '/api/companies/' + company.id,
            method: 'DELETE',
            success: function() {
                deleteModal.hide();
                self.loadCompanies();
                toastr.success('Firma silindi');
                self.isSaving(false);
            },
            error: function() {
                toastr.error('Silme sirasinda hata olustu');
                self.isSaving(false);
            }
        });
    };

    // Initialize
    $(document).ready(function() {
        formModal = new bootstrap.Modal(document.getElementById('formModal'));
        detailsModal = new bootstrap.Modal(document.getElementById('detailsModal'));
        deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        self.loadCompanies();
    });
}

ko.applyBindings(new CompaniesViewModel(), document.getElementById('companiesApp'));
</script>
}
