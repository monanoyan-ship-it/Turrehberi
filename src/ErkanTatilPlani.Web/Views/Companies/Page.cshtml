@{
    Layout = "_Layout";
    ViewData["Title"] = "Firma Sayfasi";
    var companySlug = ViewBag.CompanySlug as string;
    var pageSlug = ViewBag.PageSlug as string;
}

<div id="companyPageApp">
    <!-- Loading State -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status"></div>
        <p class="mt-2 text-muted">Yukleniyor...</p>
    </div>

    <!-- Error State -->
    <div data-bind="visible: !isLoading() && !page()" class="text-center py-5">
        <i class="bi bi-exclamation-triangle-fill text-muted" style="font-size: 3rem;"></i>
        <h4 class="mt-3">Sayfa Bulunamadi</h4>
        <a data-bind="attr: { href: '/' + companySlug }" class="btn btn-primary mt-2">Firma Profiline Don</a>
    </div>

    <!-- Page Content -->
    <div data-bind="visible: !isLoading() && page()">
        <!-- Firma Header -->
        <div class="bg-light rounded-3 p-3 mb-4">
            <div class="d-flex align-items-center">
                <!-- ko if: page() && page().companyLogo -->
                <img data-bind="attr: { src: page().companyLogo }" class="rounded-circle me-3" style="width: 48px; height: 48px; object-fit: cover;" />
                <!-- /ko -->
                <div>
                    <h6 class="mb-0">
                        <a data-bind="text: page() ? page().companyName : '', attr: { href: '/' + companySlug }" class="text-decoration-none"></a>
                    </h6>
                </div>
            </div>
        </div>

        <div class="row">
            <!-- Sidebar: Diger Sayfalar -->
            <div class="col-md-3">
                <div class="card mb-4">
                    <div class="card-header">
                        <h6 class="mb-0"><i class="bi bi-list me-1"></i> Sayfalar</h6>
                    </div>
                    <div class="list-group list-group-flush" data-bind="foreach: pages">
                        <a class="list-group-item list-group-item-action" data-bind="attr: { href: '/' + $parent.companySlug + '/page/' + slug }, css: { active: slug === $parent.pageSlug }">
                            <i data-bind="attr: { 'class': 'bi bi-' + (icon || 'file-text') + ' me-2' }"></i>
                            <span data-bind="text: title"></span>
                        </a>
                    </div>
                    <div class="card-footer">
                        <a data-bind="attr: { href: '/' + companySlug + '/blog' }" class="text-decoration-none">
                            <i class="bi bi-journal-text me-1"></i> Blog Yazilari
                        </a>
                    </div>
                </div>
            </div>

            <!-- Main Content -->
            <div class="col-md-9">
                <h2 data-bind="text: page() ? page().title : ''"></h2>
                <hr />
                <div data-bind="html: page() ? page().content : ''"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Companies/Page.js"></script>
}
