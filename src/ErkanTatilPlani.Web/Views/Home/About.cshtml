@{
    ViewData["Title"] = "Hakkimizda";
}

<div class="container py-5">
    <!-- Hero -->
    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold text-primary">
            <i class="bi bi-airplane-engines me-2"></i>
            <span data-t="About.Title">Hakkimizda</span>
        </h1>
        <p class="lead text-muted" data-t="About.Subtitle">Turkiye'nin en guvenilir tur rezervasyon platformu</p>
    </div>

    <!-- Mission -->
    <div class="row g-5 mb-5 align-items-center">
        <div class="col-lg-6">
            <h2 class="fw-bold mb-3">
                <i class="bi bi-bullseye text-primary me-2"></i>
                <span data-t="About.Mission">Misyonumuz</span>
            </h2>
            <p class="text-muted fs-5" data-t="About.MissionText">
                Erkan Tatil Plani olarak, seyahatseverleri Turkiye'nin en iyi tur firmalariyla bulusturuyoruz.
                Amacimiz, herkesin hayalindeki tatile kolayca ulasabilmesini saglamaktir.
            </p>
        </div>
        <div class="col-lg-6">
            <div class="bg-light rounded-4 p-5 text-center">
                <i class="bi bi-globe-americas text-primary" style="font-size: 5rem;"></i>
            </div>
        </div>
    </div>

    <!-- Features -->
    <div class="row g-4 mb-5">
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center">
                <div class="card-body py-5">
                    <div class="bg-primary bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-shield-check text-primary fs-1"></i>
                    </div>
                    <h5 class="fw-bold" data-t="About.Feature1Title">Guvenli Odeme</h5>
                    <p class="text-muted" data-t="About.Feature1Text">iyzico altyapisiyla guvenli online odeme imkani sunuyoruz.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center">
                <div class="card-body py-5">
                    <div class="bg-success bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-building text-success fs-1"></i>
                    </div>
                    <h5 class="fw-bold" data-t="About.Feature2Title">Onaylı Firmalar</h5>
                    <p class="text-muted" data-t="About.Feature2Text">Tum tur firmalari detayli inceleme surecinden gecerek onaylanir.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card h-100 border-0 shadow-sm text-center">
                <div class="card-body py-5">
                    <div class="bg-warning bg-opacity-10 rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width: 80px; height: 80px;">
                        <i class="bi bi-star text-warning fs-1"></i>
                    </div>
                    <h5 class="fw-bold" data-t="About.Feature3Title">Gercek Yorumlar</h5>
                    <p class="text-muted" data-t="About.Feature3Text">Tur katilimcilarinin gercek deneyimlerine dayanan degerlendirmeler.</p>
                </div>
            </div>
        </div>
    </div>

    <!-- CTA -->
    <div class="text-center bg-primary text-white rounded-4 p-5">
        <h3 class="fw-bold mb-3" data-t="About.CTATitle">Hayalinizdeki Tatile Baslayın</h3>
        <p class="mb-4 opacity-75" data-t="About.CTAText">Yuzlerce tur arasından size en uygun olani secin.</p>
        <a href="/Tours" class="btn btn-light btn-lg px-5">
            <i class="bi bi-search me-2"></i>
            <span data-t="About.CTAButton">Turlari Kesfet</span>
        </a>
    </div>
</div>
