@{
    ViewData["Title"] = "Ana Sayfa";
    ViewData["Description"] = "Erkan Tatil Plani - Turkiye'nin en guvenilir tur rezervasyon sistemi. En iyi firmalarin en uygun turlarini kesfedin, hayalinizdeki tatile kavusun!";
    ViewData["OgTitle"] = "Erkan Tatil Plani - Tur Rezervasyon Sistemi";
    ViewData["OgDescription"] = "Turkiye ve yurt disi turlari icin en uygun fiyatlar. One cikan turlari kesfedin ve hayalinizdeki tatile basvurun!";
    ViewData["OgType"] = "website";
}

@section Head {
    <!-- Home Page Schema.org JSON-LD -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "WebSite",
        "name": "Erkan Tatil Plani",
        "url": "@Context.Request.GetDisplayUrl()",
        "description": "Turkiye'nin en guvenilir tur rezervasyon sistemi",
        "potentialAction": {
            "@@type": "SearchAction",
            "target": "@($"{Context.Request.Scheme}://{Context.Request.Host}")/Tours?search={search_term_string}",
            "query-input": "required name=search_term_string"
        }
    }
    </script>
}

<div id="homeApp">

<!-- Hero Section with Carousel -->
<div class="mb-5">
    <div id="featuredCarousel" class="carousel slide" data-bs-ride="carousel">
        <div class="carousel-indicators" data-bind="foreach: featuredTours">
            <button type="button" data-bs-target="#featuredCarousel" data-bind="attr: { 'data-bs-slide-to': $index() }, css: { 'active': $index() === 0 }"></button>
        </div>
        <div class="carousel-inner rounded-4 shadow-lg" style="max-height: 500px;">
            <!-- ko foreach: featuredTours -->
            <div class="carousel-item" data-bind="css: { 'active': $index() === 0 }">
                <div class="position-relative" style="height: 500px;">
                    <!-- ko if: imageUrl -->
                    <img data-bind="attr: { src: imageUrl, alt: name }" class="d-block w-100 h-100" style="object-fit: cover;">
                    <!-- /ko -->
                    <!-- ko ifnot: imageUrl -->
                    <div class="d-flex align-items-center justify-content-center bg-gradient w-100 h-100" style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);">
                        <i class="bi bi-image text-white" style="font-size: 8rem; opacity: 0.3;"></i>
                    </div>
                    <!-- /ko -->
                    <div class="carousel-caption d-block" style="background: linear-gradient(transparent, rgba(0,0,0,0.8)); bottom: 0; left: 0; right: 0; padding: 40px 20px 30px;">
                        <h2 class="fw-bold mb-2" data-bind="text: name"></h2>
                        <p class="mb-2">
                            <i class="bi bi-geo-alt-fill"></i> <span data-bind="text: destination"></span>
                            <span class="mx-2">|</span>
                            <i class="bi bi-building"></i> <span data-bind="text: company ? company.name : ''"></span>
                        </p>
                        <p class="mb-3" data-bind="text: description"></p>
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            <span class="badge bg-warning text-dark fs-4 px-4 py-2" data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span>
                            <span class="text-white"><i class="bi bi-calendar3"></i> <span data-bind="text: durationDays"></span> <span data-t="Home.Day">Gün</span></span>
                        </div>
                        <div class="mt-3">
                            <a class="btn btn-light btn-lg" data-bind="attr: { href: '/Tours/Details/' + id }">
                                <i class="bi bi-eye me-1"></i> <span data-t="Home.ViewTour">İncele</span>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
            <!-- /ko -->
        </div>
        <button class="carousel-control-prev" type="button" data-bs-target="#featuredCarousel" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>
        <button class="carousel-control-next" type="button" data-bs-target="#featuredCarousel" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>
    </div>
</div>

<!-- Loading for Carousel -->
<div data-bind="visible: isLoading" class="text-center py-5 mb-5">
    <div class="spinner-border text-primary" role="status" style="width: 3rem; height: 3rem;">
        <span class="visually-hidden">Yukleniyor...</span>
    </div>
    <p class="mt-3 text-muted">Turlar yukleniyor...</p>
</div>

<!-- Empty Featured Tours Message -->
<div data-bind="visible: !isLoading() && featuredTours().length === 0" class="alert alert-info text-center mb-5">
    <i class="bi bi-info-circle"></i> Henuz one cikan tur bulunmamaktadir.
</div>

<!-- Welcome Section -->
<div class="text-center mb-5">
    <h1 class="display-4 fw-bold text-primary">
        <i class="bi bi-airplane-engines"></i> Erkan Tatil Plani
    </h1>
    <p class="lead text-muted">Tur Kiralama Sistemi - Serbest Katilimli Turlar</p>
    <p class="text-secondary">En iyi firmalarin en uygun turlarini kesfet, hayallerindeki tatile kavus!</p>
</div>

<!-- Featured Tours Grid -->
<div data-bind="visible: !isLoading() && featuredTours().length > 0" class="mb-5">
    <h3 class="text-center mb-4"><i class="bi bi-star-fill text-warning"></i> One Cikan Turlar</h3>
    <div class="row g-4" data-bind="foreach: featuredTours">
        <div class="col-md-4">
            <a class="text-decoration-none" data-bind="attr: { href: '/Tours/Details/' + id }">
                <div class="card h-100 shadow-sm border-0 tour-card">
                    <div class="position-relative lazy-img-container" style="height: 200px; overflow: hidden;">
                        <!-- ko if: imageUrl -->
                        <img data-bind="attr: { src: imageUrl, alt: name }"
                             class="w-100 h-100 card-img-lazy"
                             style="object-fit: cover;"
                             loading="lazy"
                             decoding="async" />
                        <!-- /ko -->
                        <!-- ko ifnot: imageUrl -->
                        <div class="d-flex align-items-center justify-content-center bg-secondary w-100 h-100">
                            <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                        </div>
                        <!-- /ko -->
                        <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2">
                            <i class="bi bi-star-fill"></i> <span data-t="Home.Featured">Öne Çıkan</span>
                        </span>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title fw-bold text-dark" data-bind="text: name"></h5>
                        <p class="card-text text-muted mb-2">
                            <i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span>
                        </p>
                        <p class="card-text text-muted mb-2" data-bind="visible: company">
                            <i class="bi bi-building"></i> <span data-bind="text: company ? company.name : ''"></span>
                        </p>
                        <p class="card-text small text-secondary" data-bind="text: description"></p>
                    </div>
                    <div class="card-footer bg-transparent border-0">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="badge bg-success fs-6 px-3 py-2" data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span>
                            <span class="text-muted"><i class="bi bi-calendar3"></i> <span data-bind="text: durationDays"></span> <span data-t="Home.Day">Gün</span></span>
                        </div>
                        <div class="btn btn-primary w-100">
                            <i class="bi bi-eye me-1"></i> <span data-t="Home.ViewDetails">İncele ve Rezervasyon Yap</span>
                        </div>
                    </div>
                </div>
            </a>
        </div>
    </div>
    <div class="text-center mt-4">
        <a href="/Tours" class="btn btn-outline-primary btn-lg">
            <i class="bi bi-grid me-1"></i> <span data-t="Home.ViewAllTours">Tüm Turları Görüntüle</span>
        </a>
    </div>
</div>

<!-- Quick Links Section -->
<div class="row g-4 mb-5">
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0 text-center hover-card">
            <div class="card-body py-4">
                <div class="icon-circle bg-primary text-white mx-auto mb-3">
                    <i class="bi bi-building fs-2"></i>
                </div>
                <h5 class="card-title">Firmalar</h5>
                <p class="card-text text-muted small">Tur saglayici firmalari yonetin.</p>
                <a asp-controller="Companies" asp-action="Index" class="btn btn-outline-primary">Firmalari Goruntule</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0 text-center hover-card">
            <div class="card-body py-4">
                <div class="icon-circle bg-info text-white mx-auto mb-3">
                    <i class="bi bi-geo-alt fs-2"></i>
                </div>
                <h5 class="card-title">Turlar</h5>
                <p class="card-text text-muted small">Mevcut turlari goruntuleyin ve yonetin.</p>
                <a asp-controller="Tours" asp-action="Index" class="btn btn-outline-info">Turlari Goruntule</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0 text-center hover-card">
            <div class="card-body py-4">
                <div class="icon-circle bg-warning text-dark mx-auto mb-3">
                    <i class="bi bi-people fs-2"></i>
                </div>
                <h5 class="card-title">Ziyaretciler</h5>
                <p class="card-text text-muted small">Ziyaretci bilgilerini goruntuleyin.</p>
                <a asp-controller="Visitors" asp-action="Index" class="btn btn-outline-warning">Ziyaretciler</a>
            </div>
        </div>
    </div>
    <div class="col-md-3">
        <div class="card h-100 shadow-sm border-0 text-center hover-card">
            <div class="card-body py-4">
                <div class="icon-circle bg-success text-white mx-auto mb-3">
                    <i class="bi bi-calendar-check fs-2"></i>
                </div>
                <h5 class="card-title">Rezervasyonlar</h5>
                <p class="card-text text-muted small">Online sozlesmeli rezervasyonlari yonetin.</p>
                <a asp-controller="Reservations" asp-action="Index" class="btn btn-outline-success">Rezervasyonlar</a>
            </div>
        </div>
    </div>
</div>

<!-- Stats Section -->
<div class="row g-4 text-center mb-5" data-bind="visible: !isLoading()">
    <div class="col-md-4">
        <div class="p-4 bg-light rounded-4">
            <h2 class="display-5 fw-bold text-primary" data-bind="text: stats().tours">0</h2>
            <p class="text-muted mb-0">Aktif Tur</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 bg-light rounded-4">
            <h2 class="display-5 fw-bold text-success" data-bind="text: stats().companies">0</h2>
            <p class="text-muted mb-0">Firma</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="p-4 bg-light rounded-4">
            <h2 class="display-5 fw-bold text-warning" data-bind="text: stats().visitors">0</h2>
            <p class="text-muted mb-0">Ziyaretci</p>
        </div>
    </div>
</div>

</div>

<style>
    .icon-circle {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }
    .hover-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .hover-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    }
    .tour-card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        cursor: pointer;
    }
    .tour-card:hover {
        transform: scale(1.02);
        box-shadow: 0 10px 30px rgba(0,0,0,0.15) !important;
    }
    .carousel-caption {
        text-shadow: 2px 2px 4px rgba(0,0,0,0.5);
    }
</style>

@section Scripts {
<script src="~/js/Home/Index.js" asp-append-version="true"></script>
}
