@{
    ViewData["Title"] = "Gizlilik Politikasi";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary" data-t="Legal.PrivacyTitle">Gizlilik Politikasi</h1>
        <p class="lead text-muted" data-t="Legal.PrivacySubtitle">Kisisel verilerinizin nasil korundugunu ogrenin.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="bg-white rounded-3 shadow-sm p-4 mb-3">
                <h2 class="h5" data-t="Legal.PrivacyDataTitle">Toplanan Bilgiler</h2>
                <p class="mb-0 text-muted" data-t="Legal.PrivacyDataText">Rezervasyon, hesap yonetimi ve destek talepleri icin gerekli bilgileri toplariz.</p>
            </div>
            <div class="bg-white rounded-3 shadow-sm p-4 mb-3">
                <h2 class="h5" data-t="Legal.PrivacyUseTitle">Kullanim Amaci</h2>
                <p class="mb-0 text-muted" data-t="Legal.PrivacyUseText">Bilgileriniz hizmet sunumu, guvenlik, bildirim ve yasal yukumlulukler icin kullanilir.</p>
            </div>
            <div class="bg-white rounded-3 shadow-sm p-4">
                <h2 class="h5" data-t="Legal.PrivacyContactTitle">Iletisim</h2>
                <p class="mb-0 text-muted" data-t="Legal.PrivacyContactText">Gizlilik talepleriniz icin iletisim sayfasindan bize ulasabilirsiniz.</p>
            </div>
        </div>
    </div>
</div>
