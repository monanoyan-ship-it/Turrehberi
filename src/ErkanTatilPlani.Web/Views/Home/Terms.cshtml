@{
    ViewData["Title"] = "Kullanim Kosullari";
}

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-5 fw-bold text-primary" data-t="Legal.TermsTitle">Kullanim Kosullari</h1>
        <p class="lead text-muted" data-t="Legal.TermsSubtitle">Platformu kullanirken kabul ettiginiz temel kosullar.</p>
    </div>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="bg-white rounded-3 shadow-sm p-4 mb-3">
                <h2 class="h5" data-t="Legal.TermsBookingTitle">Rezervasyonlar</h2>
                <p class="mb-0 text-muted" data-t="Legal.TermsBookingText">Rezervasyon bilgileri dogru girilmeli, odeme ve iptal kosullari tur detayinda belirtilen kurallara gore uygulanir.</p>
            </div>
            <div class="bg-white rounded-3 shadow-sm p-4 mb-3">
                <h2 class="h5" data-t="Legal.TermsCompanyTitle">Firma Sorumlulugu</h2>
                <p class="mb-0 text-muted" data-t="Legal.TermsCompanyText">Tur firmalari yayinladiklari icerik, fiyat, program ve hizmet kalitesinden sorumludur.</p>
            </div>
            <div class="bg-white rounded-3 shadow-sm p-4">
                <h2 class="h5" data-t="Legal.TermsSupportTitle">Destek</h2>
                <p class="mb-0 text-muted" data-t="Legal.TermsSupportText">Sorulariniz ve itirazlariniz icin iletisim kanallarimizdan destek alabilirsiniz.</p>
            </div>
        </div>
    </div>
</div>
