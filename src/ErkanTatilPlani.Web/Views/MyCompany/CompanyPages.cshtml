@{
    Layout = "_CompanyLayout";
}

<div id="companyPagesApp">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <small class="text-muted" data-bind="text: pages().length + ' sayfa'"></small>
        </div>
        <button class="btn btn-primary" data-bind="click: openCreateModal">
            <i class="bi bi-plus-circle me-1"></i> Yeni Sayfa
        </button>
    </div>

    <!-- Tablo -->
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 50px;">Sira</th>
                            <th>Baslik</th>
                            <th>Slug</th>
                            <th>Icon</th>
                            <th>Durum</th>
                            <th>Tarih</th>
                            <th style="width: 150px;">Islemler</th>
                        </tr>
                    </thead>
                    <tbody data-bind="foreach: pages">
                        <tr>
                            <td>
                                <span class="badge bg-light text-dark" data-bind="text: displayOrder"></span>
                            </td>
                            <td>
                                <div class="fw-semibold" data-bind="text: title"></div>
                            </td>
                            <td>
                                <small class="text-muted" data-bind="text: slug"></small>
                            </td>
                            <td>
                                <i data-bind="attr: { 'class': 'bi bi-' + (icon || 'file-text') }"></i>
                            </td>
                            <td>
                                <!-- ko if: isPublished -->
                                <span class="badge bg-success">Yayinda</span>
                                <!-- /ko -->
                                <!-- ko ifnot: isPublished -->
                                <span class="badge bg-secondary">Taslak</span>
                                <!-- /ko -->
                            </td>
                            <td>
                                <small data-bind="text: $parent.formatDate(updatedAt || createdAt)"></small>
                            </td>
                            <td>
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-outline-primary" data-bind="click: $parent.openEditModal" title="Duzenle">
                                        <i class="bi bi-pencil"></i>
                                    </button>
                                    <!-- ko if: $index() > 0 -->
                                    <button class="btn btn-outline-secondary" data-bind="click: function() { $parent.moveUp($data); }" title="Yukari">
                                        <i class="bi bi-arrow-up"></i>
                                    </button>
                                    <!-- /ko -->
                                    <!-- ko if: $index() < $parent.pages().length - 1 -->
                                    <button class="btn btn-outline-secondary" data-bind="click: function() { $parent.moveDown($data); }" title="Asagi">
                                        <i class="bi bi-arrow-down"></i>
                                    </button>
                                    <!-- /ko -->
                                    <button class="btn btn-outline-danger" data-bind="click: $parent.openDeleteModal" title="Sil">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="text-center py-5" data-bind="visible: !isLoading() && pages().length === 0">
                <i class="bi bi-file-earmark-plus text-muted" style="font-size: 3rem;"></i>
                <p class="text-muted mt-2">Henuz sayfa olusturulmamis</p>
            </div>
        </div>
    </div>

    <!-- Create/Edit Modal -->
    <div class="modal fade" id="formModal" tabindex="-1">
        <div class="modal-dialog modal-xl">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" data-bind="text: isEditing() ? 'Sayfa Duzenle' : 'Yeni Sayfa'"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="pageForm">
                        <div class="row">
                            <div class="col-md-8 mb-3">
                                <label class="form-label">Sayfa Basligi *</label>
                                <input type="text" class="form-control" data-bind="value: formData().title" required />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Icon (Bootstrap Icons)</label>
                                <div class="input-group">
                                    <span class="input-group-text"><i data-bind="attr: { 'class': 'bi bi-' + (formData().icon || 'file-text') }"></i></span>
                                    <input type="text" class="form-control" data-bind="value: formData().icon" placeholder="file-text" />
                                </div>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Icerik *</label>
                            <textarea class="form-control" id="contentEditor" rows="10" data-bind="value: formData().content"></textarea>
                        </div>
                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Durum</label>
                                <select class="form-select" data-bind="value: formData().isPublished">
                                    <option value="false">Taslak</option>
                                    <option value="true">Yayinda</option>
                                </select>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Meta Baslik</label>
                                <input type="text" class="form-control" data-bind="value: formData().metaTitle" />
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">Meta Aciklama</label>
                                <input type="text" class="form-control" data-bind="value: formData().metaDescription" />
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: savePage, disable: isSaving">
                        <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                        Kaydet
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Delete Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">Sayfa Sil</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p>Bu sayfayi silmek istediginizden emin misiniz?</p>
                    <p class="fw-semibold" data-bind="text: selectedPage() ? selectedPage().title : ''"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                    <button type="button" class="btn btn-danger" data-bind="click: deletePage, disable: isSaving">Evet, Sil</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
<link rel="stylesheet" href="~/lib/summernote/summernote-bs5.min.css" />
}

@section Scripts {
<script src="~/lib/summernote/summernote-bs5.min.js"></script>
<script src="~/js/MyCompany/CompanyPages.js"></script>
}
