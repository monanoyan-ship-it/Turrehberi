@{
    Layout = "_CompanyLayout";
}

<div id="guidesApp">
    <!-- Yukleniyor -->
    <div data-bind="visible: isLoading()" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
    </div>

    <!-- Ana Icerik -->
    <div data-bind="visible: !isLoading()">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <span class="text-muted" data-bind="visible: guides().length > 0">
                <span data-bind="text: guides().length"></span> <span data-t="Guide.GuideCount">rehber</span>
            </span>
            <button class="btn btn-primary" data-bind="click: openAddModal">
                <i class="bi bi-plus me-1"></i><span data-t="Guide.Add">Rehber Ekle</span>
            </button>
        </div>

        <!-- Rehber Kartlari -->
        <div data-bind="visible: guides().length === 0" class="text-center text-muted py-5">
            <i class="bi bi-person-badge fs-1"></i>
            <p class="mt-3" data-t="Guide.NoGuides">Henuz rehber eklenmemis</p>
        </div>

        <div class="row g-3" data-bind="foreach: guides">
            <div class="col-md-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start">
                            <img data-bind="attr: { src: photoUrl || '/images/placeholders/avatar-placeholder.svg' }"
                                 class="rounded-circle me-3" style="width: 60px; height: 60px; object-fit: cover;">
                            <div class="flex-grow-1">
                                <h6 class="mb-1">
                                    <span data-bind="text: firstName + ' ' + lastName"></span>
                                </h6>
                                <div class="mb-1">
                                    <!-- ko if: languageList && languageList.length > 0 -->
                                    <span data-bind="foreach: languageList">
                                        <span class="badge bg-light text-dark border me-1">
                                            <span data-bind="text: $parents[1].getLanguageFlag($data)"></span>
                                            <span data-bind="text: $data.toUpperCase()"></span>
                                        </span>
                                    </span>
                                    <!-- /ko -->
                                </div>
                                <!-- ko if: experienceYears -->
                                <small class="text-muted">
                                    <i class="bi bi-briefcase me-1"></i><span data-bind="text: experienceYears"></span> <span data-t="Guide.Years">yil</span>
                                </small>
                                <!-- /ko -->
                            </div>
                        </div>
                        <hr class="my-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <span class="badge bg-info me-1" data-bind="visible: activeAssignments > 0">
                                    <i class="bi bi-calendar-event me-1"></i><span data-bind="text: activeAssignments"></span> <span data-t="Guide.ActiveAssignments">atama</span>
                                </span>
                                <span data-bind="visible: averageRating > 0">
                                    <span data-bind="text: averageRating.toFixed(1)"></span>
                                    <i class="bi bi-star-fill text-warning"></i>
                                </span>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-success" data-bind="click: $parent.openAssignModal" title="Tur Ata">
                                    <i class="bi bi-calendar-plus"></i>
                                </button>
                                <button class="btn btn-outline-secondary" data-bind="click: $parent.openPhotoModal" title="Fotograf">
                                    <i class="bi bi-camera"></i>
                                </button>
                                <button class="btn btn-outline-info" data-bind="click: $parent.openDetailModal" title="Detay">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-outline-primary" data-bind="click: $parent.openEditModal" title="Duzenle">
                                    <i class="bi bi-pencil"></i>
                                </button>
                                <button class="btn btn-outline-danger" data-bind="click: $parent.confirmDelete" title="Sil">
                                    <i class="bi bi-trash"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Rehber Ekle/Duzenle Modal -->
    <div class="modal fade" id="guideModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-badge me-2"></i>
                        <span data-bind="text: isEditing() ? T('Guide.Edit') || 'Rehber Duzenle' : T('Guide.Add') || 'Rehber Ekle'"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="form-label" data-t="Guide.FirstName">Ad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: formData().firstName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" data-t="Guide.LastName">Soyad <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" data-bind="value: formData().lastName" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" data-t="Guide.Phone">Telefon</label>
                            <input type="tel" class="form-control" data-bind="value: formData().phone">
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" data-t="Guide.Email">Email</label>
                            <input type="email" class="form-control" data-bind="value: formData().email">
                        </div>
                        <div class="col-12">
                            <label class="form-label" data-t="Guide.Languages">Diller</label>
                            <div class="d-flex flex-wrap gap-2" data-bind="foreach: availableLanguages">
                                <button type="button" class="btn btn-sm"
                                        data-bind="click: $parent.toggleLanguage,
                                                   css: $parent.isLanguageSelected($data.code) ? 'btn-primary' : 'btn-outline-secondary'">
                                    <span data-bind="text: $data.flagEmoji"></span>
                                    <span data-bind="text: $data.nativeName"></span>
                                </button>
                            </div>
                            <!-- ko if: selectedLanguages().length > 0 -->
                            <small class="text-muted mt-1 d-block">
                                <span data-bind="text: selectedLanguages().length"></span> <span data-t="Guide.LanguagesSelected">dil secildi</span>
                            </small>
                            <!-- /ko -->
                        </div>
                        <div class="col-md-6">
                            <label class="form-label" data-t="Guide.ExperienceYears">Deneyim (Yil)</label>
                            <input type="number" class="form-control" data-bind="value: formData().experienceYears" min="0">
                        </div>
                        <div class="col-12">
                            <label class="form-label" data-t="Guide.Bio">Biyografi</label>
                            <textarea class="form-control" rows="3" data-bind="value: formData().bio"></textarea>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Cancel">Iptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveGuide, enable: !isSaving()">
                        <span data-bind="visible: isSaving()" class="spinner-border spinner-border-sm me-1"></span>
                        <span data-t="Common.Save">Kaydet</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Rehber Detay Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-person-badge me-2"></i>
                        <span data-bind="text: detailGuide() ? detailGuide().firstName + ' ' + detailGuide().lastName : ''"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="if: detailGuide()">
                    <!-- Performans Kartlari -->
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <div class="card text-center">
                                <div class="card-body py-2">
                                    <div class="fs-4 fw-bold text-primary" data-bind="text: detailGuide().totalToursCompleted"></div>
                                    <small class="text-muted" data-t="Guide.TotalTours">Toplam Tur</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card text-center">
                                <div class="card-body py-2">
                                    <div class="fs-4 fw-bold text-warning">
                                        <span data-bind="text: detailGuide().averageRating ? detailGuide().averageRating.toFixed(1) : '-'"></span>
                                        <i class="bi bi-star-fill" style="font-size: 0.8em;"></i>
                                    </div>
                                    <small class="text-muted" data-t="Guide.Rating">Puan</small>
                                </div>
                            </div>
                        </div>
                        <div class="col-4">
                            <div class="card text-center">
                                <div class="card-body py-2">
                                    <div class="fs-4 fw-bold text-success" data-bind="text: detailGuide().assignments ? detailGuide().assignments.length : 0"></div>
                                    <small class="text-muted" data-t="Guide.Assignments">Atamalar</small>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Tur Tarihine Ata -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0"><i class="bi bi-calendar-plus me-1"></i> <span data-t="Guide.AssignToDate">Tur Tarihine Ata</span></h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-2">
                                <div class="col-md-5">
                                    <select class="form-select form-select-sm" data-bind="options: tourDatesForAssign, optionsText: 'label', optionsValue: 'id', optionsCaption: 'Tur tarihi secin...', value: selectedTourDateId"></select>
                                </div>
                                <div class="col-md-5">
                                    <input type="text" class="form-control form-control-sm" data-bind="value: assignNotes" placeholder="Not (opsiyonel)">
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-primary btn-sm w-100" data-bind="click: assignGuide, enable: selectedTourDateId()">
                                        <i class="bi bi-plus"></i> <span data-t="Guide.Assign">Ata</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Atama Gecmisi -->
                    <h6><i class="bi bi-clock-history me-1"></i> <span data-t="Guide.AssignmentHistory">Atama Gecmisi</span></h6>
                    <div data-bind="visible: !detailGuide().assignments || detailGuide().assignments.length === 0" class="text-center text-muted py-3">
                        <span data-t="Guide.NoAssignments">Henuz atama yok</span>
                    </div>
                    <div class="table-responsive" data-bind="visible: detailGuide().assignments && detailGuide().assignments.length > 0">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th data-t="Tour.Name">Tur</th>
                                    <th data-t="Reservation.Date">Tarih</th>
                                    <th data-t="Common.Status">Durum</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: detailGuide().assignments">
                                <tr>
                                    <td data-bind="text: tourName"></td>
                                    <td>
                                        <small data-bind="text: scheduleDays || '-'"></small>
                                        <small class="text-muted" data-bind="text: startTime ? ' ' + startTime : ''"></small>
                                    </td>
                                    <td><span class="badge" data-bind="css: statusCss || 'bg-secondary', text: statusName || 'Bilinmiyor'"></span></td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removeAssignment" title="Kaldir">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Close">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Fotograf Modal -->
    <div class="modal fade" id="photoModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-camera me-2"></i>
                        <span data-bind="text: photoGuideName()"></span> - <span data-t="Guide.Photo">Fotograf</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body text-center">
                    <!-- Mevcut fotograf -->
                    <div class="mb-3">
                        <img data-bind="attr: { src: photoGuideUrl() || '/images/placeholders/avatar-placeholder.svg' }"
                             class="rounded-circle" style="width: 120px; height: 120px; object-fit: cover;">
                    </div>
                    <!-- Upload -->
                    <div class="input-group mb-2">
                        <input type="file" class="form-control" id="guidePhotoFile" accept="image/*">
                        <button class="btn btn-primary" type="button" data-bind="click: uploadGuidePhoto, enable: !isUploadingPhoto()">
                            <span data-bind="visible: isUploadingPhoto()" class="spinner-border spinner-border-sm me-1"></span>
                            <i class="bi bi-upload me-1"></i><span data-t="Common.Upload">Yukle</span>
                        </button>
                    </div>
                    <!-- Sil butonu -->
                    <div data-bind="visible: photoGuideUrl()">
                        <button class="btn btn-outline-danger btn-sm" type="button" data-bind="click: deleteGuidePhoto">
                            <i class="bi bi-trash me-1"></i><span data-t="Guide.DeletePhoto">Fotografı Sil</span>
                        </button>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Close">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Rehber Tur Atama Modal -->
    <div class="modal fade" id="assignModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-calendar-plus me-2"></i>
                        <span data-bind="text: assignGuideName()"></span> - <span data-t="Guide.AssignToDate">Tur Atama</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Yeni Atama -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0"><i class="bi bi-plus-circle me-1"></i> <span data-t="Guide.NewAssignment">Yeni Atama</span></h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-6">
                                    <label class="form-label small" data-t="Guide.SelectTourDate">Tur Tarihi Secin</label>
                                    <select class="form-select form-select-sm" data-bind="options: tourDatesForAssign, optionsText: 'label', optionsValue: 'id', optionsCaption: 'Tur tarihi secin...', value: selectedTourDateId"></select>
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label small">Not (opsiyonel)</label>
                                    <input type="text" class="form-control form-control-sm" data-bind="value: assignNotes" placeholder="Not ekleyin...">
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-success btn-sm w-100" data-bind="click: assignGuideFromModal, enable: selectedTourDateId()">
                                        <i class="bi bi-plus me-1"></i><span data-t="Guide.Assign">Ata</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Mevcut Atamalar -->
                    <h6><i class="bi bi-list-check me-1"></i> <span data-t="Guide.CurrentAssignments">Mevcut Atamalar</span></h6>
                    <div data-bind="visible: assignGuideAssignments().length === 0" class="text-center text-muted py-3">
                        <i class="bi bi-calendar-x fs-3"></i>
                        <p class="mt-2" data-t="Guide.NoAssignments">Henuz atama yok</p>
                    </div>
                    <div class="table-responsive" data-bind="visible: assignGuideAssignments().length > 0">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th data-t="Tour.Name">Tur</th>
                                    <th data-t="Reservation.Date">Gunler</th>
                                    <th data-t="Reservation.StartTime">Saat</th>
                                    <th data-t="Common.Status">Durum</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: assignGuideAssignments">
                                <tr>
                                    <td>
                                        <strong data-bind="text: tourName"></strong>
                                    </td>
                                    <td>
                                        <span data-bind="text: scheduleDays || '-'"></span>
                                    </td>
                                    <td>
                                        <span data-bind="text: startTime || '-'"></span>
                                    </td>
                                    <td>
                                        <span class="badge" data-bind="css: statusCss || 'bg-secondary', text: statusName || 'Bilinmiyor'"></span>
                                    </td>
                                    <td>
                                        <button class="btn btn-outline-danger btn-sm" data-bind="click: $parent.removeAssignmentFromModal" title="Kaldir">
                                            <i class="bi bi-x"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Close">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Onay Modal -->
    <div class="modal fade" id="deleteGuideModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <span data-t="Guide.DeleteConfirm">Rehber Silme</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p data-t="Guide.DeleteMessage">Bu rehberi silmek istediginizden emin misiniz?</p>
                    <p class="fw-bold" data-bind="text: deletingGuide() ? deletingGuide().firstName + ' ' + deletingGuide().lastName : ''"></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Cancel">Iptal</button>
                    <button type="button" class="btn btn-danger" data-bind="click: deleteGuide, enable: !isDeleting()">
                        <span data-bind="visible: isDeleting()" class="spinner-border spinner-border-sm me-1"></span>
                        <span data-t="Common.Delete">Sil</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/MyCompany/Guides.js"></script>
}
