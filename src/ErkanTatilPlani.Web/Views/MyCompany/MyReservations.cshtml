@{
    Layout = "_CompanyLayout";
}

<div id="myReservationsApp">
    <!-- Yukleniyor -->
    <div data-bind="visible: isLoading()" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
        <p class="mt-3 text-muted" data-t="Common.Loading">Yukleniyor...</p>
    </div>

    <!-- Ana Icerik -->
    <div data-bind="visible: !isLoading()">
        <!-- Istatistik Kartlari -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card h-100" style="cursor: pointer;" data-bind="click: function() { filterByStatus('all') }">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded p-2 bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-calendar-check fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small" data-t="MyReservations.Total">Toplam</div>
                                <div class="fs-4 fw-bold" data-bind="text: stats().total">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100" style="cursor: pointer;" data-bind="click: function() { filterByStatus('Pending') }">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded p-2 bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-clock fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small" data-t="Status.Pending">Bekleyen</div>
                                <div class="fs-4 fw-bold" data-bind="text: stats().pending">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100" style="cursor: pointer;" data-bind="click: function() { filterByStatus('Confirmed') }">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded p-2 bg-success bg-opacity-10 text-success">
                                <i class="bi bi-check-circle fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small" data-t="Status.Confirmed">Onaylanan</div>
                                <div class="fs-4 fw-bold" data-bind="text: stats().confirmed">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100" style="cursor: pointer;" data-bind="click: function() { filterByStatus('Completed') }">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded p-2 bg-info bg-opacity-10 text-info">
                                <i class="bi bi-flag fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small" data-t="Status.Completed">Tamamlanan</div>
                                <div class="fs-4 fw-bold" data-bind="text: stats().completed">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Rezervasyon Listesi -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-calendar-check me-2"></i>
                    <span data-t="MyReservations.Title">Rezervasyonlarim</span>
                    <span class="badge bg-secondary ms-2" data-bind="text: reservations().length"></span>
                </span>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" data-bind="click: function() { filterByStatus('all') }, css: { active: currentFilter() === 'all' }">
                        <span data-t="Common.All">Tumu</span>
                    </button>
                    <button class="btn btn-outline-warning" data-bind="click: function() { filterByStatus('Pending') }, css: { active: currentFilter() === 'Pending' }">
                        <span data-t="Status.Pending">Bekleyen</span>
                    </button>
                    <button class="btn btn-outline-success" data-bind="click: function() { filterByStatus('Confirmed') }, css: { active: currentFilter() === 'Confirmed' }">
                        <span data-t="Status.Confirmed">Onaylanan</span>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <!-- Veri yok -->
                <div data-bind="visible: reservations().length === 0" class="text-center text-muted py-5">
                    <i class="bi bi-calendar-x fs-1"></i>
                    <p class="mt-3" data-t="MyReservations.NoReservations">Henuz rezervasyon yok</p>
                </div>

                <!-- Tablo -->
                <div class="table-responsive" data-bind="visible: reservations().length > 0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th data-t="Tour.Name">Tur</th>
                                <th data-t="MyReservations.Customer">Musteri</th>
                                <th data-t="Reservation.Date">Tarih</th>
                                <th class="text-center" data-t="Reservation.People">Kisi</th>
                                <th class="text-end" data-t="Reservation.TotalPrice">Tutar</th>
                                <th class="text-center" data-t="Reservation.Status">Durum</th>
                                <th class="text-center" data-t="Common.Actions">Islemler</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: reservations">
                            <tr>
                                <td>
                                    <div class="fw-medium" data-bind="text: tourName"></div>
                                    <small class="text-muted" data-bind="text: tourDestination"></small>
                                </td>
                                <td>
                                    <div data-bind="text: visitorName"></div>
                                    <small class="text-muted" data-bind="text: visitorEmail"></small>
                                </td>
                                <td>
                                    <div data-bind="text: date"></div>
                                    <small class="text-muted" data-bind="text: (startTime || '') + (durationValue ? ' (' + durationValue + ' ' + (durationUnit || '') + ')' : '')"></small>
                                </td>
                                <td class="text-center">
                                    <span class="badge bg-secondary" data-bind="text: numberOfPeople"></span>
                                </td>
                                <td class="text-end fw-medium" data-bind="text: $parent.formatCurrency(totalPrice)"></td>
                                <td class="text-center">
                                    <span class="badge" data-bind="css: $parent.getStatusBadgeClass(status), text: $parent.getStatusText(status)"></span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" data-bind="click: $parent.showDetails" title="Detay">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                        <!-- Bekleyen ise Onayla/Reddet -->
                                        <button class="btn btn-success" data-bind="visible: status === 'Pending', click: function() { $parent.updateStatus($data, 'Confirmed') }" title="Onayla">
                                            <i class="bi bi-check"></i>
                                        </button>
                                        <button class="btn btn-danger" data-bind="visible: status === 'Pending', click: function() { $parent.updateStatus($data, 'Cancelled') }" title="Iptal Et">
                                            <i class="bi bi-x"></i>
                                        </button>
                                        <!-- Onaylanan ise Tamamla -->
                                        <button class="btn btn-info" data-bind="visible: status === 'Confirmed', click: function() { $parent.updateStatus($data, 'Completed') }" title="Tamamla">
                                            <i class="bi bi-flag"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Detay Modal -->
    <div class="modal fade" id="detailModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-calendar-check me-2"></i>
                        <span data-t="MyReservations.Details">Rezervasyon Detayi</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body" data-bind="with: selectedReservation">
                    <div class="mb-3">
                        <label class="form-label text-muted small" data-t="Tour.Name">Tur</label>
                        <div class="fw-medium" data-bind="text: tourName"></div>
                        <small class="text-muted" data-bind="text: tourDestination"></small>
                    </div>
                    <hr>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small" data-t="MyReservations.Customer">Musteri</label>
                            <div data-bind="text: visitorName"></div>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small" data-t="Register.Phone">Telefon</label>
                            <div data-bind="text: visitorPhone || '-'"></div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small" data-t="Register.Email">E-posta</label>
                        <div data-bind="text: visitorEmail"></div>
                    </div>
                    <hr>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small" data-t="Reservation.Date">Tarih</label>
                            <div data-bind="text: date"></div>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small" data-t="Reservation.StartTime">Saat</label>
                            <div data-bind="text: (startTime || '-') + (durationValue ? ' (' + durationValue + ' ' + (durationUnit || '') + ')' : '')"></div>
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6">
                            <label class="form-label text-muted small" data-t="Reservation.People">Kisi Sayisi</label>
                            <div data-bind="text: numberOfPeople"></div>
                        </div>
                        <div class="col-6">
                            <label class="form-label text-muted small" data-t="Reservation.TotalPrice">Toplam Tutar</label>
                            <div class="fw-bold text-primary" data-bind="text: $parent.formatCurrency(totalPrice)"></div>
                        </div>
                    </div>
                    <div class="mb-3" data-bind="visible: notes">
                        <label class="form-label text-muted small" data-t="Reservation.Notes">Notlar</label>
                        <div data-bind="text: notes"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label text-muted small" data-t="Reservation.Status">Durum</label>
                        <div>
                            <span class="badge" data-bind="css: $parent.getStatusBadgeClass(status), text: $parent.getStatusText(status)"></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Close">Kapat</button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/MyCompany/MyReservations.js"></script>
}
