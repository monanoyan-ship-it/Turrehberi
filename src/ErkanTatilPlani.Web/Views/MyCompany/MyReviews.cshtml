@{
    Layout = "_CompanyLayout";
}

<div id="myReviewsApp">
    <!-- Yukleniyor -->
    <div data-bind="visible: isLoading()" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
        <p class="mt-3 text-muted" data-t="Common.Loading">Yukleniyor...</p>
    </div>

    <!-- Ana Icerik -->
    <div data-bind="visible: !isLoading()">
        <!-- Istatistik Kartlari -->
        <div class="row g-3 mb-4">
            <div class="col-6 col-lg-3">
                <div class="card h-100" style="cursor: pointer;" data-bind="click: function() { filterByReply(null) }">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded p-2 bg-primary bg-opacity-10 text-primary">
                                <i class="bi bi-chat-square-text fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small" data-t="MyReviews.Total">Toplam Yorum</div>
                                <div class="fs-4 fw-bold" data-bind="text: stats().total">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100" style="cursor: pointer;" data-bind="click: function() { filterByReply(false) }">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded p-2 bg-warning bg-opacity-10 text-warning">
                                <i class="bi bi-reply fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small" data-t="MyReviews.AwaitingReply">Yanit Bekleyen</div>
                                <div class="fs-4 fw-bold" data-bind="text: stats().withoutReply">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100" style="cursor: pointer;" data-bind="click: function() { filterByReply(true) }">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded p-2 bg-success bg-opacity-10 text-success">
                                <i class="bi bi-check-circle fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small" data-t="MyReviews.Replied">Yanitlanan</div>
                                <div class="fs-4 fw-bold" data-bind="text: stats().withReply">0</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-6 col-lg-3">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-center gap-3">
                            <div class="rounded p-2 bg-info bg-opacity-10 text-info">
                                <i class="bi bi-star-fill fs-4"></i>
                            </div>
                            <div>
                                <div class="text-muted small" data-t="Dashboard.Stats.AverageRating">Ortalama Puan</div>
                                <div class="fs-4 fw-bold">
                                    <span data-bind="text: stats().averageRating">0</span>
                                    <i class="bi bi-star-fill text-warning fs-6"></i>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Yorum Listesi -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span>
                    <i class="bi bi-chat-square-text me-2"></i>
                    <span data-t="MyReviews.Title">Yorumlar</span>
                    <span class="badge bg-secondary ms-2" data-bind="text: reviews().length"></span>
                </span>
                <div class="btn-group btn-group-sm">
                    <button class="btn btn-outline-secondary" data-bind="click: function() { filterByReply(null) }, css: { active: currentFilter() === null }">
                        <span data-t="Common.All">Tumu</span>
                    </button>
                    <button class="btn btn-outline-warning" data-bind="click: function() { filterByReply(false) }, css: { active: currentFilter() === false }">
                        <span data-t="MyReviews.AwaitingReply">Yanit Bekleyen</span>
                    </button>
                    <button class="btn btn-outline-success" data-bind="click: function() { filterByReply(true) }, css: { active: currentFilter() === true }">
                        <span data-t="MyReviews.Replied">Yanitlanan</span>
                    </button>
                </div>
            </div>
            <div class="card-body p-0">
                <!-- Veri yok -->
                <div data-bind="visible: reviews().length === 0" class="text-center text-muted py-5">
                    <i class="bi bi-chat-square fs-1"></i>
                    <p class="mt-3" data-t="MyReviews.NoReviews">Henuz yorum yok</p>
                </div>

                <!-- Yorum Listesi -->
                <div class="list-group list-group-flush" data-bind="visible: reviews().length > 0, foreach: reviews">
                    <div class="list-group-item p-3">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <span class="text-warning" data-bind="html: $parent.getStars(overallRating)"></span>
                                <span class="ms-2 fw-medium" data-bind="text: visitorName"></span>
                                <span class="badge bg-success ms-2" data-bind="visible: isVerified" data-t="Review.Verified">Dogrulanmis</span>
                            </div>
                            <small class="text-muted" data-bind="text: $parent.formatDate(createdAt)"></small>
                        </div>

                        <div class="mb-2">
                            <span class="badge bg-secondary me-2" data-bind="text: tourName"></span>
                            <small class="text-muted" data-bind="text: tourDestination"></small>
                        </div>

                        <!-- Yorum Icerigi -->
                        <div data-bind="visible: title, text: title" class="fw-medium mb-1"></div>
                        <p class="mb-2" data-bind="text: comment"></p>

                        <div class="row g-2 mb-2" data-bind="visible: pros || cons">
                            <div class="col-md-6" data-bind="visible: pros">
                                <small class="text-success"><i class="bi bi-plus-circle me-1"></i><span data-bind="text: pros"></span></small>
                            </div>
                            <div class="col-md-6" data-bind="visible: cons">
                                <small class="text-danger"><i class="bi bi-dash-circle me-1"></i><span data-bind="text: cons"></span></small>
                            </div>
                        </div>

                        <!-- Firma Yaniti -->
                        <div data-bind="visible: hasCompanyReply" class="bg-light rounded p-2 mb-2">
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <i class="bi bi-building text-primary"></i>
                                <small class="fw-medium" data-t="Review.FromCompany">Firma Yaniti</small>
                                <small class="text-muted" data-bind="text: companyReply ? $parent.formatDate(companyReply.createdAt) : ''"></small>
                            </div>
                            <p class="mb-0 small" data-bind="text: companyReply ? companyReply.comment : ''"></p>
                        </div>

                        <!-- Yanit Butonu / Formu -->
                        <div data-bind="visible: !hasCompanyReply">
                            <!-- Yanit Butonu -->
                            <button class="btn btn-sm btn-outline-primary" data-bind="visible: !$parent.isReplying() || $parent.replyingReviewId() !== id, click: function() { $parent.startReply($data) }">
                                <i class="bi bi-reply me-1"></i><span data-t="Review.Reply">Yanitla</span>
                            </button>

                            <!-- Yanit Formu -->
                            <div data-bind="visible: $parent.isReplying() && $parent.replyingReviewId() === id" class="mt-2">
                                <textarea class="form-control mb-2" rows="3" data-bind="value: $parent.replyText" placeholder="Yanitinizi yazin..."></textarea>
                                <div class="d-flex gap-2">
                                    <button class="btn btn-sm btn-primary" data-bind="click: $parent.submitReply, enable: !$parent.isSending()">
                                        <span data-bind="visible: $parent.isSending()" class="spinner-border spinner-border-sm me-1"></span>
                                        <span data-t="MyReviews.SendReply">Yanit Gonder</span>
                                    </button>
                                    <button class="btn btn-sm btn-secondary" data-bind="click: $parent.cancelReply" data-t="Common.Cancel">Iptal</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/MyCompany/MyReviews.js"></script>
}
