@{
    Layout = "_CompanyLayout";
}

<div id="myToursApp">
    <!-- Firma Durumu Uyarisi -->
    <div data-bind="visible: !canManageTours() && !isLoading()" class="alert alert-warning">
        <i class="bi bi-exclamation-triangle me-2"></i>
        <strong data-t="Error.CompanyNotApproved">Firma onaylanmadan tur islemleri yapamazsiniz.</strong>
        <span data-t="Error.CompanyPending">Basvurunuz inceleniyor.</span>
    </div>

    <!-- Yukleniyor -->
    <div data-bind="visible: isLoading()" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
        <p class="mt-3 text-muted" data-t="Common.Loading">Yukleniyor...</p>
    </div>

    <!-- Ana Icerik -->
    <div data-bind="visible: !isLoading()">
        <!-- Tur Listesi -->
        <div class="card">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span><i class="bi bi-geo-alt me-2"></i><span data-t="MyTours.Title">Turlarim</span></span>
                <button class="btn btn-sm btn-primary" data-bind="click: openAddModal, enable: canManageTours()">
                    <i class="bi bi-plus me-1"></i><span data-t="MyTours.AddTour">Yeni Tur Ekle</span>
                </button>
            </div>
            <div class="card-body p-0">
                <!-- Veri yok -->
                <div data-bind="visible: tours().length === 0" class="text-center text-muted py-5">
                    <i class="bi bi-geo-alt fs-1"></i>
                    <p class="mt-3" data-t="MyTours.NoTours">Henuz tur eklenmemis</p>
                    <button class="btn btn-primary" data-bind="click: openAddModal, enable: canManageTours()">
                        <i class="bi bi-plus me-1"></i><span data-t="MyTours.AddFirstTour">Ilk Turunuzu Ekleyin</span>
                    </button>
                </div>

                <!-- Tablo -->
                <div class="table-responsive" data-bind="visible: tours().length > 0">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th style="width: 80px;"></th>
                                <th data-t="Tour.Name">Tur Adi</th>
                                <th data-t="Tour.Destination">Destinasyon</th>
                                <th class="text-end" data-t="Tour.Price">Fiyat</th>
                                <th class="text-center" data-t="Tour.Duration">Sure</th>
                                <th class="text-center" data-t="Tour.Capacity">Kapasite</th>
                                <th class="text-center" data-t="MyTours.Reservations">Rezervasyon</th>
                                <th class="text-center" data-t="Dashboard.Rating">Puan</th>
                                <th class="text-center" data-t="Common.Active">Durum</th>
                                <th class="text-center" data-t="Common.Actions">Islemler</th>
                            </tr>
                        </thead>
                        <tbody data-bind="foreach: tours">
                            <tr data-bind="css: { 'table-secondary': !isActive }">
                                <td>
                                    <img data-bind="attr: { src: imageUrl || 'https://picsum.photos/seed/' + id + '/60/40' }"
                                         class="rounded" style="width: 60px; height: 40px; object-fit: cover;">
                                </td>
                                <td>
                                    <div class="fw-medium" data-bind="text: name"></div>
                                    <small class="text-muted" data-bind="text: description.substring(0, 50) + (description.length > 50 ? '...' : '')"></small>
                                </td>
                                <td data-bind="text: destination"></td>
                                <td class="text-end fw-medium" data-bind="text: $parent.formatCurrency(price)"></td>
                                <td class="text-center">
                                    <span data-bind="text: durationDays"></span> <span data-t="MyTours.Days">gun</span>
                                </td>
                                <td class="text-center" data-bind="text: maxCapacity"></td>
                                <td class="text-center">
                                    <span class="badge bg-primary" data-bind="text: reservationCount"></span>
                                </td>
                                <td class="text-center">
                                    <span data-bind="visible: averageRating > 0">
                                        <span data-bind="text: averageRating.toFixed(1)"></span>
                                        <i class="bi bi-star-fill text-warning"></i>
                                        <small class="text-muted">(<span data-bind="text: reviewCount"></span>)</small>
                                    </span>
                                    <span data-bind="visible: !averageRating || averageRating === 0" class="text-muted">-</span>
                                </td>
                                <td class="text-center">
                                    <span class="badge" data-bind="css: isActive ? 'bg-success' : 'bg-secondary', text: isActive ? 'Aktif' : 'Pasif'"></span>
                                    <span class="badge bg-success-subtle text-success ms-1" data-bind="visible: isSustainable" title="Eko-Dostu"><i class="bi bi-leaf"></i></span>
                                    <span class="badge bg-info-subtle text-info ms-1" data-bind="visible: isWheelchairAccessible" title="Tekerlekli Sandalye"><i class="bi bi-universal-access"></i></span>
                                </td>
                                <td class="text-center">
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-success" data-bind="click: $parent.openPhotoModal, enable: $parent.canManageTours()" title="Fotograflar">
                                            <i class="bi bi-images"></i>
                                        </button>
                                        <button class="btn btn-outline-info" data-bind="click: $parent.openDateManageModal, enable: $parent.canManageTours()" title="Tarihleri Yonet">
                                            <i class="bi bi-calendar3"></i>
                                        </button>
                                        <button class="btn btn-outline-primary" data-bind="click: $parent.openEditModal, enable: $parent.canManageTours()" title="Duzenle">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" data-bind="click: $parent.confirmDelete, enable: $parent.canManageTours()" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>

    <!-- Tur Ekle/Duzenle Modal -->
    <div class="modal fade" id="tourModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-geo-alt me-2"></i>
                        <span data-bind="text: isEditing() ? 'Tur Duzenle' : 'Yeni Tur Ekle'"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <form id="tourForm">
                        <div class="row g-3">
                            <!-- Tur Adi -->
                            <div class="col-md-6">
                                <label class="form-label" data-t="Tour.Name">Tur Adi <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: formData().name" required>
                            </div>

                            <!-- Destinasyon -->
                            <div class="col-md-6">
                                <label class="form-label" data-t="Tour.Destination">Destinasyon <span class="text-danger">*</span></label>
                                <input type="text" class="form-control" data-bind="value: formData().destination" required>
                            </div>

                            <!-- Aciklama -->
                            <div class="col-12">
                                <label class="form-label" data-t="Tour.Description">Aciklama</label>
                                <textarea class="form-control" rows="3" data-bind="value: formData().description"></textarea>
                            </div>

                            <!-- Fiyat -->
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.Price">Fiyat (TL) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" data-bind="value: formData().price" min="0" step="0.01" required>
                            </div>

                            <!-- Sure -->
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.Duration">Sure (Gun) <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" data-bind="value: formData().durationDays" min="1" required>
                            </div>

                            <!-- Kapasite -->
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.Capacity">Maksimum Kapasite <span class="text-danger">*</span></label>
                                <input type="number" class="form-control" data-bind="value: formData().maxCapacity" min="1" required>
                            </div>

                            <!-- Kapak Fotografi -->
                            <div class="col-12" data-bind="visible: isEditing()">
                                <label class="form-label" data-t="MyTours.CoverPhoto">Kapak Fotografi</label>
                                <div class="d-flex align-items-center gap-3">
                                    <div data-bind="visible: formData().imageUrl">
                                        <img data-bind="attr: { src: formData().imageUrl }" class="rounded" style="width: 80px; height: 55px; object-fit: cover;">
                                    </div>
                                    <div class="flex-grow-1">
                                        <div class="input-group">
                                            <input type="file" class="form-control" id="tourCoverPhotoFile" accept="image/*">
                                            <button class="btn btn-outline-primary" type="button" data-bind="click: uploadCoverPhoto, enable: !isUploadingCover()">
                                                <span data-bind="visible: isUploadingCover()" class="spinner-border spinner-border-sm me-1"></span>
                                                <i class="bi bi-upload me-1"></i><span data-t="Common.Upload">Yukle</span>
                                            </button>
                                        </div>
                                        <div data-bind="visible: formData().imageUrl && formData().imageUrl.indexOf('/uploads/') === 0" class="mt-1">
                                            <button class="btn btn-outline-danger btn-sm" type="button" data-bind="click: deleteCoverPhoto">
                                                <i class="bi bi-trash me-1"></i><span data-t="MyTours.DeleteCoverPhoto">Kapak Fotografini Sil</span>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                                <small class="text-muted" data-t="MyTours.CoverPhotoHint">Once turu kaydedin, sonra kapak fotografi yukleyin</small>
                            </div>
                            <div class="col-12" data-bind="visible: !isEditing()">
                                <div class="alert alert-info py-2 mb-0">
                                    <i class="bi bi-info-circle me-1"></i>
                                    <span data-t="MyTours.CoverPhotoAfterSave">Kapak fotografini tur kaydedildikten sonra yukleyebilirsiniz.</span>
                                </div>
                            </div>

                            <!-- Zorluk ve Kategori -->
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.Difficulty">Zorluk Seviyesi</label>
                                <select class="form-select" data-bind="value: formData().difficultyId">
                                    <option value="0" data-t="TourDifficulty.Easy">Kolay</option>
                                    <option value="1" data-t="TourDifficulty.Moderate">Orta</option>
                                    <option value="2" data-t="TourDifficulty.Challenging">Zor</option>
                                    <option value="3" data-t="TourDifficulty.Expert">Uzman</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.Category">Kategori</label>
                                <select class="form-select" data-bind="value: formData().categoryId">
                                    <option value="0" data-t="TourCategory.Adventure">Macera</option>
                                    <option value="1" data-t="TourCategory.Culture">Kultur</option>
                                    <option value="2" data-t="TourCategory.Food">Yeme-Icme</option>
                                    <option value="3" data-t="TourCategory.Nature">Doga</option>
                                    <option value="4" data-t="TourCategory.History">Tarih</option>
                                    <option value="5" data-t="TourCategory.Beach">Deniz</option>
                                    <option value="6" data-t="TourCategory.City">Sehir</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.GuideLanguages">Rehber Dilleri</label>
                                <input type="text" class="form-control" data-bind="value: formData().guideLanguages" placeholder="tr,en,de">
                                <small class="text-muted">Virgullu ayrilmis (tr,en,de)</small>
                            </div>

                            <!-- Dahil Olan / Olmayan -->
                            <div class="col-md-6">
                                <label class="form-label" data-t="Tour.Inclusions">Dahil Olan</label>
                                <textarea class="form-control" rows="3" data-bind="value: formData().inclusions" placeholder="Her satira bir madde yazin"></textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label" data-t="Tour.Exclusions">Dahil Olmayan</label>
                                <textarea class="form-control" rows="3" data-bind="value: formData().exclusions" placeholder="Her satira bir madde yazin"></textarea>
                            </div>

                            <!-- Surdurulebilirlik (Faz 15.4) -->
                            <div class="col-12">
                                <hr class="my-2">
                                <h6 class="text-muted"><i class="bi bi-leaf me-1"></i><span data-t="Tour.Sustainable">Surdurulebilirlik</span></h6>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: formData().isSustainable" id="chkSustainable">
                                    <label class="form-check-label" for="chkSustainable" data-t="Tour.Sustainable">Eko-Dostu Tur</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.SustainabilityScore">Surdurulebilirlik Puani (0-100)</label>
                                <input type="number" class="form-control" data-bind="value: formData().sustainabilityScore" min="0" max="100">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.SustainabilityInfo">Surdurulebilirlik Detaylari</label>
                                <input type="text" class="form-control" data-bind="value: formData().sustainabilityInfo" placeholder="Karbon notr, plastik yok...">
                            </div>

                            <!-- Erisilebilirlik (Faz 15.5) -->
                            <div class="col-12">
                                <hr class="my-2">
                                <h6 class="text-muted"><i class="bi bi-universal-access me-1"></i><span data-t="Tour.AccessibilityInfo">Erisilebilirlik</span></h6>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" data-bind="checked: formData().isWheelchairAccessible" id="chkWheelchair">
                                    <label class="form-check-label" for="chkWheelchair" data-t="Tour.WheelchairAccessible">Tekerlekli Sandalye Erisimi</label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.MobilityLevel">Mobilite Seviyesi</label>
                                <select class="form-select" data-bind="value: formData().mobilityLevel">
                                    <option value="0" data-t="Mobility.Unknown">Bilgi Yok</option>
                                    <option value="1" data-t="Mobility.Easy">Kolay</option>
                                    <option value="2" data-t="Mobility.Moderate">Orta</option>
                                    <option value="3" data-t="Mobility.Difficult">Zor</option>
                                </select>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" data-t="Tour.AccessibilityInfo">Erisilebilirlik Detaylari</label>
                                <input type="text" class="form-control" data-bind="value: formData().accessibilityInfo" placeholder="Asansor, rampa, engelli WC...">
                            </div>

                            <!-- Bulusma Noktasi -->
                            <div class="col-12">
                                <hr class="my-2">
                                <h6 class="text-muted"><i class="bi bi-geo-alt-fill me-1"></i><span data-t="MeetingPoint.Title">Bulusma Noktasi</span></h6>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" data-t="MeetingPoint.Lat">Enlem</label>
                                <input type="number" class="form-control" data-bind="value: formData().meetingPointLat" step="0.000001" placeholder="41.0082">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" data-t="MeetingPoint.Lng">Boylam</label>
                                <input type="number" class="form-control" data-bind="value: formData().meetingPointLng" step="0.000001" placeholder="28.9784">
                            </div>
                            <div class="col-md-4">
                                <label class="form-label" data-t="MeetingPoint.Address">Adres</label>
                                <input type="text" class="form-control" data-bind="value: formData().meetingPointAddress" placeholder="Sultanahmet Meydani">
                            </div>

                            <!-- One Cikan - sadece bilgi -->
                            <div class="col-12" data-bind="visible: isEditing() && formData().isFeatured">
                                <div class="alert alert-info py-2 mb-0">
                                    <i class="bi bi-star-fill text-warning me-1"></i>
                                    <span data-t="MyTours.FeaturedInfo">Bu tur one cikan olarak isaretlenmistir. Bu ayar sadece yonetici tarafindan degistirilebilir.</span>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Cancel">Iptal</button>
                    <button type="button" class="btn btn-primary" data-bind="click: saveTour, enable: !isSaving()">
                        <span data-bind="visible: isSaving()" class="spinner-border spinner-border-sm me-1"></span>
                        <span data-t="Common.Save">Kaydet</span>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tarih Yonetim Modal -->
    <div class="modal fade" id="dateManageModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-calendar3 me-2"></i>
                        <span data-t="TourDate.ManageDates">Tarihleri Yonet</span>
                        - <span data-bind="text: managingTourName()"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Takvim Sablonu (Schedule) Yonetimi -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0"><i class="bi bi-calendar-week me-1"></i> <span data-t="TourSchedule.Title">Takvim Sablonlari</span></h6>
                        </div>
                        <div class="card-body">
                            <!-- Schedule Formu -->
                            <div class="row g-2 mb-3">
                                <div class="col-12">
                                    <label class="form-label small" data-t="TourSchedule.DaysOfWeek">Gunler <span class="text-danger">*</span></label>
                                    <div class="d-flex flex-wrap gap-1">
                                        <!-- ko foreach: weekDays -->
                                        <input type="checkbox" class="btn-check" autocomplete="off" data-bind="attr: { id: 'schedDayBtn' + value }, checked: $parent.scheduleSelectedDays, checkedValue: String(value)">
                                        <label class="btn btn-sm btn-outline-primary" data-bind="attr: { 'for': 'schedDayBtn' + value }, text: label"></label>
                                        <!-- /ko -->
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small" data-t="TourSchedule.StartTime">Saat <span class="text-danger">*</span></label>
                                    <input type="time" class="form-control form-control-sm" data-bind="value: scheduleFormData().startTime" required>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small" data-t="TourSchedule.Duration">Sure <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control form-control-sm" data-bind="value: scheduleFormData().durationValue" min="1" required>
                                </div>
                                <div class="col-md-2">
                                    <label class="form-label small">&nbsp;</label>
                                    <select class="form-select form-select-sm" data-bind="options: durationUnits, optionsText: 'label', optionsValue: 'value', value: scheduleFormData().durationUnit, disable: isDurationUnitLocked()"></select>
                                    <!-- ko if: isDurationUnitLocked() -->
                                    <small class="text-muted" data-t="Tour.DurationUnitLocked"><i class="bi bi-lock-fill"></i></small>
                                    <!-- /ko -->
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small" data-t="TourDate.Price">Fiyat (TL) <span class="text-danger">*</span></label>
                                    <input type="number" class="form-control form-control-sm" data-bind="value: scheduleFormData().price" min="0.01" step="0.01" required>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small" data-t="TourDate.Capacity">Kapasite</label>
                                    <input type="number" class="form-control form-control-sm" data-bind="value: scheduleFormData().maxCapacity" min="1">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small" data-t="TourSchedule.ValidFrom">Gecerli Baslangic <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control form-control-sm" data-bind="value: scheduleFormData().validFrom" required>
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small" data-t="TourSchedule.ValidTo">Gecerli Bitis <span class="text-danger">*</span></label>
                                    <input type="date" class="form-control form-control-sm" data-bind="value: scheduleFormData().validTo" required>
                                </div>
                                <div class="col-md-6 d-flex align-items-end gap-2">
                                    <button class="btn btn-primary btn-sm" data-bind="click: saveSchedule, enable: !isSavingSchedule()">
                                        <span data-bind="visible: isSavingSchedule()" class="spinner-border spinner-border-sm me-1"></span>
                                        <i class="bi bi-check-lg me-1"></i>
                                        <span data-bind="text: editingScheduleId() ? T('Common.Save') : T('Common.Add')"></span>
                                    </button>
                                    <button class="btn btn-outline-secondary btn-sm" data-bind="visible: editingScheduleId(), click: resetScheduleForm">
                                        <span data-t="Common.Cancel">Iptal</span>
                                    </button>
                                </div>
                            </div>

                            <!-- Schedule Listesi -->
                            <div data-bind="visible: isLoadingSchedules()" class="text-center py-2">
                                <div class="spinner-border spinner-border-sm text-primary"></div>
                            </div>
                            <div data-bind="visible: !isLoadingSchedules() && schedules().length === 0" class="text-center text-muted py-2">
                                <small data-t="TourSchedule.NoSchedules">Henuz takvim sablonu eklenmemis</small>
                            </div>
                            <div data-bind="visible: !isLoadingSchedules() && schedules().length > 0">
                                <!-- ko foreach: schedules -->
                                <div class="border rounded p-2 mb-2 d-flex justify-content-between align-items-center">
                                    <div>
                                        <strong data-bind="text: $parent.formatDaysOfWeek(daysOfWeekParsed)"></strong>
                                        <span class="text-muted ms-2" data-bind="text: $parent.formatScheduleTime($data)"></span>
                                        <!-- ko if: price -->
                                        <span class="badge bg-success ms-1" data-bind="text: price.toLocaleString('tr-TR') + ' TL'"></span>
                                        <!-- /ko -->
                                        <!-- ko if: maxCapacity -->
                                        <span class="badge bg-info ms-1" data-bind="text: maxCapacity + ' ' + T('Tour.Person')"></span>
                                        <!-- /ko -->
                                        <br>
                                        <small class="text-muted" data-bind="text: new Date(validFrom).toLocaleDateString('tr-TR') + ' - ' + new Date(validTo).toLocaleDateString('tr-TR')"></small>
                                    </div>
                                    <div class="btn-group btn-group-sm">
                                        <button class="btn btn-outline-primary" data-bind="click: $parent.editSchedule" title="Duzenle">
                                            <i class="bi bi-pencil"></i>
                                        </button>
                                        <button class="btn btn-outline-danger" data-bind="click: $parent.deleteSchedule" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                                <!-- /ko -->
                            </div>
                        </div>
                    </div>

                    <!-- Tarih Filtresi -->
                    <div class="mb-2">
                        <div class="d-flex flex-wrap gap-1 mb-2">
                            <!-- ko foreach: dateShortcuts -->
                            <button type="button" class="btn btn-outline-secondary btn-sm"
                                    data-bind="text: label, click: $parent.applyDateShortcut,
                                               css: { 'btn-secondary text-white': $parent.activeDateShortcut() === key, 'btn-outline-secondary': $parent.activeDateShortcut() !== key }">
                            </button>
                            <!-- /ko -->
                        </div>
                        <div class="row g-2 align-items-end">
                            <div class="col-auto">
                                <label class="form-label form-label-sm mb-1" data-t="Common.From">Baslangic</label>
                                <input type="date" class="form-control form-control-sm" data-bind="value: dateFilterFrom">
                            </div>
                            <div class="col-auto">
                                <label class="form-label form-label-sm mb-1" data-t="Common.To">Bitis</label>
                                <input type="date" class="form-control form-control-sm" data-bind="value: dateFilterTo">
                            </div>
                            <div class="col-auto">
                                <div class="form-check form-check-sm mt-2">
                                    <input class="form-check-input" type="checkbox" id="chkOnlyReserved" data-bind="checked: dateFilterOnlyReserved">
                                    <label class="form-check-label small" for="chkOnlyReserved" data-t="TourDate.OnlyWithReservations">Sadece rezervasyonlu</label>
                                </div>
                            </div>
                            <div class="col-auto">
                                <button type="button" class="btn btn-sm btn-primary" data-bind="click: filterManagedDates">
                                    <i class="bi bi-search"></i>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- Sanal Tarih Onizlemesi (Schedule'lardan uretilir) -->
                    <div data-bind="visible: isLoadingDates()" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                    </div>
                    <div data-bind="visible: !isLoadingDates() && managedDates().length === 0" class="text-center text-muted py-3">
                        <i class="bi bi-calendar-x"></i> <span data-t="TourDate.NoDates">Henuz tarih eklenmemis</span>
                    </div>
                    <div class="table-responsive" data-bind="visible: !isLoadingDates() && managedDates().length > 0">
                        <table class="table table-sm table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th data-t="Reservation.Date">Tarih</th>
                                    <th data-t="Reservation.StartTime">Saat</th>
                                    <th data-t="Reservation.Duration">Sure</th>
                                    <th data-t="TourDate.Price">Fiyat</th>
                                    <th data-t="TourDate.Capacity">Kapasite</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody data-bind="foreach: managedDates">
                                <tr>
                                    <td><small data-bind="text: date"></small></td>
                                    <td><small data-bind="text: startTime || '-'"></small></td>
                                    <td><small data-bind="text: durationValue + ' ' + $parent.localizeDurationUnit(durationUnit)"></small></td>
                                    <td data-bind="text: price ? price.toLocaleString('tr-TR', {style:'currency', currency:'TRY'}) : '-'"></td>
                                    <td>
                                        <!-- ko if: maxCapacity -->
                                        <div class="d-flex align-items-center">
                                            <div class="progress flex-grow-1 me-2" style="height: 8px; min-width: 60px;">
                                                <div class="progress-bar" data-bind="style: { width: $parent.capacityPercent($data) + '%' }, css: $parent.capacityColor($data)"></div>
                                            </div>
                                            <small data-bind="text: bookedCount + '/' + maxCapacity"></small>
                                        </div>
                                        <!-- /ko -->
                                        <!-- ko ifnot: maxCapacity -->
                                        <span>-</span>
                                        <!-- /ko -->
                                    </td>
                                    <td>
                                        <span class="badge" data-bind="css: isAvailable ? 'bg-success' : 'bg-secondary', text: isAvailable ? 'Musait' : 'Dolu'"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Close">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Fotograf Yonetim Modal -->
    <div class="modal fade" id="photoModal" tabindex="-1">
        <div class="modal-dialog modal-lg">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">
                        <i class="bi bi-images me-2"></i>
                        <span data-t="MyTours.Photos">Fotograflar</span>
                        - <span data-bind="text: photoTourName()"></span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <!-- Fotograf Yukle -->
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0"><i class="bi bi-upload me-1"></i> <span data-t="MyTours.UploadPhoto">Fotograf Yukle</span></h6>
                        </div>
                        <div class="card-body">
                            <div class="row g-2 align-items-end">
                                <div class="col-md-5">
                                    <label class="form-label small" data-t="Common.File">Dosya</label>
                                    <input type="file" class="form-control form-control-sm" id="photoFile" accept="image/*">
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label small" data-t="MyTours.PhotoTitle">Baslik</label>
                                    <input type="text" class="form-control form-control-sm" data-bind="value: photoTitle">
                                </div>
                                <div class="col-md-2">
                                    <div class="form-check mt-4">
                                        <input type="checkbox" class="form-check-input" id="photoCover" data-bind="checked: photoIsCover">
                                        <label class="form-check-label small" for="photoCover" data-t="MyTours.CoverPhoto">Kapak</label>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <button class="btn btn-primary btn-sm w-100" data-bind="click: uploadPhoto, enable: !isUploadingPhoto()">
                                        <span data-bind="visible: isUploadingPhoto()" class="spinner-border spinner-border-sm me-1"></span>
                                        <i class="bi bi-upload"></i> <span data-t="Common.Upload">Yukle</span>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Fotograf Listesi -->
                    <div data-bind="visible: isLoadingPhotos()" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                    </div>
                    <div data-bind="visible: !isLoadingPhotos() && tourPhotos().length === 0" class="text-center text-muted py-3">
                        <i class="bi bi-images fs-3"></i>
                        <p class="mt-2" data-t="MyTours.NoPhotos">Henuz fotograf eklenmemis</p>
                    </div>
                    <div class="row g-2" data-bind="visible: !isLoadingPhotos() && tourPhotos().length > 0, foreach: tourPhotos">
                        <div class="col-md-4">
                            <div class="card h-100">
                                <img data-bind="attr: { src: thumbnailUrl || imageUrl }" class="card-img-top" style="height: 150px; object-fit: cover;">
                                <div class="card-body p-2">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <small class="text-muted text-truncate" data-bind="text: title || 'Fotograf ' + displayOrder"></small>
                                        <!-- ko if: isCover -->
                                        <span class="badge bg-primary" data-t="MyTours.CoverPhoto">Kapak</span>
                                        <!-- /ko -->
                                    </div>
                                    <div class="btn-group btn-group-sm mt-1 w-100">
                                        <!-- ko ifnot: isCover -->
                                        <button class="btn btn-outline-primary" data-bind="click: $parent.setCoverPhoto" title="Kapak Yap">
                                            <i class="bi bi-star"></i>
                                        </button>
                                        <!-- /ko -->
                                        <button class="btn btn-outline-danger" data-bind="click: $parent.deletePhoto" title="Sil">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <small class="text-muted me-auto" data-bind="visible: tourPhotos().length > 0">
                        <span data-bind="text: tourPhotos().length"></span>/20 <span data-t="MyTours.Photos">fotograf</span>
                    </small>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Close">Kapat</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Silme Onay Modal -->
    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title text-danger">
                        <i class="bi bi-exclamation-triangle me-2"></i>
                        <span data-t="MyTours.DeleteConfirm">Tur Silme</span>
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <p data-t="MyTours.DeleteMessage">Bu turu silmek istediginizden emin misiniz?</p>
                    <p class="fw-bold" data-bind="text: deletingTour() ? deletingTour().name : ''"></p>
                    <div class="alert alert-warning">
                        <i class="bi bi-info-circle me-2"></i>
                        <span data-t="MyTours.DeleteWarning">Bu islem geri alinamaz. Tura ait rezervasyonlar etkilenmez.</span>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-t="Common.Cancel">Iptal</button>
                    <button type="button" class="btn btn-danger" data-bind="click: deleteTour, enable: !isDeleting()">
                        <span data-bind="visible: isDeleting()" class="spinner-border spinner-border-sm me-1"></span>
                        <span data-t="Common.Delete">Sil</span>
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/MyCompany/MyTours.js" asp-append-version="true"></script>
}
