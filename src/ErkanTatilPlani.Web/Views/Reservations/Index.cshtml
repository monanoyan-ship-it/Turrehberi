@{
    ViewData["Title"] = "Rezervasyonlar";
}

<div id="reservationsApp">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-calendar-check"></i> Rezervasyonlar</h1>
    <a href="/Tours" class="btn btn-outline-primary">
        <i class="bi bi-map me-1"></i> <span data-t="Menu.Tours">Turlar</span>
    </a>
</div>

<!-- Loading -->
<div data-bind="visible: isLoading" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Yukleniyor...</span>
    </div>
</div>

<!-- Liste -->
<div class="card shadow-sm" data-bind="visible: !isLoading()">
    <div class="card-body">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead class="table-light">
                    <tr>
                        <th>Ziyaretçi</th>
                        <th>Tur</th>
                        <th>Tarih</th>
                        <th>Kişi</th>
                        <th>Toplam</th>
                        <th>Ödeme</th>
                        <th>Durum</th>
                        <th style="width: 150px;">İşlemler</th>
                    </tr>
                </thead>
                <tbody data-bind="foreach: reservations">
                    <tr>
                        <td>
                            <i class="bi bi-person text-primary"></i>
                            <span data-bind="text: visitor ? visitor.firstName + ' ' + visitor.lastName : '-'"></span>
                        </td>
                        <td>
                            <span data-bind="text: tour ? tour.name : '-'"></span>
                            <br>
                            <small class="text-muted" data-bind="text: tour && tour.company ? tour.company.name : ''"></small>
                        </td>
                        <td data-bind="text: date + ' ' + (startTime ? startTime.toString().substring(0,5) : '')"></td>
                        <td data-bind="text: numberOfPeople"></td>
                        <td data-bind="text: totalPrice.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></td>
                        <td>
                            <span class="badge" data-bind="css: $parent.getPaymentClass(paymentStatus), text: $parent.getPaymentText(paymentStatus)"></span>
                        </td>
                        <td>
                            <span class="badge" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusClass(status)"></span>
                        </td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <button class="btn btn-outline-info" data-bind="click: $parent.showDetails" title="Detay">
                                    <i class="bi bi-eye"></i>
                                </button>
                                <button class="btn btn-outline-success" data-bind="visible: status === 0, click: function() { $parent.updateStatus($data, 1); }" title="Onayla">
                                    <i class="bi bi-check-lg"></i>
                                </button>
                                <button class="btn btn-outline-danger" data-bind="visible: status === 0 || status === 1, click: function() { $parent.updateStatus($data, 2); }" title="Iptal">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Bos Liste -->
<div data-bind="visible: !isLoading() && reservations().length === 0" class="alert alert-info text-center">
    <i class="bi bi-info-circle"></i> Henuz rezervasyon bulunmamaktadir.
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Rezervasyon Detayi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: selectedReservation">
                <div class="row">
                    <div class="col-md-6">
                        <h6 class="text-muted">Ziyaretci Bilgileri</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Ad Soyad</dt>
                            <dd class="col-sm-8" data-bind="text: visitor ? visitor.firstName + ' ' + visitor.lastName : '-'"></dd>
                            <dt class="col-sm-4">E-posta</dt>
                            <dd class="col-sm-8" data-bind="text: visitor ? visitor.email : '-'"></dd>
                            <dt class="col-sm-4">Telefon</dt>
                            <dd class="col-sm-8" data-bind="text: visitor ? visitor.phone : '-'"></dd>
                        </dl>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted">Tur Bilgileri</h6>
                        <dl class="row">
                            <dt class="col-sm-4">Tur</dt>
                            <dd class="col-sm-8" data-bind="text: tour ? tour.name : '-'"></dd>
                            <dt class="col-sm-4">Firma</dt>
                            <dd class="col-sm-8" data-bind="text: tour && tour.company ? tour.company.name : '-'"></dd>
                            <dt class="col-sm-4">Destinasyon</dt>
                            <dd class="col-sm-8" data-bind="text: tour ? tour.destination : '-'"></dd>
                        </dl>
                    </div>
                </div>
                <hr>
                <dl class="row">
                    <dt class="col-sm-3">Tarih</dt>
                    <dd class="col-sm-9">
                        <span data-bind="text: date + ' ' + (startTime ? startTime.toString().substring(0,5) : '')"></span>
                        <small class="text-muted" data-bind="text: '(' + durationValue + ' ' + $parent.localizeDurationUnit(durationUnit) + ')'"></small>
                    </dd>
                    <dt class="col-sm-3">Kisi Sayisi</dt>
                    <dd class="col-sm-9" data-bind="text: numberOfPeople"></dd>
                    <dt class="col-sm-3">Toplam Fiyat</dt>
                    <dd class="col-sm-9"><span class="badge bg-primary fs-6" data-bind="text: totalPrice.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span></dd>
                    <dt class="col-sm-3">Durum</dt>
                    <dd class="col-sm-9"><span class="badge" data-bind="text: $parent.getStatusText(status), css: $parent.getStatusClass(status)"></span></dd>
                    <dt class="col-sm-3">Notlar</dt>
                    <dd class="col-sm-9" data-bind="text: notes || '-'"></dd>
                </dl>
                <hr>
                <h6 class="text-muted">Odeme Bilgileri</h6>
                <dl class="row">
                    <dt class="col-sm-3">Odeme Durumu</dt>
                    <dd class="col-sm-9"><span class="badge" data-bind="css: $parent.getPaymentClass(paymentStatus), text: $parent.getPaymentText(paymentStatus)"></span></dd>
                    <dt class="col-sm-3">On Odeme</dt>
                    <dd class="col-sm-9" data-bind="text: depositAmount ? depositAmount.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'}) : '-'"></dd>
                    <dt class="col-sm-3">Odenen</dt>
                    <dd class="col-sm-9"><span class="text-success fw-bold" data-bind="text: paidAmount ? paidAmount.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'}) : '-'"></span></dd>
                    <dt class="col-sm-3">Kalan</dt>
                    <dd class="col-sm-9"><span data-bind="css: {'text-danger fw-bold': (totalPrice - (paidAmount || 0)) > 0}, text: (totalPrice - (paidAmount || 0)) > 0 ? (totalPrice - (paidAmount || 0)).toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'}) : 'Tamamlandi'"></span></dd>
                    <dt class="col-sm-3">Odeme Tarihi</dt>
                    <dd class="col-sm-9" data-bind="text: paidAt ? new Date(paidAt).toLocaleString('tr-TR') : '-'"></dd>
                </dl>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script src="~/js/Admin/AdminReservations.js" asp-append-version="true"></script>
}
