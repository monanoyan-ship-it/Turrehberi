<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Admin Panel</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <script>
        // Global T() ve apiBaseUrl - tum script'lerden once tanimlanmali
        var locale = {};
        var apiBaseUrl = '@Html.Raw(ViewBag.ApiBaseUrl ?? "https://localhost:7078")';
        var onLocaleReady = [];
        function T(key) {
            var args = Array.prototype.slice.call(arguments, 1);
            var value = locale[key] || key;
            for (var i = 0; i < args.length; i++) {
                value = value.replace('{' + i + '}', args[i]);
            }
            return value;
        }
    </script>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/Admin"><i class="bi bi-airplane-engines me-2"></i>Admin Panel</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="adminNav">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link" href="/Admin"><i class="bi bi-speedometer2 me-1"></i>Dashboard</a>
                    </li>
                    <li class="nav-item dropdown" id="staffMenu">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Yonetim</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Admin/Tours">Turlar</a></li>
                            <li><a class="dropdown-item" href="/Admin/Companies">Firmalar</a></li>
                            <li><a class="dropdown-item" href="/Admin/Visitors">Kullanicilar</a></li>
                            <li><a class="dropdown-item" href="/Admin/Reservations">Rezervasyonlar</a></li>
                            <li><a class="dropdown-item" href="/Admin/MarketplaceFinance">Marketplace Finans</a></li>
                            <li><a class="dropdown-item" href="/Admin/Reviews">Yorumlar</a></li>
                            <li><a class="dropdown-item" href="/Admin/BlogPosts">Blog Yazilari</a></li>
                            <li><a class="dropdown-item" href="/Admin/Promotions">Promosyonlar</a></li>
                            <li><a class="dropdown-item" href="/Admin/Faqs">SSS</a></li>
                            <li><a class="dropdown-item" href="/Admin/SupportTickets">Destek Mesajlari</a></li>
                        </ul>
                    </li>
                    <li class="nav-item dropdown" id="adminMenu">
                        <a class="nav-link dropdown-toggle" href="#" data-bs-toggle="dropdown">Sistem</a>
                        <ul class="dropdown-menu">
                            <li><a class="dropdown-item" href="/Admin/EmailAccounts">Email Hesaplari</a></li>
                            <li><a class="dropdown-item" href="/Admin/EmailTemplates">Email Sablonlari</a></li>
                            <li><a class="dropdown-item" href="/Admin/Languages">Diller</a></li>
                            <li><a class="dropdown-item" href="/Admin/Settings">Ayarlar</a></li>
                        </ul>
                    </li>
                </ul>
                <div class="d-flex align-items-center">
                    <span class="text-light me-3" id="currentUserName">Admin</span>
                    <a href="/" class="btn btn-outline-light btn-sm">Siteye Don</a>
                </div>
            </div>
        </div>
    </nav>

    <!-- Content -->
    <div class="container-fluid py-4">
        <h4 class="mb-4">@ViewData["Title"]</h4>
        @RenderBody()
    </div>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/knockout/knockout-latest.min.js"></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script>
        toastr.options = { "closeButton": true, "progressBar": true, "positionClass": "toast-top-right", "timeOut": "3000" };

        // Auth setup - tum AJAX cagrilarindan ONCE ayarlanmali
        var currentUserRole = '@(ViewBag.UserRole ?? "Admin")';
        window.currentUser = null;
        (function() {
            var token = localStorage.getItem('token');
            if (!token) {
                window.location.href = '/Account/Login?returnUrl=' + encodeURIComponent(window.location.pathname + window.location.search);
                return;
            }
            $.ajaxSetup({
                headers: { 'Authorization': 'Bearer ' + token }
            });
            var userStr = localStorage.getItem('user');
            if (userStr) {
                try {
                    window.currentUser = JSON.parse(userStr);
                } catch(e) {}
            }
            if (!window.currentUser || Number(window.currentUser.userTypeId) < 2) {
                window.location.href = '/Account/AccessDenied';
            }
        })();

        // Global 401/403 handler - token suresi dolduysa veya rol yetmezse yonlendir
        $(document).ajaxError(function(event, xhr) {
            if (xhr.status === 401) {
                localStorage.removeItem('token');
                localStorage.removeItem('user');
                toastr.error(T('Error.SessionExpired') || 'Oturum suresi doldu, giris yapiniz');
                setTimeout(function() { window.location.href = '/Account/Logout'; }, 1500);
            } else if (xhr.status === 403) {
                toastr.error(T('Error.AccessDenied') || 'Bu islem icin yetkiniz yok');
                setTimeout(function() { window.location.href = '/Account/AccessDenied'; }, 1000);
            }
        });

        // Locale yukle
        var currentLang = localStorage.getItem('lang') || 'tr';
        $.ajax({
            url: apiBaseUrl + '/api/localization/' + currentLang,
            method: 'GET',
            success: function(data) {
                locale = data;
                for (var i = 0; i < onLocaleReady.length; i++) {
                    try { onLocaleReady[i](); } catch(e) {}
                }
            }
        });

        // DOM hazir olunca UI guncelle
        $(document).ready(function() {
            if (window.currentUser) {
                $('#currentUserName').text(window.currentUser.firstName + ' ' + window.currentUser.lastName);
            }
            if (currentUserRole === 'Staff') {
                $('#adminMenu').hide();
            }
        });
    </script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
