<!DOCTYPE html>
<html lang="tr" dir="ltr" id="htmlRoot">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] ?? "Ana Sayfa") - Erkan Tatil Plani</title>

    <!-- Default Meta Tags -->
    <meta name="description" content="@(ViewData["Description"] ?? "Erkan Tatil Plani - Turkiye'nin en guvenilir tur rezervasyon sistemi. En iyi firmalarin en uygun turlarini kesfedin, hayalinizdeki tatile kavusun!")" />
    <meta name="keywords" content="tur, tatil, rezervasyon, seyahat, gezi, Turkiye turlari, yurt disi turlari, tur firmalari" />
    <meta name="author" content="Erkan Tatil Plani" />
    <meta name="robots" content="index, follow" />

    <!-- Canonical URL -->
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] ?? Context.Request.GetDisplayUrl())" />

    <!-- Open Graph Meta Tags -->
    <meta property="og:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"] ?? "Erkan Tatil Plani")" />
    <meta property="og:description" content="@(ViewData["OgDescription"] ?? ViewData["Description"] ?? "Turkiye'nin en guvenilir tur rezervasyon sistemi. En iyi firmalarin en uygun turlarini kesfedin!")" />
    <meta property="og:image" content="@(ViewData["OgImage"] ?? "/images/og-default.jpg")" />
    <meta property="og:url" content="@(ViewData["CanonicalUrl"] ?? Context.Request.GetDisplayUrl())" />
    <meta property="og:type" content="@(ViewData["OgType"] ?? "website")" />
    <meta property="og:site_name" content="Erkan Tatil Plani" />
    <meta property="og:locale" content="tr_TR" />

    <!-- Twitter Card Meta Tags -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@(ViewData["OgTitle"] ?? ViewData["Title"] ?? "Erkan Tatil Plani")" />
    <meta name="twitter:description" content="@(ViewData["OgDescription"] ?? ViewData["Description"] ?? "Turkiye'nin en guvenilir tur rezervasyon sistemi.")" />
    <meta name="twitter:image" content="@(ViewData["OgImage"] ?? "/images/og-default.jpg")" />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    @await RenderSectionAsync("Head", required: false)

    <link rel="stylesheet" href="~/lib/bootstrap/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/lib/toastr/toastr.min.css" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        .top-ad-banner {
            background: linear-gradient(90deg, #ff6b6b 0%, #ffa500 50%, #ff6b6b 100%);
            background-size: 200% 100%;
            animation: gradientMove 3s ease infinite;
            padding: 8px 0;
            font-weight: 500;
        }
        @@keyframes gradientMove {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }
        .modern-navbar {
            background: rgba(255, 255, 255, 0.95) !important;
            backdrop-filter: blur(10px);
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
        }
        .modern-navbar .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
        }
        .modern-navbar .nav-link {
            font-weight: 500;
            padding: 0.5rem 1rem !important;
            border-radius: 8px;
            margin: 0 2px;
            transition: all 0.3s ease;
        }
        .modern-navbar .nav-link:hover {
            background: rgba(13, 110, 253, 0.1);
        }
        .modern-navbar .nav-link.active {
            background: #0d6efd;
            color: white !important;
        }
        .lang-flag {
            font-size: 1.2rem;
            margin-right: 6px;
        }
        [dir="rtl"] .me-1 { margin-right: 0 !important; margin-left: 0.25rem !important; }
        [dir="rtl"] .me-2 { margin-right: 0 !important; margin-left: 0.5rem !important; }
        [dir="rtl"] .ms-1 { margin-left: 0 !important; margin-right: 0.25rem !important; }
        [dir="rtl"] .ms-2 { margin-left: 0 !important; margin-right: 0.5rem !important; }
        [dir="rtl"] .text-start { text-align: right !important; }
        [dir="rtl"] .text-end { text-align: left !important; }
    </style>
</head>
<body>
    <!-- Top Advertisement Banner -->
    <div id="topAdBanner" class="top-ad-banner text-white text-center">
        <div class="container">
            <a href="/Tours" class="text-white text-decoration-none">
                <i class="bi bi-megaphone-fill me-2"></i>
                <span id="adText" data-t="Common.Loading"></span>
            </a>
        </div>
    </div>

    <header class="sticky-top">
        <nav class="navbar navbar-expand-lg modern-navbar">
            <div class="container">
                <a class="navbar-brand text-primary" href="/">
                    <i class="bi bi-airplane-engines"></i> Erkan Tatil Plani
                </a>
                <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/"><i class="bi bi-house-door me-1"></i><span data-t="Menu.Home">Ana Sayfa</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Tours"><i class="bi bi-geo-alt me-1"></i><span data-t="Menu.Tours">Turlar</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Companies"><i class="bi bi-building me-1"></i><span data-t="Menu.Companies">Firmalar</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Blog"><i class="bi bi-journal-richtext me-1"></i><span data-t="Menu.Blog">Blog</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Home/About"><i class="bi bi-info-circle me-1"></i><span data-t="Menu.About">Hakkimizda</span></a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-dark" href="/Home/Contact"><i class="bi bi-envelope me-1"></i><span data-t="Menu.Contact">Iletisim</span></a>
                        </li>
                    </ul>
                </div>
                <div class="d-none d-lg-flex align-items-center gap-2">
                    <!-- Dil Secici -->
                    <div class="dropdown me-2">
                        <button class="btn btn-outline-secondary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <span id="currentLangFlag"></span>
                            <span id="currentLangName">TR</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end" id="languageMenu">
                            <!-- Dinamik olarak doldurulacak -->
                        </ul>
                    </div>
                    <!-- Bildirim Zili (Sadece giris yapmis kullanicilar) -->
                    <div id="notificationBell" class="dropdown me-2" style="display: none;">
                        <button class="btn btn-outline-secondary btn-sm position-relative" type="button" data-bs-toggle="dropdown" aria-expanded="false" id="notificationBellBtn">
                            <i class="bi bi-bell"></i>
                            <span id="notificationBadge" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" style="display: none; font-size: 0.6rem;">
                                0
                            </span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end p-0" style="width: 320px; max-height: 400px;" id="notificationDropdown">
                            <div class="d-flex justify-content-between align-items-center px-3 py-2 border-bottom">
                                <strong data-t="Notification.Title">Bildirimler</strong>
                                <button class="btn btn-link btn-sm text-decoration-none p-0" onclick="markAllNotificationsRead()" data-t="Notification.MarkAllRead">Tumunu Okundu Isaretle</button>
                            </div>
                            <div id="notificationList" class="overflow-auto" style="max-height: 300px;">
                                <div class="text-center text-muted py-3" data-t="Notification.Empty">Bildiriminiz bulunmuyor</div>
                            </div>
                            <div class="border-top text-center py-2">
                                <a href="/Account/Notifications" class="text-decoration-none small" data-t="Notification.ViewAll">Tumunu Gor</a>
                            </div>
                        </div>
                    </div>
                    <!-- Auth Buttons -->
                    <div id="authButtons">
                        <!-- Giris yapilmamis durum -->
                        <div id="notLoggedIn">
                            <a href="/Account/Login" class="btn btn-outline-primary btn-sm">
                                <i class="bi bi-box-arrow-in-right me-1"></i><span data-t="Menu.Login">Giris Yap</span>
                            </a>
                            <a href="/Account/Register" class="btn btn-primary btn-sm">
                                <i class="bi bi-person-plus me-1"></i><span data-t="Menu.Register">Kayit Ol</span>
                            </a>
                        </div>
                        <!-- Giris yapilmis durum -->
                        <div id="loggedIn" style="display: none;">
                            <div class="dropdown">
                                <button class="btn btn-outline-primary btn-sm dropdown-toggle" type="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-person-circle me-1"></i>
                                    <span id="userName">Kullanici</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><span class="dropdown-item-text small text-muted" id="userEmail"></span></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" href="/Account/Profile"><i class="bi bi-person me-2"></i><span data-t="Menu.Profile">Profilim</span></a></li>
                                    <li><a class="dropdown-item" href="/Account/Reservations"><i class="bi bi-calendar-check me-2"></i><span data-t="Menu.MyReservations">Rezervasyonlarim</span></a></li>
                                    <li id="adminMenuItem" style="display: none;"><a class="dropdown-item" href="/Admin"><i class="bi bi-gear me-2"></i><span data-t="Menu.AdminPanel">Yonetim Paneli</span></a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item text-danger" href="#" onclick="logout()"><i class="bi bi-box-arrow-right me-2"></i><span data-t="Menu.Logout">Cikis Yap</span></a></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <div class="container mt-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted py-4 mt-5 bg-dark text-white">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5><i class="bi bi-airplane-engines"></i> Erkan Tatil Plani</h5>
                    <p class="text-muted small">Turkiye'nin en guvenilir tur rezervasyon sistemi. En iyi firmalarin en uygun turlarini kesfedin.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6>Hizli Erisim</h6>
                    <ul class="list-unstyled small">
                        <li><a href="/Tours" class="text-muted text-decoration-none" data-t="Menu.Tours">Turlar</a></li>
                        <li><a href="/Companies" class="text-muted text-decoration-none" data-t="Menu.Companies">Firmalar</a></li>
                        <li><a href="/Blog" class="text-muted text-decoration-none" data-t="Menu.Blog">Blog</a></li>
                        <li><a href="/Home/About" class="text-muted text-decoration-none" data-t="Menu.About">Hakkimizda</a></li>
                        <li><a href="/Home/Contact" class="text-muted text-decoration-none" data-t="Menu.Contact">Iletisim</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 data-t="Footer.Contact">Iletisim</h6>
                    <p class="text-muted small mb-1"><i class="bi bi-envelope me-2"></i>info@erkantatilplani.com</p>
                    <p class="text-muted small"><i class="bi bi-telephone me-2"></i>+90 555 123 4567</p>
                </div>
            </div>
            <hr class="my-3 border-secondary">
            <div class="text-center text-muted small">
                &copy; 2026 - Erkan Tatil Plani - <span data-t="Footer.Rights">Tum Haklari Saklidir</span>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/jquery.min.js"></script>
    <script src="~/lib/bootstrap/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/knockout/knockout-latest.min.js"></script>
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/lib/toastr/toastr.min.js"></script>
    <script>
        // ===============================================
        // LOCALIZATION SYSTEM
        // ===============================================
        var locale = {};
        var currentLang = localStorage.getItem('lang') || 'tr';
        var availableLanguages = [];

        // T() function - translate key to current language
        function T(key, ...args) {
            var value = locale[key] || key;
            if (args.length > 0) {
                args.forEach((arg, i) => {
                    value = value.replace('{' + i + '}', arg);
                });
            }
            return value;
        }

        // Load locale from API
        function loadLocale(lang, callback) {
            $.ajax({
                url: apiBaseUrl + '/api/localization/' + lang,
                method: 'GET',
                success: function(data) {
                    locale = data;
                    currentLang = lang;
                    localStorage.setItem('lang', lang);
                    applyTranslations();
                    if (callback) callback();
                },
                error: function() {
                    console.warn('Locale not found:', lang);
                    if (lang !== 'tr') loadLocale('tr', callback);
                }
            });
        }

        // Apply translations to all data-t elements
        function applyTranslations() {
            $('[data-t]').each(function() {
                var key = $(this).data('t');
                var translated = T(key);
                if ($(this).is('input')) {
                    $(this).attr('placeholder', translated);
                } else {
                    $(this).text(translated);
                }
            });
        }

        // Load available languages
        function loadLanguages() {
            $.ajax({
                url: apiBaseUrl + '/api/localization/languages',
                method: 'GET',
                success: function(languages) {
                    availableLanguages = languages;
                    renderLanguageMenu();
                    updateCurrentLangDisplay();
                }
            });
        }

        // Render language dropdown menu
        function renderLanguageMenu() {
            var menu = $('#languageMenu');
            menu.empty();
            availableLanguages.forEach(function(lang) {
                var item = $('<li><a class="dropdown-item" href="#" data-lang="' + lang.code + '">' +
                    '<span class="lang-flag">' + lang.flagEmoji + '</span>' + lang.nativeName + '</a></li>');
                item.find('a').on('click', function(e) {
                    e.preventDefault();
                    changeLanguage(lang.code);
                });
                menu.append(item);
            });
        }

        // Update current language display
        function updateCurrentLangDisplay() {
            var lang = availableLanguages.find(l => l.code === currentLang);
            if (lang) {
                $('#currentLangFlag').text(lang.flagEmoji);
                $('#currentLangName').text(lang.code.toUpperCase());
                // RTL support
                if (lang.isRtl) {
                    $('#htmlRoot').attr('dir', 'rtl');
                } else {
                    $('#htmlRoot').attr('dir', 'ltr');
                }
            }
        }

        // Change language
        function changeLanguage(lang) {
            loadLocale(lang, function() {
                updateCurrentLangDisplay();
                // Save to DB if logged in
                if (isLoggedIn()) {
                    saveLanguagePreference(lang);
                }
                // Trigger custom event for pages to react
                $(document).trigger('languageChanged', [lang]);
            });
        }

        // Save language preference to database
        function saveLanguagePreference(lang) {
            $.ajax({
                url: apiBaseUrl + '/api/auth/language',
                method: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ language: lang }),
                success: function() {
                    // Update local user object
                    var user = getUser();
                    if (user) {
                        user.preferredLanguage = lang;
                        localStorage.setItem('user', JSON.stringify(user));
                    }
                }
            });
        }

        // Load user's preferred language after login
        function loadUserLanguagePreference() {
            var user = getUser();
            if (user && user.preferredLanguage && user.preferredLanguage !== currentLang) {
                changeLanguage(user.preferredLanguage);
            }
        }

        // ===============================================
        // TOASTR & API CONFIG
        // ===============================================
        toastr.options = {
            "closeButton": true,
            "progressBar": true,
            "positionClass": "toast-top-right",
            "timeOut": "3000"
        };

        var apiBaseUrl = '@Html.Raw(ViewBag.ApiBaseUrl ?? "https://localhost:7078")';

        // ===============================================
        // AUTH FUNCTIONS
        // ===============================================
        function getToken() { return localStorage.getItem('token'); }
        function getUser() {
            var u = localStorage.getItem('user');
            return u ? JSON.parse(u) : null;
        }
        function isLoggedIn() { return !!getToken(); }

        function logout() {
            localStorage.removeItem('token');
            localStorage.removeItem('user');
            toastr.info(T('Menu.Logout'));
            window.location.href = '/';
        }

        function updateAuthUI() {
            var user = getUser();
            if (user) {
                $('#notLoggedIn').hide();
                $('#loggedIn').show();
                $('#userName').text(user.firstName + ' ' + user.lastName);
                $('#userEmail').text(user.email);
                if (user.userTypeId >= 1) {
                    $('#adminMenuItem').show();
                }
                // Bildirim zili goster ve yukle
                $('#notificationBell').show();
                loadNotificationCount();
            } else {
                $('#notLoggedIn').show();
                $('#loggedIn').hide();
                $('#notificationBell').hide();
            }
        }

        // ===============================================
        // BILDIRIM SISTEMI
        // ===============================================
        function loadNotificationCount() {
            $.ajax({
                url: apiBaseUrl + '/api/notifications/unread-count',
                method: 'GET'
            }).done(function(data) {
                var count = data.count || 0;
                if (count > 0) {
                    $('#notificationBadge').text(count > 99 ? '99+' : count).show();
                } else {
                    $('#notificationBadge').hide();
                }
            });
        }

        function loadNotificationDropdown() {
            $.ajax({
                url: apiBaseUrl + '/api/notifications?page=1&pageSize=5',
                method: 'GET'
            }).done(function(data) {
                var list = $('#notificationList');
                if (!data.notifications || data.notifications.length === 0) {
                    list.html('<div class="text-center text-muted py-3">' + T('Notification.Empty') + '</div>');
                    return;
                }
                var html = '';
                data.notifications.forEach(function(n) {
                    var icon = n.notificationIcon || 'bi-bell';
                    var css = n.notificationCss || 'bg-secondary';
                    var title = T(n.titleKey) || n.titleKey;
                    var msg = T(n.messageKey) || n.messageKey;
                    if (n.messageParams) {
                        try {
                            var params = JSON.parse(n.messageParams);
                            Object.keys(params).forEach(function(k) {
                                msg = msg.replace('{' + k + '}', params[k]);
                            });
                        } catch(e) {}
                    }
                    var readClass = n.isRead ? 'opacity-50' : '';
                    var ago = timeAgo(n.createdAt);
                    html += '<a href="#" class="dropdown-item border-bottom px-3 py-2 ' + readClass + '" onclick="markNotificationRead(' + n.id + ', this)">' +
                        '<div class="d-flex align-items-start">' +
                        '<span class="badge ' + css + ' me-2 mt-1"><i class="bi ' + icon + '"></i></span>' +
                        '<div class="flex-grow-1">' +
                        '<div class="fw-semibold small">' + title + '</div>' +
                        '<div class="text-muted small text-wrap">' + msg + '</div>' +
                        '<div class="text-muted small">' + ago + '</div>' +
                        '</div></div></a>';
                });
                list.html(html);
            });
        }

        function markNotificationRead(id, el) {
            $.ajax({
                url: apiBaseUrl + '/api/notifications/' + id + '/read',
                method: 'PUT'
            }).done(function() {
                if (el) $(el).addClass('opacity-50');
                loadNotificationCount();
            });
        }

        function markAllNotificationsRead() {
            $.ajax({
                url: apiBaseUrl + '/api/notifications/read-all',
                method: 'PUT'
            }).done(function() {
                loadNotificationCount();
                loadNotificationDropdown();
                toastr.success(T('Notification.MarkAllRead'));
            });
        }

        function timeAgo(dateStr) {
            var now = new Date();
            var date = new Date(dateStr);
            var diff = Math.floor((now - date) / 1000);
            if (diff < 60) return diff + 's';
            if (diff < 3600) return Math.floor(diff/60) + 'm';
            if (diff < 86400) return Math.floor(diff/3600) + 'h';
            return Math.floor(diff/86400) + 'd';
        }

        // Dropdown acildiginda bildirimleri yukle
        $(document).on('show.bs.dropdown', '#notificationBell', function() {
            loadNotificationDropdown();
        });

        // Add auth header to all AJAX requests
        $.ajaxSetup({
            beforeSend: function(xhr) {
                var token = getToken();
                if (token) {
                    xhr.setRequestHeader('Authorization', 'Bearer ' + token);
                }
            }
        });

        // ===============================================
        // LAZY LOADING & IMAGE OPTIMIZATION
        // ===============================================
        var LazyLoad = {
            observer: null,

            // Initialize Intersection Observer for lazy loading
            init: function() {
                if ('IntersectionObserver' in window) {
                    this.observer = new IntersectionObserver(this.onIntersect.bind(this), {
                        rootMargin: '50px 0px',
                        threshold: 0.01
                    });
                    this.observeImages();
                } else {
                    // Fallback for older browsers
                    this.loadAllImages();
                }
            },

            // Observe all lazy images
            observeImages: function() {
                var images = document.querySelectorAll('img[data-src]');
                images.forEach(function(img) {
                    this.observer.observe(img);
                }.bind(this));
            },

            // Handle intersection
            onIntersect: function(entries, observer) {
                entries.forEach(function(entry) {
                    if (entry.isIntersecting) {
                        this.loadImage(entry.target);
                        observer.unobserve(entry.target);
                    }
                }.bind(this));
            },

            // Load single image
            loadImage: function(img) {
                var src = img.getAttribute('data-src');
                if (!src) return;

                img.classList.add('lazy-img');

                var newImg = new Image();
                newImg.onload = function() {
                    img.src = src;
                    img.classList.add('loaded', 'fade-in-img');
                    img.removeAttribute('data-src');
                };
                newImg.onerror = function() {
                    img.classList.add('img-error-fallback');
                    img.alt = 'Resim yuklenemedi';
                };
                newImg.src = src;
            },

            // Fallback: load all images immediately
            loadAllImages: function() {
                var images = document.querySelectorAll('img[data-src]');
                images.forEach(function(img) {
                    this.loadImage(img);
                }.bind(this));
            },

            // Refresh observer (call after dynamic content loads)
            refresh: function() {
                if (this.observer) {
                    this.observeImages();
                }
            }
        };

        // KnockoutJS custom binding for lazy images
        if (typeof ko !== 'undefined') {
            ko.bindingHandlers.lazyImage = {
                init: function(element, valueAccessor) {
                    var value = ko.unwrap(valueAccessor());
                    if (value) {
                        element.setAttribute('data-src', value);
                        element.classList.add('lazy-img');
                        // Use native lazy loading as primary
                        element.setAttribute('loading', 'lazy');
                        // Set placeholder
                        element.src = 'data:image/svg+xml,%3Csvg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 300"%3E%3Crect fill="%23f0f0f0" width="400" height="300"/%3E%3C/svg%3E';
                    }
                },
                update: function(element, valueAccessor) {
                    var value = ko.unwrap(valueAccessor());
                    if (value) {
                        element.setAttribute('data-src', value);
                        // Load if in viewport
                        if (LazyLoad.observer) {
                            LazyLoad.observer.observe(element);
                        } else {
                            element.src = value;
                            element.classList.add('loaded');
                        }
                    }
                }
            };
        }

        // Helper function to add loading="lazy" to img elements
        function initNativeLazyLoading() {
            // Modern browsers support native lazy loading
            if ('loading' in HTMLImageElement.prototype) {
                var images = document.querySelectorAll('img:not([loading])');
                images.forEach(function(img) {
                    // Only add lazy loading to images below the fold
                    if (!img.closest('.carousel-inner')) {
                        img.setAttribute('loading', 'lazy');
                    }
                });
            }
        }

        // ===============================================
        // SOCIAL SHARE UTILITY
        // ===============================================
        var SocialShare = {
            // Share URLs for different platforms
            platforms: {
                facebook: 'https://www.facebook.com/sharer/sharer.php?u={url}',
                twitter: 'https://twitter.com/intent/tweet?url={url}&text={text}',
                whatsapp: 'https://wa.me/?text={text}%20{url}',
                telegram: 'https://t.me/share/url?url={url}&text={text}',
                linkedin: 'https://www.linkedin.com/sharing/share-offsite/?url={url}',
                pinterest: 'https://pinterest.com/pin/create/button/?url={url}&description={text}'
            },

            // Open share popup
            openPopup: function(url, width, height) {
                width = width || 600;
                height = height || 400;
                var left = (screen.width / 2) - (width / 2);
                var top = (screen.height / 2) - (height / 2);
                window.open(url, 'share', 'width=' + width + ',height=' + height + ',left=' + left + ',top=' + top);
            },

            // Share to platform
            share: function(platform, url, text) {
                url = url || window.location.href;
                text = text || document.title;

                var shareUrl = this.platforms[platform];
                if (!shareUrl) {
                    console.warn('Unknown platform:', platform);
                    return;
                }

                shareUrl = shareUrl
                    .replace('{url}', encodeURIComponent(url))
                    .replace('{text}', encodeURIComponent(text));

                this.openPopup(shareUrl);
            },

            // Copy link to clipboard
            copyLink: function(url, callback) {
                url = url || window.location.href;

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(url).then(function() {
                        toastr.success(T('Share.LinkCopied'));
                        if (callback) callback(true);
                    }).catch(function() {
                        // Fallback
                        SocialShare.copyLinkFallback(url, callback);
                    });
                } else {
                    this.copyLinkFallback(url, callback);
                }
            },

            // Fallback copy method
            copyLinkFallback: function(url, callback) {
                var textArea = document.createElement('textarea');
                textArea.value = url;
                textArea.style.position = 'fixed';
                textArea.style.left = '-999999px';
                document.body.appendChild(textArea);
                textArea.select();
                try {
                    document.execCommand('copy');
                    toastr.success(T('Share.LinkCopied'));
                    if (callback) callback(true);
                } catch (err) {
                    toastr.error(T('Share.CopyFailed'));
                    if (callback) callback(false);
                }
                document.body.removeChild(textArea);
            },

            // Native share (mobile)
            nativeShare: function(title, text, url) {
                if (navigator.share) {
                    navigator.share({
                        title: title || document.title,
                        text: text || '',
                        url: url || window.location.href
                    }).catch(function(err) {
                        if (err.name !== 'AbortError') {
                            console.warn('Share failed:', err);
                        }
                    });
                    return true;
                }
                return false;
            },

            // Render share buttons (returns HTML)
            renderButtons: function(options) {
                options = options || {};
                var url = options.url || window.location.href;
                var text = options.text || document.title;
                var size = options.size || 'sm'; // sm, md, lg
                var platforms = options.platforms || ['facebook', 'twitter', 'whatsapp', 'telegram', 'linkedin', 'copy'];

                var icons = {
                    facebook: 'bi-facebook',
                    twitter: 'bi-twitter-x',
                    whatsapp: 'bi-whatsapp',
                    telegram: 'bi-telegram',
                    linkedin: 'bi-linkedin',
                    pinterest: 'bi-pinterest',
                    copy: 'bi-link-45deg'
                };

                var colors = {
                    facebook: 'btn-primary',
                    twitter: 'btn-dark',
                    whatsapp: 'btn-success',
                    telegram: 'btn-info',
                    linkedin: 'btn-primary',
                    pinterest: 'btn-danger',
                    copy: 'btn-secondary'
                };

                var labels = {
                    facebook: 'Facebook',
                    twitter: 'X',
                    whatsapp: 'WhatsApp',
                    telegram: 'Telegram',
                    linkedin: 'LinkedIn',
                    pinterest: 'Pinterest',
                    copy: T('Share.CopyLink')
                };

                var html = '<div class="share-buttons d-flex flex-wrap gap-2">';
                platforms.forEach(function(platform) {
                    var btnClass = 'btn btn-' + size + ' ' + colors[platform];
                    var icon = icons[platform];
                    var label = labels[platform];
                    var onclick = platform === 'copy'
                        ? "SocialShare.copyLink('" + url.replace(/'/g, "\\'") + "')"
                        : "SocialShare.share('" + platform + "', '" + url.replace(/'/g, "\\'") + "', '" + text.replace(/'/g, "\\'") + "')";

                    html += '<button type="button" class="' + btnClass + '" onclick="' + onclick + '" title="' + label + '">';
                    html += '<i class="bi ' + icon + '"></i>';
                    if (size !== 'sm') html += ' <span class="d-none d-md-inline">' + label + '</span>';
                    html += '</button>';
                });
                html += '</div>';

                return html;
            }
        };

        // ===============================================
        // INIT
        // ===============================================
        $(document).ready(function() {
            // Initialize lazy loading
            LazyLoad.init();
            initNativeLazyLoading();
            // Load languages and locale
            loadLanguages();

            // Check if user is logged in and has a preferred language
            var user = getUser();
            var langToLoad = (user && user.preferredLanguage) ? user.preferredLanguage : currentLang;

            loadLocale(langToLoad, function() {
                // Top Ad Banner - Fetch featured tour
                $.ajax({
                    url: apiBaseUrl + '/api/tours/featured',
                    method: 'GET',
                    success: function(tours) {
                        if (tours && tours.length > 0) {
                            var randomTour = tours[Math.floor(Math.random() * tours.length)];
                            var adText = '<i class="bi bi-fire me-1"></i> <strong>' + randomTour.name + '</strong> - ' + randomTour.destination + ' ' + T('Tour.Price') + ': ' + randomTour.price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'}) + '! <i class="bi bi-arrow-right"></i>';
                            $('#adText').html(adText);
                        }
                    }
                });
            });

            updateAuthUI();

            // Active nav link
            var path = window.location.pathname;
            $('.navbar-nav .nav-link').each(function() {
                if ($(this).attr('href') === path) {
                    $(this).addClass('active');
                }
            });
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
