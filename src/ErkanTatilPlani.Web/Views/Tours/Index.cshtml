@{
    ViewData["Title"] = "Turlar";
    ViewData["Description"] = "Turkiye ve yurt disi turlari listesi. En uygun fiyatlarla tatil firsatlari, sehir turlari, kultur gezileri ve daha fazlasi. Simdi kesfedin!";
    ViewData["OgTitle"] = "Turlar - Erkan Tatil Plani";
    ViewData["OgDescription"] = "En iyi tur firsatlarini kesfedin. Fiyat, destinasyon ve sure filtreleri ile size uygun turu bulun!";
    ViewData["OgType"] = "website";
}

@section Head {
    <!-- Tours Page Schema.org JSON-LD -->
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "CollectionPage",
        "name": "Turlar",
        "description": "Turkiye ve yurt disi turlari listesi",
        "url": "@Context.Request.GetDisplayUrl()",
        "isPartOf": {
            "@@type": "WebSite",
            "name": "Erkan Tatil Plani"
        }
    }
    </script>
}

<div id="toursApp">
<div class="mb-4">
    <h1><i class="bi bi-geo-alt"></i> <span data-t="Menu.Tours">Turlar</span></h1>
    <p class="text-muted" data-t="Tours.Subtitle">Sizin icin en uygun turu secin ve hayalinizdeki tatile baslayin!</p>
</div>

<!-- Kategori Kartlari -->
<div class="mb-4" data-bind="visible: categories().length > 0">
    <div class="d-flex flex-wrap gap-2 justify-content-center">
        <button class="btn btn-outline-secondary rounded-pill" data-bind="click: function() { filterCategory(''); applyFilters(); }, css: { 'active btn-secondary text-white': !filterCategory() }">
            <i class="bi bi-grid-3x3-gap me-1"></i> <span data-t="Tours.AllCategories">Tum Kategoriler</span>
        </button>
        <!-- ko foreach: categories -->
        <button class="btn rounded-pill" data-bind="click: function() { $parent.filterCategory(id.toString()); $parent.applyFilters(); },
            css: $parent.filterCategory() == id.toString() ? 'btn-' + (cssClass || 'secondary').replace('bg-', '').replace(' text-dark', '') + ' text-white' : 'btn-outline-secondary'">
            <i class="bi" data-bind="css: icon"></i>
            <span data-bind="text: T(nameResourceKey) || systemName"></span>
        </button>
        <!-- /ko -->
    </div>
</div>

<!-- Arama ve Filtreler -->
<div class="card shadow-sm mb-4">
    <div class="card-body">
        <!-- Arama Kutusu -->
        <div class="row mb-3">
            <div class="col-12">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-primary text-white"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" data-bind="value: searchQuery, valueUpdate: 'afterkeydown'"
                           data-t-placeholder="Tours.SearchPlaceholder" placeholder="Tur ara (isim, destinasyon, aciklama)..." />
                    <button class="btn btn-outline-secondary" type="button" data-bind="click: clearSearch, visible: searchQuery()">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Filtre Toggle -->
        <div class="d-flex justify-content-between align-items-center mb-3">
            <button class="btn btn-outline-primary" type="button" data-bs-toggle="collapse" data-bs-target="#filterPanel">
                <i class="bi bi-funnel"></i> <span data-t="Tours.AdvancedFilters">Gelismis Filtreler</span>
                <span class="badge bg-primary ms-1" data-bind="visible: activeFilterCount() > 0, text: activeFilterCount()"></span>
            </button>
            <div class="d-flex align-items-center gap-2">
                <!-- View Toggle -->
                <div class="btn-group me-2" role="group">
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            data-bind="css: { active: viewMode() === 'list' }, click: function() { setViewMode('list'); }">
                        <i class="bi bi-list-ul"></i> <span data-t="Tours.ListView">Liste</span>
                    </button>
                    <button type="button" class="btn btn-outline-primary btn-sm"
                            data-bind="css: { active: viewMode() === 'map' }, click: function() { setViewMode('map'); }">
                        <i class="bi bi-map"></i> <span data-t="Tours.MapView">Harita</span>
                    </button>
                </div>
                <label class="text-muted small mb-0" data-t="Tours.SortBy">Sirala:</label>
                <select class="form-select form-select-sm" style="width: auto;" data-bind="value: sortBy">
                    <option value="" data-t="Tours.SortDefault">Varsayilan</option>
                    <option value="price_asc" data-t="Tours.SortPriceAsc">Fiyat (Dusuk-Yuksek)</option>
                    <option value="price_desc" data-t="Tours.SortPriceDesc">Fiyat (Yuksek-Dusuk)</option>
                    <option value="duration_asc" data-t="Tours.SortDurationAsc">Sure (Kisa-Uzun)</option>
                    <option value="duration_desc" data-t="Tours.SortDurationDesc">Sure (Uzun-Kisa)</option>
                    <option value="rating" data-t="Tours.SortRating">En Yuksek Puan</option>
                    <option value="newest" data-t="Tours.SortNewest">En Yeni</option>
                </select>
            </div>
        </div>

        <!-- Filtre Paneli -->
        <div class="collapse" id="filterPanel">
            <div class="row g-3 pt-3 border-top">
                <!-- Destinasyon -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold"><i class="bi bi-geo-alt"></i> <span data-t="Tour.Destination">Destinasyon</span></label>
                    <select class="form-select" data-bind="value: filterDestination, options: destinations, optionsCaption: T('Tours.AllDestinations')"></select>
                </div>

                <!-- Fiyat Araligi -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold"><i class="bi bi-currency-lira"></i> <span data-t="Tours.PriceRange">Fiyat Araligi</span></label>
                    <div class="d-flex gap-2">
                        <input type="number" class="form-control form-control-sm" data-bind="value: filterMinPrice"
                               data-t-placeholder="Common.Min" placeholder="Min" min="0" />
                        <input type="number" class="form-control form-control-sm" data-bind="value: filterMaxPrice"
                               data-t-placeholder="Common.Max" placeholder="Max" min="0" />
                    </div>
                </div>

                <!-- Sure Araligi -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold"><i class="bi bi-calendar3"></i> <span data-t="Tours.Duration">Sure (Gun)</span></label>
                    <div class="d-flex gap-2">
                        <input type="number" class="form-control form-control-sm" data-bind="value: filterMinDays"
                               data-t-placeholder="Common.Min" placeholder="Min" min="1" />
                        <input type="number" class="form-control form-control-sm" data-bind="value: filterMaxDays"
                               data-t-placeholder="Common.Max" placeholder="Max" min="1" />
                    </div>
                </div>

                <!-- Firma -->
                <div class="col-md-2">
                    <label class="form-label small fw-semibold"><i class="bi bi-building"></i> <span data-t="Tour.Company">Firma</span></label>
                    <select class="form-select" data-bind="value: filterCompanyId, options: companies, optionsText: 'name', optionsValue: 'id', optionsCaption: T('Tours.AllCompanies')"></select>
                </div>

                <!-- One Cikanlar -->
                <div class="col-md-2 d-flex align-items-end">
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" id="filterFeatured" data-bind="checked: filterFeatured" />
                        <label class="form-check-label" for="filterFeatured">
                            <i class="bi bi-star-fill text-warning"></i> <span data-t="Tours.FeaturedOnly">Sadece One Cikan</span>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Ek Filtreler (Zorluk, Kategori, Rehber Dili) -->
            <div class="row g-3 pt-3">
                <!-- Zorluk Seviyesi -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold"><i class="bi bi-speedometer2"></i> <span data-t="Tours.FilterDifficulty">Zorluk Seviyesi</span></label>
                    <select class="form-select" data-bind="value: filterDifficulty">
                        <option value="" data-t="Tours.AllDifficulties">Tum Zorluklar</option>
                        <option value="0" data-t="TourDifficulty.Easy">Kolay</option>
                        <option value="1" data-t="TourDifficulty.Moderate">Orta</option>
                        <option value="2" data-t="TourDifficulty.Challenging">Zor</option>
                        <option value="3" data-t="TourDifficulty.Expert">Uzman</option>
                    </select>
                </div>

                <!-- Kategori -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold"><i class="bi bi-tag"></i> <span data-t="Tours.FilterCategory">Kategori</span></label>
                    <select class="form-select" data-bind="value: filterCategory">
                        <option value="" data-t="Tours.AllCategories">Tum Kategoriler</option>
                        <!-- ko foreach: categories -->
                        <option data-bind="value: id, text: T(nameResourceKey) || systemName"></option>
                        <!-- /ko -->
                    </select>
                </div>

                <!-- Rehber Dili -->
                <div class="col-md-3">
                    <label class="form-label small fw-semibold"><i class="bi bi-translate"></i> <span data-t="Tours.FilterGuideLanguage">Rehber Dili</span></label>
                    <select class="form-select" data-bind="value: filterGuideLanguage">
                        <option value="" data-t="Tours.AllLanguages">Tum Diller</option>
                        <option value="tr">Turkce</option>
                        <option value="en">English</option>
                        <option value="de">Deutsch</option>
                        <option value="ru">Русский</option>
                        <option value="es">Espanol</option>
                        <option value="fr">Francais</option>
                        <option value="ar">العربية</option>
                    </select>
                </div>
            </div>

            <!-- Filtre Butonlari -->
            <div class="d-flex justify-content-between mt-3 pt-3 border-top">
                <button class="btn btn-outline-secondary btn-sm" data-bind="click: clearFilters">
                    <i class="bi bi-x-circle"></i> <span data-t="Tours.ClearFilters">Filtreleri Temizle</span>
                </button>
                <button class="btn btn-primary btn-sm" data-bind="click: applyFilters">
                    <i class="bi bi-check-lg"></i> <span data-t="Tours.ApplyFilters">Uygula</span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Sonuc Bilgisi -->
<div class="d-flex justify-content-between align-items-center mb-3" data-bind="visible: !isLoading()">
    <span class="text-muted">
        <strong data-bind="text: totalCount"></strong> <span data-t="Tours.ToursFound">tur bulundu</span>
    </span>
    <div data-bind="visible: activeFilterCount() > 0">
        <span class="badge bg-light text-dark">
            <span data-bind="text: activeFilterCount"></span> <span data-t="Tours.ActiveFilters">aktif filtre</span>
        </span>
    </div>
</div>

<!-- Loading -->
<div data-bind="visible: isLoading" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Yukleniyor...</span>
    </div>
</div>

<!-- Harita Gorunumu -->
<div data-bind="visible: !isLoading() && viewMode() === 'map'" class="mb-4">
    <div class="card shadow-sm">
        <div class="card-body p-0">
            <div id="toursMap" style="height: 500px; border-radius: 0.375rem;"></div>
        </div>
        <div class="card-footer bg-light">
            <small class="text-muted">
                <i class="bi bi-info-circle"></i>
                <span data-t="Tours.MapInfo">Haritada</span>
                <strong data-bind="text: toursWithCoordinates()"></strong>
                <span data-t="Tours.ToursWithLocation">tur konumu gosteriliyor</span>
            </small>
        </div>
    </div>
</div>

<!-- Liste -->
<div class="row g-4" data-bind="visible: !isLoading() && viewMode() === 'list', foreach: tours">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center position-relative lazy-img-container" style="height: 180px;">
                <!-- ko if: imageUrl -->
                <img data-bind="attr: { src: imageUrl, alt: name }"
                     class="w-100 h-100 card-img-lazy"
                     style="object-fit: cover;"
                     loading="lazy"
                     decoding="async" />
                <!-- /ko -->
                <!-- ko ifnot: imageUrl -->
                <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                <!-- /ko -->
                <!-- ko if: isFeatured -->
                <span class="badge bg-warning text-dark position-absolute top-0 start-0 m-2"><i class="bi bi-star-fill"></i> One Cikan</span>
                <!-- /ko -->
                <!-- Promosyon Badge'leri -->
                <!-- ko if: $parent.getPromoBadges(id).length > 0 -->
                <div class="position-absolute bottom-0 start-0 m-2" data-bind="foreach: $parent.getPromoBadges(id)">
                    <span class="badge me-1" data-bind="text: label, css: cssClass"></span>
                </div>
                <!-- /ko -->
                <!-- Favori Butonu -->
                <button class="btn btn-sm position-absolute top-0 end-0 m-2 favorite-btn"
                        data-bind="click: $parent.toggleFavorite,
                                   css: { 'btn-danger': $parent.isFavorite(id), 'btn-outline-light': !$parent.isFavorite(id) }"
                        title="Favorilere Ekle">
                    <i class="bi" data-bind="css: { 'bi-heart-fill': $parent.isFavorite(id), 'bi-heart': !$parent.isFavorite(id) }"></i>
                </button>
                <!-- Takip Et Butonu -->
                <button class="btn btn-sm position-absolute top-0 end-0 m-2"
                        style="margin-top: 36px !important;"
                        data-bind="click: function() { $parent.openWatchPopover($data) },
                                   css: { 'btn-info': $parent.isWatching(id), 'btn-outline-light': !$parent.isWatching(id) }"
                        title="Takip Et">
                    <i class="bi" data-bind="css: { 'bi-eye-fill': $parent.isWatching(id), 'bi-eye': !$parent.isWatching(id) }"></i>
                </button>
            </div>
            <div class="card-body">
                <h5 class="card-title" data-bind="text: name"></h5>
                <div class="mb-2">
                    <span class="badge" data-bind="css: $parent.getCategoryBadgeClass(categoryId), html: '<i class=\'bi ' + ($parent.getCategoryIcon(categoryId) || '') + '\'></i> ' + ($parent.getCategoryName(categoryId) || '')"></span>
                    <span class="badge" data-bind="css: $parent.getDifficultyBadgeClass(difficultyId), text: $parent.getDifficultyName(difficultyId)"></span>
                </div>
                <p class="card-text mb-1" data-bind="visible: company">
                    <small class="text-muted"><i class="bi bi-building"></i> <span data-bind="text: company ? company.name : ''"></span></small>
                </p>
                <p class="card-text text-muted">
                    <i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span>
                </p>
                <!-- Puan ve Yorum Sayisi -->
                <p class="card-text mb-2">
                    <!-- ko if: reviewCount > 0 -->
                    <span class="text-warning">
                        <i class="bi bi-star-fill"></i>
                        <strong data-bind="text: averageRating.toFixed(1)"></strong>
                    </span>
                    <small class="text-muted">(<span data-bind="text: reviewCount"></span> yorum)</small>
                    <!-- /ko -->
                    <!-- ko if: reviewCount === 0 -->
                    <small class="text-muted"><i class="bi bi-star"></i> Henuz yorum yok</small>
                    <!-- /ko -->
                </p>
                <p class="card-text" data-bind="text: description"></p>
                <!-- Kitlik Badge -->
                <!-- ko if: $parent.getRemainingSlots($data) > 0 && $parent.getRemainingSlots($data) <= 5 -->
                <div class="mb-2">
                    <span class="badge bg-danger"><i class="bi bi-exclamation-triangle"></i> <span data-bind="text: T('Scarcity.Badge').replace('{0}', $parent.getRemainingSlots($data))"></span></span>
                </div>
                <!-- /ko -->
                <div class="d-flex justify-content-between align-items-center">
                    <span class="badge bg-primary fs-6" data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span>
                    <span class="text-muted"><i class="bi bi-calendar"></i> <span data-bind="text: durationDays"></span> gun</span>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary flex-grow-1" data-bind="click: $parent.showDetails">
                        <i class="bi bi-info-circle"></i> Detay
                    </button>
                    <button class="btn btn-success flex-grow-1" data-bind="click: $parent.openReservationModal">
                        <i class="bi bi-calendar-check"></i> Rezervasyon Yap
                    </button>
                    <!-- Paylas Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-outline-secondary dropdown-toggle" type="button" data-bs-toggle="dropdown" data-t-title="Common.Share" title="Paylas">
                            <i class="bi bi-share"></i>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><a class="dropdown-item" href="#" data-bind="click: function() { $parent.shareTour($data, 'facebook') }"><i class="bi bi-facebook text-primary me-2"></i>Facebook</a></li>
                            <li><a class="dropdown-item" href="#" data-bind="click: function() { $parent.shareTour($data, 'twitter') }"><i class="bi bi-twitter-x me-2"></i>X</a></li>
                            <li><a class="dropdown-item" href="#" data-bind="click: function() { $parent.shareTour($data, 'whatsapp') }"><i class="bi bi-whatsapp text-success me-2"></i>WhatsApp</a></li>
                            <li><a class="dropdown-item" href="#" data-bind="click: function() { $parent.shareTour($data, 'telegram') }"><i class="bi bi-telegram text-info me-2"></i>Telegram</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item" href="#" data-bind="click: function() { $parent.shareTour($data, 'copy') }"><i class="bi bi-link-45deg me-2"></i>Linki Kopyala</a></li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bos Liste -->
<div data-bind="visible: !isLoading() && tours().length === 0 && viewMode() === 'list'" class="alert alert-info text-center">
    <i class="bi bi-info-circle"></i> <span data-t="Tours.NoTours">Henuz tur bulunmamaktadir. Yakinda yeni turlar eklenecektir!</span>
</div>

<!-- Details Modal (Yorumlarla birlikte) -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tur Detayi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: selectedTour">
                <!-- Tur Bilgileri -->
                <div class="row mb-4">
                    <div class="col-md-5">
                        <!-- ko if: imageUrl -->
                        <img data-bind="attr: { src: imageUrl, alt: name }"
                             class="img-fluid rounded mb-3 card-img-lazy"
                             style="max-height: 250px; width: 100%; object-fit: cover;"
                             loading="lazy"
                             decoding="async" />
                        <!-- /ko -->
                        <h4 data-bind="text: name"></h4>
                        <p class="text-muted"><i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span></p>
                        <p data-bind="visible: company" class="alert alert-light">
                            <i class="bi bi-building"></i> <strong>Firma:</strong> <span data-bind="text: company ? company.name : ''"></span>
                        </p>
                    </div>
                    <div class="col-md-7">
                        <dl class="row">
                            <dt class="col-sm-4">Fiyat</dt>
                            <dd class="col-sm-8"><span class="badge bg-success fs-6" data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span></dd>

                            <dt class="col-sm-4">Sure</dt>
                            <dd class="col-sm-8"><span data-bind="text: durationDays"></span> gun</dd>

                            <dt class="col-sm-4">Kapasite</dt>
                            <dd class="col-sm-8"><span data-bind="text: maxCapacity || '-'"></span> kisi</dd>

                            <dt class="col-sm-4">Aciklama</dt>
                            <dd class="col-sm-8" data-bind="text: description || '-'"></dd>
                        </dl>

                        <!-- Hava Durumu Widget -->
                        <div id="weatherWidget" class="card border-info mb-3" style="display: none;">
                            <div class="card-body py-2">
                                <div class="d-flex align-items-center justify-content-between">
                                    <div class="d-flex align-items-center">
                                        <img id="weatherIcon" src="" alt="weather" style="width: 40px; height: 40px;" />
                                        <div class="ms-2">
                                            <strong id="weatherTemp"></strong>
                                            <small id="weatherCondition" class="d-block text-muted"></small>
                                        </div>
                                    </div>
                                    <div class="text-end small">
                                        <span id="weatherHumidity" class="text-muted"></span><br />
                                        <span id="weatherWind" class="text-muted"></span>
                                    </div>
                                </div>
                                <div id="weatherRecommendation" class="mt-1 small"></div>
                            </div>
                        </div>

                        <!-- Puan Ozeti -->
                        <div class="card bg-light">
                            <div class="card-body">
                                <div class="d-flex align-items-center mb-2">
                                    <div class="display-4 text-warning me-3" data-bind="text: (averageRating || 0).toFixed(1)"></div>
                                    <div>
                                        <div data-bind="html: $parent.renderStars(averageRating || 0)"></div>
                                        <small class="text-muted"><span data-bind="text: reviewCount || 0"></span> yorum</small>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Paylas Butonlari -->
                        <div class="mt-3">
                            <small class="text-muted d-block mb-2"><i class="bi bi-share"></i> <span data-t="Share.Title">Paylas</span></small>
                            <div id="tourShareButtons"></div>
                        </div>
                    </div>
                </div>

                <!-- Dahil Olan / Olmayan Bolumu -->
                <!-- ko if: inclusions || exclusions -->
                <div class="row mb-4">
                    <!-- ko if: inclusions -->
                    <div class="col-md-6">
                        <div class="card border-success h-100">
                            <div class="card-header bg-success text-white">
                                <h6 class="mb-0"><i class="bi bi-check-circle"></i> <span data-t="Tour.Inclusions">Dahil Olan</span></h6>
                            </div>
                            <div class="card-body">
                                <ul class="list-unstyled mb-0" data-bind="foreach: inclusions.split('\\n').filter(function(s){ return s.trim(); })">
                                    <li class="mb-1"><i class="bi bi-check-lg text-success me-2"></i><span data-bind="text: $data"></span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                    <!-- ko if: exclusions -->
                    <div class="col-md-6">
                        <div class="card border-danger h-100">
                            <div class="card-header bg-danger text-white">
                                <h6 class="mb-0"><i class="bi bi-x-circle"></i> <span data-t="Tour.Exclusions">Dahil Olmayan</span></h6>
                            </div>
                            <div class="card-body">
                                <ul class="list-unstyled mb-0" data-bind="foreach: exclusions.split('\\n').filter(function(s){ return s.trim(); })">
                                    <li class="mb-1"><i class="bi bi-x-lg text-danger me-2"></i><span data-bind="text: $data"></span></li>
                                </ul>
                            </div>
                        </div>
                    </div>
                    <!-- /ko -->
                </div>
                <!-- /ko -->

                <!-- Musaitlik Takvimi -->
                <div class="mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h5 class="mb-0"><i class="bi bi-calendar3"></i> <span data-t="TourDate.Title">Musaitlik Takvimi</span></h5>
                        <div class="d-flex gap-2">
                            <button class="btn btn-outline-primary btn-sm" data-bind="click: function() { $parent.changeCalendarMonth(-1) }">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <span class="fw-semibold" data-bind="text: $parent.calendarMonthLabel()"></span>
                            <button class="btn btn-outline-primary btn-sm" data-bind="click: function() { $parent.changeCalendarMonth(1) }">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                        </div>
                    </div>
                    <div data-bind="visible: $parent.isLoadingDates" class="text-center py-3">
                        <div class="spinner-border spinner-border-sm text-primary"></div>
                    </div>
                    <div data-bind="visible: !$parent.isLoadingDates() && $parent.tourDates().length === 0" class="text-center text-muted py-3">
                        <i class="bi bi-calendar-x"></i> <span data-t="TourDate.NoDates">Henuz tarih eklenmemis</span>
                    </div>
                    <div class="row g-2" data-bind="visible: !$parent.isLoadingDates(), foreach: $parent.tourDates">
                        <div class="col-md-4 col-sm-6">
                            <div class="card h-100" style="cursor: pointer;" data-bind="click: function() { if (isAvailable) $root.selectTourDate($data); }, css: { 'border-success': isAvailable && $root.selectedDateToken() !== (token || 'd:' + id), 'border-primary border-2': $root.selectedDateToken() === (token || 'd:' + id), 'border-secondary opacity-50': !isAvailable }">
                                <div class="card-body p-2">
                                    <div class="d-flex justify-content-between align-items-center mb-1">
                                        <small class="fw-semibold" data-bind="text: $root.formatDate(date + 'T00:00:00Z') + ' ' + $root.formatSessionDuration($data)"></small>
                                        <!-- ko if: $root.selectedDateToken() === (token || 'd:' + id) -->
                                        <span class="badge bg-primary"><i class="bi bi-check-circle-fill me-1"></i>Secili</span>
                                        <!-- /ko -->
                                        <!-- ko ifnot: $root.selectedDateToken() === (token || 'd:' + id) -->
                                        <span class="badge" data-bind="css: isAvailable ? 'bg-success' : 'bg-secondary', text: isAvailable ? (T('TourDate.Available') || 'Musait') : (T('TourDate.NotAvailable') || 'Dolu')"></span>
                                        <!-- /ko -->
                                    </div>
                                    <div class="d-flex justify-content-between align-items-center">
                                        <span class="fw-bold text-primary" data-bind="text: price ? price.toLocaleString('tr-TR', {style:'currency', currency:'TRY'}) : ''"></span>
                                        <small class="text-muted" data-bind="text: bookedCount + '/' + (maxCapacity || '∞')"></small>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <hr />

                <!-- Yorumlar Bolumu -->
                <div class="row">
                    <div class="col-12">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0"><i class="bi bi-chat-quote"></i> Yorumlar</h5>
                            <button class="btn btn-primary btn-sm" data-bind="click: $parent.openWriteReviewModal, visible: $parent.canWriteReview()">
                                <i class="bi bi-pencil"></i> Yorum Yaz
                            </button>
                        </div>

                        <!-- Filtreleme -->
                        <div class="d-flex gap-2 mb-3 flex-wrap">
                            <select class="form-select form-select-sm" style="width: auto;" data-bind="value: $parent.reviewSort">
                                <option value="newest">En Yeni</option>
                                <option value="oldest">En Eski</option>
                                <option value="highest">En Yuksek Puan</option>
                                <option value="lowest">En Dusuk Puan</option>
                                <option value="helpful">En Yardimci</option>
                            </select>
                            <select class="form-select form-select-sm" style="width: auto;" data-bind="value: $parent.reviewRatingFilter">
                                <option value="">Tum Puanlar</option>
                                <option value="5">5 Yildiz</option>
                                <option value="4">4 Yildiz</option>
                                <option value="3">3 Yildiz</option>
                                <option value="2">2 Yildiz</option>
                                <option value="1">1 Yildiz</option>
                            </select>
                        </div>

                        <!-- Yorumlar Loading -->
                        <div data-bind="visible: $parent.isLoadingReviews" class="text-center py-4">
                            <div class="spinner-border spinner-border-sm text-primary"></div>
                            <span class="ms-2">Yorumlar yukleniyor...</span>
                        </div>

                        <!-- Yorum Listesi -->
                        <div data-bind="visible: !$parent.isLoadingReviews(), foreach: $parent.reviews">
                            <div class="card mb-3">
                                <div class="card-body">
                                    <div class="d-flex justify-content-between align-items-start mb-2">
                                        <div>
                                            <strong data-bind="text: visitor.firstName + ' ' + visitor.lastInitial"></strong>
                                            <!-- ko if: isVerified -->
                                            <span class="badge bg-success ms-1" title="Dogrulanmis Yorum"><i class="bi bi-patch-check-fill"></i></span>
                                            <!-- /ko -->
                                            <br />
                                            <small class="text-muted">
                                                <i class="bi" data-bind="class: travelTypeIcon"></i>
                                                <span data-bind="text: $parent.getTravelTypeName(travelTypeId)"></span>
                                                <!-- ko if: visitDate -->
                                                - <span data-bind="text: $parent.formatDate(visitDate)"></span>
                                                <!-- /ko -->
                                            </small>
                                        </div>
                                        <div class="text-end">
                                            <div data-bind="html: $parent.renderStars(overallRating)"></div>
                                            <small class="text-muted" data-bind="text: $parent.formatDate(createdAt)"></small>
                                        </div>
                                    </div>

                                    <!-- ko if: title -->
                                    <h6 class="mb-2" data-bind="text: title"></h6>
                                    <!-- /ko -->

                                    <!-- ko if: pros -->
                                    <p class="mb-1"><span class="text-success"><i class="bi bi-plus-circle"></i> Olumlu:</span> <span data-bind="text: pros"></span></p>
                                    <!-- /ko -->

                                    <!-- ko if: cons -->
                                    <p class="mb-1"><span class="text-danger"><i class="bi bi-dash-circle"></i> Olumsuz:</span> <span data-bind="text: cons"></span></p>
                                    <!-- /ko -->

                                    <!-- ko if: comment -->
                                    <p class="mb-2" data-bind="text: comment"></p>
                                    <!-- /ko -->

                                    <!-- Tavsiye -->
                                    <p class="mb-2">
                                        <!-- ko if: wouldRecommend -->
                                        <span class="badge bg-success"><i class="bi bi-hand-thumbs-up"></i> Tavsiye Eder</span>
                                        <!-- /ko -->
                                        <!-- ko ifnot: wouldRecommend -->
                                        <span class="badge bg-secondary"><i class="bi bi-hand-thumbs-down"></i> Tavsiye Etmez</span>
                                        <!-- /ko -->
                                    </p>

                                    <!-- Yardimci / Sikayet -->
                                    <div class="d-flex justify-content-between align-items-center border-top pt-2 mt-2">
                                        <div>
                                            <small class="text-muted me-3">Bu yorum yardimci oldu mu?</small>
                                            <button class="btn btn-sm btn-outline-success me-1" data-bind="click: function() { $parents[1].voteHelpful(id, true) }">
                                                <i class="bi bi-hand-thumbs-up"></i> <span data-bind="text: helpfulCount"></span>
                                            </button>
                                            <button class="btn btn-sm btn-outline-secondary" data-bind="click: function() { $parents[1].voteHelpful(id, false) }">
                                                <i class="bi bi-hand-thumbs-down"></i> <span data-bind="text: notHelpfulCount"></span>
                                            </button>
                                        </div>
                                        <div>
                                            <button class="btn btn-sm btn-link text-muted" data-bind="click: function() { $parents[1].openReplyModal(id) }">
                                                <i class="bi bi-reply"></i> Yanit Ver
                                            </button>
                                            <button class="btn btn-sm btn-link text-muted" data-bind="click: function() { $parents[1].openReportModal(id) }">
                                                <i class="bi bi-flag"></i> Sikayet
                                            </button>
                                        </div>
                                    </div>

                                    <!-- Yanitlar -->
                                    <!-- ko if: replies && replies.length > 0 -->
                                    <div class="mt-3 ms-4 border-start ps-3">
                                        <!-- ko foreach: replies -->
                                        <div class="mb-2">
                                            <div class="d-flex justify-content-between">
                                                <div>
                                                    <strong data-bind="text: visitor.firstName + ' ' + visitor.lastInitial"></strong>
                                                    <!-- ko if: isFromCompany -->
                                                    <span class="badge bg-info ms-1"><i class="bi bi-building"></i> Firma</span>
                                                    <!-- /ko -->
                                                </div>
                                                <small class="text-muted" data-bind="text: $parents[2].formatDate(createdAt)"></small>
                                            </div>
                                            <p class="mb-0 text-muted" data-bind="text: comment"></p>
                                        </div>
                                        <!-- /ko -->
                                    </div>
                                    <!-- /ko -->
                                </div>
                            </div>
                        </div>

                        <!-- Yorum Yok -->
                        <div data-bind="visible: !$parent.isLoadingReviews() && $parent.reviews().length === 0" class="text-center py-4 text-muted">
                            <i class="bi bi-chat-square-text" style="font-size: 3rem;"></i>
                            <p class="mt-2">Henuz yorum yapilmamis. Ilk yorumu siz yapin!</p>
                        </div>

                        <!-- Daha Fazla Yukle -->
                        <div class="text-center" data-bind="visible: $parent.hasMoreReviews()">
                            <button class="btn btn-outline-primary" data-bind="click: $parent.loadMoreReviews, disable: $parent.isLoadingReviews">
                                Daha Fazla Yukle
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
                <button type="button" class="btn btn-success" data-bind="click: function() { openReservationModal(selectedTour()) }">
                    <i class="bi bi-calendar-check"></i> Rezervasyon Yap
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Write Review Modal -->
<div class="modal fade" id="writeReviewModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-star"></i> Yorum Yaz</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="reviewForm">
                    <!-- Genel Puan -->
                    <div class="mb-4 text-center">
                        <label class="form-label fw-bold">Genel Puaniniz *</label>
                        <div class="star-rating fs-2" data-bind="foreach: [1,2,3,4,5]">
                            <i class="bi cursor-pointer"
                               data-bind="css: $data <= $parent.reviewFormData().overallRating ? 'bi-star-fill text-warning' : 'bi-star text-muted',
                                          click: function() { $parent.reviewFormData().overallRating = $data; $parent.reviewFormData.valueHasMutated(); }"></i>
                        </div>
                    </div>

                    <!-- Detayli Puanlar -->
                    <div class="row mb-3">
                        <div class="col-md-4 mb-2">
                            <label class="form-label small">Hizmet Kalitesi</label>
                            <select class="form-select form-select-sm" data-bind="value: reviewFormData().serviceRating">
                                <option value="">Secin</option>
                                <option value="5">5 - Mukemmel</option>
                                <option value="4">4 - Cok Iyi</option>
                                <option value="3">3 - Iyi</option>
                                <option value="2">2 - Orta</option>
                                <option value="1">1 - Kotu</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label small">Fiyat/Deger</label>
                            <select class="form-select form-select-sm" data-bind="value: reviewFormData().valueRating">
                                <option value="">Secin</option>
                                <option value="5">5 - Mukemmel</option>
                                <option value="4">4 - Cok Iyi</option>
                                <option value="3">3 - Iyi</option>
                                <option value="2">2 - Orta</option>
                                <option value="1">1 - Kotu</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label small">Lokasyon</label>
                            <select class="form-select form-select-sm" data-bind="value: reviewFormData().locationRating">
                                <option value="">Secin</option>
                                <option value="5">5 - Mukemmel</option>
                                <option value="4">4 - Cok Iyi</option>
                                <option value="3">3 - Iyi</option>
                                <option value="2">2 - Orta</option>
                                <option value="1">1 - Kotu</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label small">Organizasyon</label>
                            <select class="form-select form-select-sm" data-bind="value: reviewFormData().organizationRating">
                                <option value="">Secin</option>
                                <option value="5">5 - Mukemmel</option>
                                <option value="4">4 - Cok Iyi</option>
                                <option value="3">3 - Iyi</option>
                                <option value="2">2 - Orta</option>
                                <option value="1">1 - Kotu</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-2">
                            <label class="form-label small">Rehber/Personel</label>
                            <select class="form-select form-select-sm" data-bind="value: reviewFormData().guideRating">
                                <option value="">Secin</option>
                                <option value="5">5 - Mukemmel</option>
                                <option value="4">4 - Cok Iyi</option>
                                <option value="3">3 - Iyi</option>
                                <option value="2">2 - Orta</option>
                                <option value="1">1 - Kotu</option>
                            </select>
                        </div>
                    </div>

                    <hr />

                    <!-- Yorum Icerigi -->
                    <div class="mb-3">
                        <label class="form-label">Yorum Basligi</label>
                        <input type="text" class="form-control" data-bind="value: reviewFormData().title" placeholder="Kisa bir baslik yazin" maxlength="200" />
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label"><i class="bi bi-plus-circle text-success"></i> Olumlu Yonler</label>
                            <textarea class="form-control" rows="3" data-bind="value: reviewFormData().pros" placeholder="Nelerden memnun kaldiniz?"></textarea>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label"><i class="bi bi-dash-circle text-danger"></i> Olumsuz Yonler</label>
                            <textarea class="form-control" rows="3" data-bind="value: reviewFormData().cons" placeholder="Nelerden memnun kalmadiniz?"></textarea>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Detayli Yorum</label>
                        <textarea class="form-control" rows="4" data-bind="value: reviewFormData().comment" placeholder="Deneyiminizi paylasın..."></textarea>
                    </div>

                    <hr />

                    <!-- Seyahat Bilgileri -->
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Seyahat Tarihi</label>
                            <input type="date" class="form-control" data-bind="value: reviewFormData().visitDate" />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Seyahat Tipi</label>
                            <select class="form-select" data-bind="value: reviewFormData().travelTypeId">
                                <option value="0">Yalniz</option>
                                <option value="1">Cift</option>
                                <option value="2">Aile</option>
                                <option value="3">Arkadaslar</option>
                                <option value="4">Is Seyahati</option>
                            </select>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Tavsiye Eder misiniz?</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" data-bind="checked: reviewFormData().wouldRecommend" id="wouldRecommend" />
                                <label class="form-check-label" for="wouldRecommend">Evet, tavsiye ederim</label>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-primary" data-bind="click: submitReview, disable: isSaving() || reviewFormData().overallRating < 1">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    Yorumu Gonder
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reply Modal -->
<div class="modal fade" id="replyModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="bi bi-reply"></i> Yanit Yaz</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Yanitiniz</label>
                    <textarea class="form-control" rows="3" data-bind="value: replyText" placeholder="Yanitinizi yazin..."></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-primary" data-bind="click: submitReply, disable: isSaving() || !replyText()">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    Gonder
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Report Modal -->
<div class="modal fade" id="reportModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-warning">
                <h5 class="modal-title"><i class="bi bi-flag"></i> Yorumu Sikayet Et</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Sikayet Sebebi *</label>
                    <select class="form-select" data-bind="value: reportReasonId">
                        <option value="">Secin...</option>
                        <option value="0">Spam veya Reklam</option>
                        <option value="1">Uygunsuz Icerik</option>
                        <option value="2">Sahte/Yaniltici Yorum</option>
                        <option value="3">Taciz/Hakaret</option>
                        <option value="4">Kisisel Bilgi Paylasimi</option>
                        <option value="5">Konu Disi</option>
                        <option value="6">Telif Hakki Ihlali</option>
                        <option value="99">Diger</option>
                    </select>
                </div>
                <div class="mb-3">
                    <label class="form-label">Ek Aciklama</label>
                    <textarea class="form-control" rows="3" data-bind="value: reportDescription" placeholder="Detaylı aciklama (opsiyonel)"></textarea>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-warning" data-bind="click: submitReport, disable: isSaving() || !reportReasonId()">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    Sikayet Et
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Reservation Modal -->
<div class="modal fade" id="reservationModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">
                    <i class="bi bi-calendar-check"></i>
                    <span data-bind="visible: !showPaymentStep()" data-t="Reservation.MakeReservation">Rezervasyon Yap</span>
                    <span data-bind="visible: showPaymentStep()" data-t="Payment.Title">Odeme</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <!-- STEP 1: Rezervasyon Formu -->
                <div data-bind="visible: !showPaymentStep()">
                    <div class="row">
                        <!-- Sol Kolon - Form -->
                        <div class="col-md-7">
                            <div data-bind="with: selectedTour" class="mb-3">
                                <div class="alert alert-light">
                                    <h5 data-bind="text: name"></h5>
                                    <p class="mb-1"><i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span></p>
                                    <p class="mb-0"><strong data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></strong> / kisi</p>
                                </div>
                            </div>
                            <!-- Adim 1: Tarih Sec -->
                            <div class="mb-3">
                                <label class="form-label fw-semibold"><i class="bi bi-calendar3 me-1"></i> 1. <span data-bind="text: T('TourDate.SelectDate') || 'Tarih Secin'"></span> *</label>
                                <div data-bind="visible: isLoadingDates" class="text-center py-2">
                                    <div class="spinner-border spinner-border-sm text-primary"></div>
                                </div>
                                <div data-bind="visible: !isLoadingDates() && availableDates().length === 0" class="text-muted small py-2">
                                    <i class="bi bi-calendar-x me-1"></i> <span data-bind="text: T('TourDate.NoDates') || 'Musait tarih bulunamadi'"></span>
                                </div>
                                <div data-bind="visible: !isLoadingDates() && availableDates().length > 0">
                                    <input type="date" class="form-control"
                                           data-bind="value: selectedReservationDate,
                                                      attr: { min: datePickerMin(), max: datePickerMax() },
                                                      event: { change: onDatePickerChange }">
                                    <small class="text-danger" data-bind="visible: datePickerError(), text: datePickerError()"></small>
                                </div>
                            </div>
                            <!-- Adim 2: Seans Sec -->
                            <div class="mb-3" data-bind="visible: selectedReservationDate()">
                                <label class="form-label fw-semibold"><i class="bi bi-clock me-1"></i> 2. <span data-bind="text: T('TourDate.SelectSession') || 'Seans Secin'"></span> *</label>
                                <!-- ko if: sessionsForDate().length === 0 -->
                                <div class="text-muted small py-1"><span data-bind="text: T('TourDate.NoSessions') || 'Bu tarihte musait seans yok'"></span></div>
                                <!-- /ko -->
                                <div class="list-group list-group-flush">
                                    <!-- ko foreach: sessionsForDate -->
                                    <a href="#" class="list-group-item list-group-item-action py-2 px-3"
                                       data-bind="click: function() { $parent.selectTourDate($data); return false; },
                                                  css: { 'active': $parent.selectedDateToken() === (token || 'd:' + id) }">
                                        <div class="d-flex justify-content-between align-items-center">
                                            <div>
                                                <i class="bi bi-clock me-1"></i>
                                                <span class="fw-semibold" data-bind="text: $parent.formatSessionDuration($data)"></span>
                                            </div>
                                            <div class="text-end">
                                                <!-- ko if: price -->
                                                <span class="fw-bold text-primary" data-bind="text: price.toLocaleString('tr-TR', {style:'currency', currency:'TRY'})"></span>
                                                <!-- /ko -->
                                                <small class="text-muted ms-1" data-bind="text: bookedCount + '/' + (maxCapacity || '∞')"></small>
                                            </div>
                                        </div>
                                    </a>
                                    <!-- /ko -->
                                </div>
                                <!-- ko if: selectedTourDateObj() -->
                                <div class="alert alert-success py-2 mt-2 mb-0">
                                    <i class="bi bi-check-circle-fill me-1"></i>
                                    <span data-bind="text: formatDate(selectedTourDateObj().date + 'T00:00:00Z')"></span>
                                    <strong data-bind="text: formatSessionDuration(selectedTourDateObj())"></strong>
                                    <!-- ko if: selectedTourDateObj().price -->
                                    | <span data-bind="text: selectedTourDateObj().price.toLocaleString('tr-TR', {style:'currency', currency:'TRY'})"></span>/kisi
                                    <!-- /ko -->
                                </div>
                                <!-- /ko -->
                            </div>
                            <form id="reservationForm">
                                <div class="mb-3">
                                    <label class="form-label">Adiniz Soyadiniz *</label>
                                    <input type="text" class="form-control" data-bind="value: reservationData().fullName" required />
                                    <small class="text-muted">Baska biri icin rezervasyon yapiyorsaniz degistirebilirsiniz</small>
                                </div>
                                <div class="row">
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">E-posta *</label>
                                        <input type="email" class="form-control" data-bind="value: reservationData().email" required />
                                    </div>
                                    <div class="col-md-6 mb-3">
                                        <label class="form-label">Telefon *</label>
                                        <input type="tel" class="form-control" data-bind="value: reservationData().phone" required />
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Kisi Sayisi *</label>
                                    <input type="number" class="form-control" min="1" max="20" data-bind="value: numberOfPeople" required />
                                </div>
                                <div class="mb-3">
                                    <label class="form-label">Not (Opsiyonel)</label>
                                    <textarea class="form-control" rows="2" data-bind="value: reservationData().notes" placeholder="Ozel isteklerinizi yazabilirsiniz..."></textarea>
                                </div>
                                <!-- Katilimci Bilgileri Accordion -->
                                <div class="accordion mb-3" id="participantAccordion">
                                    <div class="accordion-item">
                                        <h2 class="accordion-header">
                                            <button class="accordion-button collapsed py-2" type="button" data-bs-toggle="collapse" data-bs-target="#participantPanel">
                                                <i class="bi bi-people me-2"></i> <span data-t="Participant.Title">Katilimci Bilgileri</span>
                                                <span class="badge bg-secondary ms-2" data-bind="text: participants().length"></span>
                                            </button>
                                        </h2>
                                        <div id="participantPanel" class="accordion-collapse collapse">
                                            <div class="accordion-body p-2">
                                                <div data-bind="foreach: participants">
                                                    <div class="card mb-2">
                                                        <div class="card-body p-2">
                                                            <div class="d-flex justify-content-between align-items-center mb-1">
                                                                <small class="fw-semibold">Katilimci <span data-bind="text: $index() + 1"></span></small>
                                                                <button class="btn btn-outline-danger btn-sm py-0" data-bind="click: $parent.removeParticipant"><i class="bi bi-x"></i></button>
                                                            </div>
                                                            <div class="row g-1">
                                                                <div class="col-6">
                                                                    <input type="text" class="form-control form-control-sm" data-bind="value: name" placeholder="Ad Soyad" />
                                                                </div>
                                                                <div class="col-2">
                                                                    <input type="number" class="form-control form-control-sm" data-bind="value: age" data-t-placeholder="Reservation.AgePlaceholder" placeholder="Yas" min="0" max="120" />
                                                                </div>
                                                                <div class="col-4">
                                                                    <input type="text" class="form-control form-control-sm" data-bind="value: diet" data-t-placeholder="Reservation.DietPlaceholder" placeholder="Diyet" />
                                                                </div>
                                                            </div>
                                                            <input type="text" class="form-control form-control-sm mt-1" data-bind="value: health" placeholder="Saglik notu (opsiyonel)" />
                                                        </div>
                                                    </div>
                                                </div>
                                                <button class="btn btn-outline-primary btn-sm w-100" data-bind="click: addParticipant">
                                                    <i class="bi bi-plus"></i> <span data-t="Participant.Add">Katilimci Ekle</span>
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <!-- Sag Kolon - Fiyat Ozeti -->
                        <div class="col-md-5">
                            <div class="card bg-light h-100">
                                <div class="card-header bg-primary text-white">
                                    <h6 class="mb-0"><i class="bi bi-receipt"></i> Fiyat Ozeti</h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Tur Ucreti:</span>
                                        <span data-bind="text: selectedTour() ? selectedTour().price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'}) : ''"></span>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>Kisi Sayisi:</span>
                                        <span data-bind="text: numberOfPeople() + ' kisi'"></span>
                                    </div>
                                    <!-- Kupon Kodu -->
                                    <div class="mb-2">
                                        <label class="form-label small mb-1"><i class="bi bi-ticket-perforated me-1"></i>Kupon Kodu</label>
                                        <div class="input-group input-group-sm">
                                            <input type="text" class="form-control" data-t-placeholder="Promotion.CodePlaceholder" placeholder="INDIRIM20" data-bind="value: couponCode" />
                                            <button class="btn btn-outline-primary" type="button" data-bind="click: applyCoupon">Uygula</button>
                                        </div>
                                        <small class="text-success" data-bind="visible: couponDiscount() > 0, text: 'Kupon indirimi: -' + couponDiscount().toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></small>
                                    </div>
                                    <!-- Promosyon Bilgileri -->
                                    <div data-bind="visible: appliedDiscounts().length > 0" class="mb-2">
                                        <small class="text-muted">Uygulanan Indirimler:</small>
                                        <div data-bind="foreach: appliedDiscounts" class="small">
                                            <div class="d-flex justify-content-between text-success">
                                                <span data-bind="text: promotionName"></span>
                                                <span data-bind="text: '-' + discountAmount.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span>
                                            </div>
                                        </div>
                                    </div>
                                    <hr />
                                    <div class="d-flex justify-content-between mb-2 fw-bold">
                                        <span>Toplam Tutar:</span>
                                        <span class="text-primary fs-5" data-bind="text: calculateTotal()"></span>
                                    </div>
                                    <div data-bind="visible: totalDiscount() > 0" class="d-flex justify-content-between mb-2 text-success">
                                        <span>Toplam Indirim:</span>
                                        <span data-bind="text: '-' + totalDiscount().toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span>
                                    </div>
                                    <hr />
                                    <div class="alert alert-warning mb-2 py-2">
                                        <small><i class="bi bi-info-circle"></i> Rezervasyon icin %<span data-bind="text: getDepositPercentage()"></span> on odeme gereklidir</small>
                                    </div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span>On Odeme (%<span data-bind="text: getDepositPercentage()"></span>):</span>
                                        <span class="text-success fw-bold" data-bind="text: calculateDeposit()"></span>
                                    </div>
                                    <div class="d-flex justify-content-between text-muted small">
                                        <span>Kalan Tutar:</span>
                                        <span data-bind="text: calculateRemaining()"></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 2: On Odeme Ekrani -->
                <div data-bind="visible: showPaymentStep()">
                    <div class="row">
                        <!-- Sol Kolon - Rezervasyon Ozeti -->
                        <div class="col-md-6">
                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-person"></i> Rezervasyon Bilgileri</h6>
                                </div>
                                <div class="card-body">
                                    <p class="mb-1"><strong>Ad Soyad:</strong> <span data-bind="text: reservationData().fullName"></span></p>
                                    <p class="mb-1"><strong>E-posta:</strong> <span data-bind="text: reservationData().email"></span></p>
                                    <p class="mb-1"><strong>Telefon:</strong> <span data-bind="text: reservationData().phone"></span></p>
                                    <p class="mb-0"><strong>Kisi Sayisi:</strong> <span data-bind="text: numberOfPeople()"></span> kisi</p>
                                </div>
                            </div>
                            <div class="card" data-bind="with: selectedTour">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-geo-alt"></i> Tur Bilgileri</h6>
                                </div>
                                <div class="card-body">
                                    <h5 data-bind="text: name"></h5>
                                    <p class="mb-1 text-muted"><i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span></p>
                                    <p class="mb-0"><i class="bi bi-calendar3"></i> <span data-bind="text: durationDays"></span> gun</p>
                                </div>
                            </div>
                        </div>
                        <!-- Sag Kolon - Odeme Tipi, Yontemi ve Ozet -->
                        <div class="col-md-6">
                            <!-- Odeme Tipi Secimi -->
                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-cash-coin"></i> <span data-t="Payment.TypeTitle">Odeme Tipi</span></h6>
                                </div>
                                <div class="card-body p-2">
                                    <div class="list-group list-group-flush">
                                        <a href="#" class="list-group-item list-group-item-action p-3"
                                           data-bind="click: function() { selectPaymentType('deposit') },
                                                      css: { 'active border-warning': paymentType() === 'deposit' }">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    <i class="bi bi-cash-stack fs-4 text-warning"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold" data-t="Payment.Deposit">On Odeme</div>
                                                    <small class="text-muted">%<span data-bind="text: getDepositPercentage()"></span> <span data-t="Payment.DepositDesc">odeyip yerinizi ayirtin</span></small>
                                                </div>
                                                <div class="text-end">
                                                    <span class="fw-bold" data-bind="text: calculateDeposit()"></span>
                                                </div>
                                            </div>
                                        </a>
                                        <a href="#" class="list-group-item list-group-item-action p-3"
                                           data-bind="click: function() { selectPaymentType('full') },
                                                      css: { 'active border-success': paymentType() === 'full' }">
                                            <div class="d-flex align-items-center">
                                                <div class="me-3">
                                                    <i class="bi bi-wallet-fill fs-4 text-success"></i>
                                                </div>
                                                <div class="flex-grow-1">
                                                    <div class="fw-bold" data-t="Payment.FullPayment">Tam Odeme</div>
                                                    <small class="text-muted" data-t="Payment.FullPaymentDesc">Tamamini simdi odeyin</small>
                                                </div>
                                                <div class="text-end">
                                                    <span class="fw-bold" data-bind="text: calculateFinalTotal()"></span>
                                                </div>
                                            </div>
                                        </a>
                                    </div>
                                </div>
                            </div>

                            <!-- Odeme Yontemi Secimi -->
                            <div class="card mb-3">
                                <div class="card-header bg-light">
                                    <h6 class="mb-0"><i class="bi bi-wallet2"></i> <span data-t="Payment.MethodTitle">Odeme Yontemi</span></h6>
                                </div>
                                <div class="card-body p-2">
                                    <div class="list-group list-group-flush">
                                        <a href="#" class="list-group-item list-group-item-action d-flex align-items-center p-3"
                                           data-bind="click: function() { selectPaymentMethod('iyzico') },
                                                      css: { 'active border-primary': selectedPaymentMethod() === 'iyzico' }">
                                            <div class="me-3">
                                                <i class="bi bi-credit-card-2-front fs-3 text-primary"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="fw-bold" data-t="Payment.CreditCard">Kredi/Banka Karti</div>
                                                <small class="text-muted" data-t="Payment.IyzicoSecure">iyzico ile guvenli odeme</small>
                                            </div>
                                            <i class="bi bi-check-circle-fill text-primary" data-bind="visible: selectedPaymentMethod() === 'iyzico'"></i>
                                        </a>
                                        <div class="list-group-item d-flex align-items-center p-3 text-muted" style="opacity: 0.6;">
                                            <div class="me-3">
                                                <i class="bi bi-bank fs-3"></i>
                                            </div>
                                            <div class="flex-grow-1">
                                                <div class="fw-bold" data-t="Payment.BankTransfer">Banka Havale/EFT</div>
                                                <small>PayTR - <span data-t="Common.ComingSoon">Yakinda</span></small>
                                            </div>
                                            <span class="badge bg-secondary" data-t="Common.ComingSoon">Yakinda</span>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Odeme Ozeti -->
                            <div class="card border-success">
                                <div class="card-header bg-success text-white">
                                    <h6 class="mb-0"><i class="bi bi-receipt"></i> <span data-t="Payment.Summary">Odeme Ozeti</span></h6>
                                </div>
                                <div class="card-body">
                                    <div class="d-flex justify-content-between mb-2">
                                        <span data-t="Reservation.TotalPrice">Toplam Tutar:</span>
                                        <span data-bind="text: calculateTotal()"></span>
                                    </div>
                                    <!-- ko if: totalDiscount() > 0 -->
                                    <div class="d-flex justify-content-between mb-2 text-success">
                                        <span data-t="Promotion.Discount">Indirim:</span>
                                        <span data-bind="text: '-' + totalDiscount().toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span>
                                    </div>
                                    <!-- /ko -->
                                    <hr />
                                    <div class="d-flex justify-content-between mb-2 fs-5">
                                        <span class="fw-bold" data-t="Payment.PayNow">Simdi Odenecek:</span>
                                        <span class="text-success fw-bold" data-bind="text: calculatePayNow()"></span>
                                    </div>
                                    <!-- ko if: paymentType() === 'deposit' -->
                                    <div class="d-flex justify-content-between text-muted small">
                                        <span data-t="Payment.Remaining">Kalan (tura katilimda):</span>
                                        <span data-bind="text: calculateRemaining()"></span>
                                    </div>
                                    <!-- /ko -->
                                </div>
                                <div class="card-footer bg-transparent text-center py-2">
                                    <small class="text-muted">
                                        <i class="bi bi-shield-check text-success"></i> 256-bit SSL <span data-t="Payment.SecurePayment">Guvenli Odeme</span>
                                    </small>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="modal-footer d-flex justify-content-between">
                <div>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" data-bind="visible: !showPaymentStep()">Iptal</button>
                    <button type="button" class="btn btn-outline-secondary" data-bind="visible: showPaymentStep(), click: goBackToForm">
                        <i class="bi bi-arrow-left me-1"></i> Geri
                    </button>
                </div>
                <button type="button" class="btn btn-success btn-lg"
                        data-bind="click: showPaymentStep() ? submitPayment : goToPaymentStep, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    <!-- ko if: !showPaymentStep() -->
                    <i class="bi bi-arrow-right me-1"></i> <span data-t="Payment.Continue">Odemeye Devam Et</span>
                    <!-- /ko -->
                    <!-- ko if: showPaymentStep() -->
                    <i class="bi bi-credit-card me-1"></i>
                    <span data-bind="text: calculatePayNow()"></span>
                    <span data-t="Payment.Pay">Ode</span>
                    <!-- /ko -->
                </button>
            </div>
        </div>
    </div>
</div>
</div>

<style>
.cursor-pointer { cursor: pointer; }
.star-rating i:hover { transform: scale(1.2); }
/* Harita popup stilleri */
.tour-popup { min-width: 180px; }
.tour-popup strong { font-size: 1rem; }
#toursMap .leaflet-popup-content-wrapper { border-radius: 8px; }
</style>

<!-- Takip Et Modal -->
<div class="modal fade" id="watchModal" tabindex="-1">
    <div class="modal-dialog modal-sm modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h6 class="modal-title"><i class="bi bi-eye"></i> <span data-t="Watch.Title">Tur Takip</span></h6>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: watchTarget">
                <p class="mb-2 fw-semibold" data-bind="text: name"></p>
                <label class="form-label small" data-t="Watch.HowManyDays">Kac gun takip etmek istiyorsunuz?</label>
                <div class="input-group input-group-sm mb-3">
                    <input type="number" class="form-control" min="1" max="90" data-bind="value: $parent.watchDays" />
                    <span class="input-group-text" data-t="Watch.Days">Gun</span>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal" data-t="Common.Cancel">Iptal</button>
                <button type="button" class="btn btn-info btn-sm" data-bind="click: toggleWatch">
                    <i class="bi bi-eye"></i> <span data-t="Watch.Button">Takip Et</span>
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="~/js/Tours/Index.js" asp-append-version="true"></script>
}
