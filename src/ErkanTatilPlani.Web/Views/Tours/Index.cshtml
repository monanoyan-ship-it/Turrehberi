@{
    ViewData["Title"] = "Turlar";
}

<div id="toursApp">
<div class="d-flex justify-content-between align-items-center mb-4">
    <h1><i class="bi bi-geo-alt"></i> Turlar</h1>
    <button class="btn btn-primary" data-bind="click: openCreateModal">
        <i class="bi bi-plus-circle"></i> Yeni Tur
    </button>
</div>

<!-- Loading -->
<div data-bind="visible: isLoading" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Yukleniyor...</span>
    </div>
</div>

<!-- Liste -->
<div class="row g-4" data-bind="visible: !isLoading(), foreach: tours">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center position-relative" style="height: 180px;">
                <!-- ko if: imageUrl -->
                <img data-bind="attr: { src: imageUrl }" class="w-100 h-100" style="object-fit: cover;" />
                <!-- /ko -->
                <!-- ko ifnot: imageUrl -->
                <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                <!-- /ko -->
                <!-- ko if: isFeatured -->
                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2"><i class="bi bi-star-fill"></i> One Cikan</span>
                <!-- /ko -->
            </div>
            <div class="card-body">
                <h5 class="card-title" data-bind="text: name"></h5>
                <p class="card-text mb-1" data-bind="visible: company">
                    <small class="text-muted"><i class="bi bi-building"></i> <span data-bind="text: company ? company.name : ''"></span></small>
                </p>
                <p class="card-text text-muted">
                    <i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span>
                </p>
                <p class="card-text" data-bind="text: description"></p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="badge bg-primary fs-6" data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span>
                    <span class="text-muted"><i class="bi bi-calendar"></i> <span data-bind="text: durationDays"></span> gun</span>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <div class="btn-group w-100">
                    <button class="btn btn-outline-info" data-bind="click: $parent.showDetails">
                        <i class="bi bi-eye"></i> Detay
                    </button>
                    <button class="btn btn-outline-warning" data-bind="click: $parent.openEditModal">
                        <i class="bi bi-pencil"></i> Duzenle
                    </button>
                    <button class="btn btn-outline-danger" data-bind="click: $parent.openDeleteModal">
                        <i class="bi bi-trash"></i> Sil
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bos Liste -->
<div data-bind="visible: !isLoading() && tours().length === 0" class="alert alert-info text-center">
    <i class="bi bi-info-circle"></i> Henuz tur bulunmamaktadir.
    <a href="#" data-bind="click: openCreateModal" class="alert-link">Ilk turu ekleyin</a>
</div>

<!-- Create/Edit Modal -->
<div class="modal fade" id="formModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" data-bind="text: isEditing() ? 'Tur Duzenle' : 'Yeni Tur'"></h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form id="tourForm">
                    <input type="hidden" data-bind="value: formData().id" />

                    <div class="mb-3">
                        <label class="form-label">Firma *</label>
                        <select class="form-select" data-bind="options: companies, optionsText: 'name', optionsValue: 'id', value: formData().companyId, optionsCaption: '-- Firma Secin --'" required></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Tur Adi *</label>
                        <input type="text" class="form-control" data-bind="value: formData().name" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Destinasyon *</label>
                        <input type="text" class="form-control" data-bind="value: formData().destination" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Aciklama</label>
                        <textarea class="form-control" rows="2" data-bind="value: formData().description"></textarea>
                    </div>

                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Fiyat (TL) *</label>
                            <input type="number" step="0.01" class="form-control" data-bind="value: formData().price" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Sure (Gun) *</label>
                            <input type="number" class="form-control" data-bind="value: formData().durationDays" required />
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label">Kapasite</label>
                            <input type="number" class="form-control" data-bind="value: formData().maxCapacity" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Resim URL</label>
                        <input type="url" class="form-control" data-bind="value: formData().imageUrl" />
                    </div>

                    <div class="form-check form-switch mb-3">
                        <input class="form-check-input" type="checkbox" id="isFeatured" data-bind="checked: formData().isFeatured" />
                        <label class="form-check-label" for="isFeatured">
                            <i class="bi bi-star-fill text-warning"></i> Ana Sayfada Goster (One Cikan)
                        </label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-primary" data-bind="click: saveTour, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    <span data-bind="text: isEditing() ? 'Guncelle' : 'Kaydet'"></span>
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tur Detayi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: selectedTour">
                <div class="row">
                    <div class="col-md-6">
                        <h4 data-bind="text: name"></h4>
                        <p class="text-muted"><i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span></p>
                        <p data-bind="visible: company" class="alert alert-light">
                            <i class="bi bi-building"></i> <strong>Firma:</strong> <span data-bind="text: company ? company.name : ''"></span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Fiyat</dt>
                            <dd class="col-sm-7"><span class="badge bg-success fs-6" data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span></dd>

                            <dt class="col-sm-5">Sure</dt>
                            <dd class="col-sm-7"><span data-bind="text: durationDays"></span> gun</dd>

                            <dt class="col-sm-5">Kapasite</dt>
                            <dd class="col-sm-7"><span data-bind="text: maxCapacity || '-'"></span> kisi</dd>

                            <dt class="col-sm-5">Aciklama</dt>
                            <dd class="col-sm-7" data-bind="text: description || '-'"></dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger">Tur Sil</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="alert alert-warning">
                    <i class="bi bi-exclamation-triangle"></i>
                    <strong>Dikkat!</strong> Bu turu silmek istediginizden emin misiniz?
                </div>
                <p data-bind="with: selectedTour">
                    <strong data-bind="text: name"></strong> turunu silmek uzeresiniz.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-danger" data-bind="click: deleteTour, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    Evet, Sil
                </button>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script>
function ToursViewModel() {
    var self = this;

    self.tours = ko.observableArray([]);
    self.companies = ko.observableArray([]);
    self.isLoading = ko.observable(true);
    self.isSaving = ko.observable(false);
    self.isEditing = ko.observable(false);
    self.selectedTour = ko.observable(null);

    self.formData = ko.observable({
        id: 0,
        companyId: null,
        name: '',
        destination: '',
        description: '',
        price: 0,
        durationDays: 1,
        maxCapacity: 0,
        imageUrl: '',
        isFeatured: false
    });

    var formModal, detailsModal, deleteModal;

    self.loadData = function() {
        self.isLoading(true);
        $.when(
            $.ajax({ url: apiBaseUrl + '/api/tours', method: 'GET' }),
            $.ajax({ url: apiBaseUrl + '/api/companies', method: 'GET' })
        ).done(function(toursRes, companiesRes) {
            self.tours(toursRes[0]);
            self.companies(companiesRes[0]);
            self.isLoading(false);
        }).fail(function() {
            toastr.error('Veriler yuklenirken hata olustu');
            self.isLoading(false);
        });
    };

    self.openCreateModal = function() {
        self.isEditing(false);
        self.formData({
            id: 0,
            companyId: null,
            name: '',
            destination: '',
            description: '',
            price: 0,
            durationDays: 1,
            maxCapacity: 0,
            imageUrl: '',
            isFeatured: false
        });
        formModal.show();
    };

    self.openEditModal = function(tour) {
        self.isEditing(true);
        self.formData({
            id: tour.id,
            companyId: tour.companyId,
            name: tour.name,
            destination: tour.destination,
            description: tour.description,
            price: tour.price,
            durationDays: tour.durationDays,
            maxCapacity: tour.maxCapacity,
            imageUrl: tour.imageUrl,
            isFeatured: tour.isFeatured,
            createdAt: tour.createdAt,
            isActive: tour.isActive
        });
        formModal.show();
    };

    self.showDetails = function(tour) {
        self.selectedTour(tour);
        detailsModal.show();
    };

    self.openDeleteModal = function(tour) {
        self.selectedTour(tour);
        deleteModal.show();
    };

    self.saveTour = function() {
        var form = document.getElementById('tourForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        self.isSaving(true);
        var data = self.formData();
        var isEdit = self.isEditing();

        $.ajax({
            url: apiBaseUrl + '/api/tours' + (isEdit ? '/' + data.id : ''),
            method: isEdit ? 'PUT' : 'POST',
            contentType: 'application/json',
            data: JSON.stringify(data),
            success: function() {
                formModal.hide();
                self.loadData();
                toastr.success(isEdit ? 'Tur guncellendi' : 'Tur eklendi');
                self.isSaving(false);
            },
            error: function() {
                toastr.error('Islem sirasinda hata olustu');
                self.isSaving(false);
            }
        });
    };

    self.deleteTour = function() {
        self.isSaving(true);
        var tour = self.selectedTour();

        $.ajax({
            url: apiBaseUrl + '/api/tours/' + tour.id,
            method: 'DELETE',
            success: function() {
                deleteModal.hide();
                self.loadData();
                toastr.success('Tur silindi');
                self.isSaving(false);
            },
            error: function() {
                toastr.error('Silme sirasinda hata olustu');
                self.isSaving(false);
            }
        });
    };

    $(document).ready(function() {
        formModal = new bootstrap.Modal(document.getElementById('formModal'));
        detailsModal = new bootstrap.Modal(document.getElementById('detailsModal'));
        deleteModal = new bootstrap.Modal(document.getElementById('deleteModal'));
        self.loadData();
    });
}

ko.applyBindings(new ToursViewModel(), document.getElementById('toursApp'));
</script>
}
