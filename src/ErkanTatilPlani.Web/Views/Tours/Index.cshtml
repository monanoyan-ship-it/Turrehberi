@{
    ViewData["Title"] = "Turlar";
}

<div id="toursApp">
<div class="mb-4">
    <h1><i class="bi bi-geo-alt"></i> Turlar</h1>
    <p class="text-muted">Sizin icin en uygun turu secin ve hayalinizdeki tatile baslayın!</p>
</div>

<!-- Loading -->
<div data-bind="visible: isLoading" class="text-center py-5">
    <div class="spinner-border text-primary" role="status">
        <span class="visually-hidden">Yukleniyor...</span>
    </div>
</div>

<!-- Liste -->
<div class="row g-4" data-bind="visible: !isLoading(), foreach: tours">
    <div class="col-md-4">
        <div class="card h-100 shadow-sm">
            <div class="card-img-top bg-secondary d-flex align-items-center justify-content-center position-relative" style="height: 180px;">
                <!-- ko if: imageUrl -->
                <img data-bind="attr: { src: imageUrl }" class="w-100 h-100" style="object-fit: cover;" />
                <!-- /ko -->
                <!-- ko ifnot: imageUrl -->
                <i class="bi bi-image text-white" style="font-size: 3rem;"></i>
                <!-- /ko -->
                <!-- ko if: isFeatured -->
                <span class="badge bg-warning text-dark position-absolute top-0 end-0 m-2"><i class="bi bi-star-fill"></i> One Cikan</span>
                <!-- /ko -->
            </div>
            <div class="card-body">
                <h5 class="card-title" data-bind="text: name"></h5>
                <p class="card-text mb-1" data-bind="visible: company">
                    <small class="text-muted"><i class="bi bi-building"></i> <span data-bind="text: company ? company.name : ''"></span></small>
                </p>
                <p class="card-text text-muted">
                    <i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span>
                </p>
                <p class="card-text" data-bind="text: description"></p>
                <div class="d-flex justify-content-between align-items-center">
                    <span class="badge bg-primary fs-6" data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span>
                    <span class="text-muted"><i class="bi bi-calendar"></i> <span data-bind="text: durationDays"></span> gun</span>
                </div>
            </div>
            <div class="card-footer bg-transparent">
                <div class="d-flex gap-2">
                    <button class="btn btn-outline-primary flex-grow-1" data-bind="click: $parent.showDetails">
                        <i class="bi bi-info-circle"></i> Detay
                    </button>
                    <button class="btn btn-success flex-grow-1" data-bind="click: $parent.openReservationModal">
                        <i class="bi bi-calendar-check"></i> Rezervasyon Yap
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bos Liste -->
<div data-bind="visible: !isLoading() && tours().length === 0" class="alert alert-info text-center">
    <i class="bi bi-info-circle"></i> Henuz tur bulunmamaktadir. Yakinda yeni turlar eklenecektir!
</div>

<!-- Details Modal -->
<div class="modal fade" id="detailsModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Tur Detayi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" data-bind="with: selectedTour">
                <div class="row">
                    <div class="col-md-6">
                        <h4 data-bind="text: name"></h4>
                        <p class="text-muted"><i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span></p>
                        <p data-bind="visible: company" class="alert alert-light">
                            <i class="bi bi-building"></i> <strong>Firma:</strong> <span data-bind="text: company ? company.name : ''"></span>
                        </p>
                    </div>
                    <div class="col-md-6">
                        <dl class="row">
                            <dt class="col-sm-5">Fiyat</dt>
                            <dd class="col-sm-7"><span class="badge bg-success fs-6" data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></span></dd>

                            <dt class="col-sm-5">Sure</dt>
                            <dd class="col-sm-7"><span data-bind="text: durationDays"></span> gun</dd>

                            <dt class="col-sm-5">Kapasite</dt>
                            <dd class="col-sm-7"><span data-bind="text: maxCapacity || '-'"></span> kisi</dd>

                            <dt class="col-sm-5">Aciklama</dt>
                            <dd class="col-sm-7" data-bind="text: description || '-'"></dd>
                        </dl>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Kapat</button>
            </div>
        </div>
    </div>
</div>

<!-- Reservation Modal -->
<div class="modal fade" id="reservationModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-calendar-check"></i> Rezervasyon Yap</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div data-bind="with: selectedTour" class="mb-3">
                    <div class="alert alert-light">
                        <h5 data-bind="text: name"></h5>
                        <p class="mb-1"><i class="bi bi-geo-alt"></i> <span data-bind="text: destination"></span></p>
                        <p class="mb-0"><strong data-bind="text: price.toLocaleString('tr-TR', {style: 'currency', currency: 'TRY'})"></strong> / kisi</p>
                    </div>
                </div>
                <form id="reservationForm">
                    <div class="mb-3">
                        <label class="form-label">Adiniz Soyadiniz *</label>
                        <input type="text" class="form-control" data-bind="value: reservationData().fullName" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">E-posta *</label>
                        <input type="email" class="form-control" data-bind="value: reservationData().email" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Telefon *</label>
                        <input type="tel" class="form-control" data-bind="value: reservationData().phone" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Kisi Sayisi *</label>
                        <input type="number" class="form-control" min="1" data-bind="value: reservationData().numberOfPeople" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Not (Opsiyonel)</label>
                        <textarea class="form-control" rows="2" data-bind="value: reservationData().notes"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Iptal</button>
                <button type="button" class="btn btn-success" data-bind="click: submitReservation, disable: isSaving">
                    <span data-bind="visible: isSaving" class="spinner-border spinner-border-sm me-1"></span>
                    Rezervasyon Yap
                </button>
            </div>
        </div>
    </div>
</div>
</div>

@section Scripts {
<script>
function ToursViewModel() {
    var self = this;

    self.tours = ko.observableArray([]);
    self.isLoading = ko.observable(true);
    self.isSaving = ko.observable(false);
    self.selectedTour = ko.observable(null);

    self.reservationData = ko.observable({
        fullName: '',
        email: '',
        phone: '',
        numberOfPeople: 1,
        notes: ''
    });

    var detailsModal, reservationModal;

    self.loadData = function() {
        self.isLoading(true);
        $.ajax({
            url: apiBaseUrl + '/api/tours',
            method: 'GET',
            success: function(data) {
                self.tours(data);
                self.isLoading(false);
            },
            error: function() {
                toastr.error('Turlar yuklenirken hata olustu');
                self.isLoading(false);
            }
        });
    };

    self.showDetails = function(tour) {
        self.selectedTour(tour);
        detailsModal.show();
    };

    self.openReservationModal = function(tour) {
        self.selectedTour(tour);
        self.reservationData({
            fullName: '',
            email: '',
            phone: '',
            numberOfPeople: 1,
            notes: ''
        });
        reservationModal.show();
    };

    self.submitReservation = function() {
        var form = document.getElementById('reservationForm');
        if (!form.checkValidity()) {
            form.reportValidity();
            return;
        }

        self.isSaving(true);
        var tour = self.selectedTour();
        var data = self.reservationData();

        // Simdi sadece bilgilendirme yapiyoruz - gercek rezervasyon icin visitor/login gerekli
        setTimeout(function() {
            reservationModal.hide();
            toastr.success('Rezervasyon talebiniz alindi! En kisa surede sizinle iletisime gececegiz.');
            self.isSaving(false);
        }, 500);
    };

    $(document).ready(function() {
        detailsModal = new bootstrap.Modal(document.getElementById('detailsModal'));
        reservationModal = new bootstrap.Modal(document.getElementById('reservationModal'));
        self.loadData();
    });
}

ko.applyBindings(new ToursViewModel(), document.getElementById('toursApp'));
</script>
}
