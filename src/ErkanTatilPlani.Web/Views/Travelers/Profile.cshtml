@{
    ViewData["Title"] = "Gezgin Profili";
}

<div class="container py-4" id="travelerProfileApp">
    <!-- Loading State -->
    <div data-bind="visible: isLoading" class="text-center py-5">
        <div class="spinner-border text-primary" role="status">
            <span class="visually-hidden">Yukleniyor...</span>
        </div>
    </div>

    <!-- Private Profile -->
    <div data-bind="visible: !isLoading() && isPrivate()" class="text-center py-5">
        <i class="bi bi-lock text-muted" style="font-size: 4rem;"></i>
        <h4 class="mt-3" data-t="TravelerProfile.PrivateProfile">Bu profil gizli</h4>
    </div>

    <!-- Profile Content -->
    <div data-bind="visible: !isLoading() && !isPrivate() && !notFound()">
        <!-- Header -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-4">
                <div class="row align-items-center">
                    <div class="col-auto">
                        <img data-bind="attr: { src: avatarUrl() || '/images/placeholders/avatar-placeholder.svg' }"
                             class="rounded-circle border border-3 border-primary"
                             style="width: 100px; height: 100px; object-fit: cover;" />
                    </div>
                    <div class="col">
                        <h3 data-bind="text: fullName()"></h3>
                        <span class="badge me-1" data-bind="css: tierCssClass()">
                            <i data-bind="attr: { class: 'bi ' + tierIcon() + ' me-1' }"></i>
                            <span data-bind="text: T(tierNameKey())"></span>
                        </span>
                        <p class="text-muted mt-2 mb-0" data-bind="text: bio(), visible: bio()"></p>
                    </div>
                    <div class="col-auto" data-bind="visible: canFollow()">
                        <button class="btn" data-bind="click: toggleFollow, css: isFollowing() ? 'btn-outline-secondary' : 'btn-primary', disable: isFollowLoading">
                            <span class="spinner-border spinner-border-sm me-1" data-bind="visible: isFollowLoading"></span>
                            <!-- ko if: isFollowing() -->
                            <i class="bi bi-person-check me-1" data-bind="visible: !isFollowLoading()"></i>
                            <span data-t="TravelerProfile.Unfollow">Takibi Birak</span>
                            <!-- /ko -->
                            <!-- ko ifnot: isFollowing() -->
                            <i class="bi bi-person-plus me-1" data-bind="visible: !isFollowLoading()"></i>
                            <span data-t="TravelerProfile.Follow">Takip Et</span>
                            <!-- /ko -->
                        </button>
                    </div>
                </div>

                <!-- Stats -->
                <div class="row text-center mt-4 pt-3 border-top">
                    <div class="col">
                        <h5 data-bind="text: completedTours()"></h5>
                        <small class="text-muted" data-t="Loyalty.CompletedTours">Tamamlanan Turlar</small>
                    </div>
                    <div class="col">
                        <h5 data-bind="text: reviewCount()"></h5>
                        <small class="text-muted" data-t="Review.Reviews">Yorumlar</small>
                    </div>
                    <div class="col">
                        <h5 data-bind="text: tripStoryCount()"></h5>
                        <small class="text-muted" data-t="TripStory.Stories">Hikayeler</small>
                    </div>
                    <div class="col">
                        <h5 data-bind="text: followerCount()"></h5>
                        <small class="text-muted" data-t="TravelerProfile.Followers">Takipci</small>
                    </div>
                    <div class="col">
                        <h5 data-bind="text: followingCount()"></h5>
                        <small class="text-muted" data-t="TravelerProfile.Following">Takip</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Stories -->
        <h5 class="mb-3">
            <i class="bi bi-journal-text me-2"></i>
            <span data-t="TripStory.RecentStories">Son Hikayeleri</span>
        </h5>

        <div data-bind="foreach: recentStories">
            <div class="card shadow-sm border-0 mb-3">
                <div class="card-body">
                    <h5>
                        <a data-bind="attr: { href: '/Travelers/Story/' + id }, text: title" class="text-decoration-none text-dark"></a>
                    </h5>
                    <p data-bind="text: contentPreview" class="text-muted"></p>
                    <!-- ko if: photoUrl -->
                    <img data-bind="attr: { src: photoUrl }" class="img-fluid rounded mb-2" style="max-height: 200px; object-fit: cover;" />
                    <!-- /ko -->
                    <div class="d-flex align-items-center gap-3 mt-2">
                        <!-- ko if: destination -->
                        <small class="text-muted"><i class="bi bi-pin-map me-1"></i><span data-bind="text: destination"></span></small>
                        <!-- /ko -->
                        <!-- ko if: rating -->
                        <small class="text-warning"><i class="bi bi-star-fill me-1"></i><span data-bind="text: rating"></span>/5</small>
                        <!-- /ko -->
                        <small class="text-muted"><i class="bi bi-heart me-1"></i><span data-bind="text: likeCount"></span></small>
                        <small class="text-muted"><i class="bi bi-chat me-1"></i><span data-bind="text: commentCount"></span></small>
                        <small class="text-muted" data-bind="text: new Date(createdAt).toLocaleDateString()"></small>
                    </div>
                </div>
            </div>
        </div>

        <div data-bind="visible: recentStories().length === 0" class="text-center py-4">
            <p class="text-muted" data-t="TripStory.NoStories">Henuz hikaye paylasılmamis</p>
        </div>
    </div>

    <!-- Not Found -->
    <div data-bind="visible: !isLoading() && notFound()" class="text-center py-5">
        <i class="bi bi-person-x text-muted" style="font-size: 4rem;"></i>
        <h4 class="mt-3" data-t="Error.VisitorNotFound">Kullanici bulunamadi</h4>
    </div>
</div>

@section Scripts {
    <script>var travelerId = @(ViewBag.TravelerId ?? 0);</script>
    <script src="~/js/Travelers/Profile.js" asp-append-version="true"></script>
}
